attributes":{"y":{"type":"field","field":"active"},"line_color":"#76c6ff","line_alpha":0.25,"line_width":2,"mode":"after"}},"y_range_name":"instances"}},{"type":"object","name":"GlyphRenderer","id":"p3006","attributes":{"data_source":{"id":"p3000"},"view":{"type":"object","name":"CDSView","id":"p3007","attributes":{"filter":{"type":"object","name":"AllIndices","id":"p3008"}}},"glyph":{"type":"object","name":"Scatter","id":"p3003","attributes":{"size":{"type":"field","field":"size"},"line_color":{"type":"value","value":"#ffffff"},"line_width":{"type":"value","value":1.5},"fill_color":{"type":"field","field":"fill"}}},"nonselection_glyph":{"type":"object","name":"Scatter","id":"p3004","attributes":{"size":{"type":"field","field":"size"},"line_color":{"type":"value","value":"#ffffff"},"line_alpha":{"type":"value","value":0.1},"line_width":{"type":"value","value":1.5},"fill_color":{"type":"field","field":"fill"},"fill_alpha":{"type":"value","value":0.1},"hatch_alpha":{"type":"value","value":0.1}}},"muted_glyph":{"type":"object","name":"Scatter","id":"p3005","attributes":{"size":{"type":"field","field":"size"},"line_color":{"type":"value","value":"#ffffff"},"line_alpha":{"type":"value","value":0.2},"line_width":{"type":"value","value":1.5},"fill_color":{"type":"field","field":"fill"},"fill_alpha":{"type":"value","value":0.2},"hatch_alpha":{"type":"value","value":0.2}}}}}],"toolbar":{"type":"object","name":"Toolbar","id":"p1020","attributes":{"tools":[{"type":"object","name":"PanTool","id":"p1033"},{"type":"object","name":"WheelZoomTool","id":"p1034","attributes":{"renderers":"auto"}},{"type":"object","name":"BoxZoomTool","id":"p1035","attributes":{"dimensions":"both","overlay":{"type":"object","name":"BoxAnnotation","id":"p1036","attributes":{"syncable":false,"line_color":"black","line_alpha":1,"line_width":2,"line_dash":[4,4],"fill_color":"lightgrey","fill_alpha":0.5,"level":"overlay","visible":false,"left":{"type":"number","value":"nan"},"right":{"type":"number","value":"nan"},"top":{"type":"number","value":"nan"},"bottom":{"type":"number","value":"nan"},"left_units":"canvas","right_units":"canvas","top_units":"canvas","bottom_units":"canvas","handles":{"type":"object","name":"BoxInteractionHandles","id":"p1042","attributes":{"all":{"type":"object","name":"AreaVisuals","id":"p1041","attributes":{"fill_color":"white","hover_fill_color":"lightgray"}}}}}}}},{"type":"object","name":"ResetTool","id":"p1043"},{"type":"object","name":"SaveTool","id":"p1044"},{"type":"object","name":"HoverTool","id":"p1059","attributes":{"renderers":[{"id":"p1050"}],"callback":{"type":"object","name":"CustomJS","id":"p2002","attributes":{"args":{"type":"map","entries":[["vertical",{"type":"object","name":"Span","id":"p2000","attributes":{"visible":false,"location":0,"dimension":"height","line_color":"#ffad20","line_alpha":0.65,"line_width":1.2,"line_dash":[6]}}],["horizontal",{"type":"object","name":"Span","id":"p2001","attributes":{"visible":false,"location":0,"line_color":"#ffad20","line_alpha":0.45,"line_width":1.2,"line_dash":[6]}}],["source",{"id":"p1006"}],["trend",{"id":"p3010"}],["plot",{"id":"p1011"}]]},"code":"\nconst cursor = Math.round(cb_data.geometry.x);\nconst xs = source.data.x;\nconst total = source.data.total;\nif (!Number.isFinite(cursor) || cursor < xs[0] || cursor > xs[xs.length - 1]) {\n    vertical.visible = false;\n    horizontal.visible = false;\n    return;\n}\nlet low = 0;\nlet high = xs.length;\nwhile (low < high) {\n    const middle = (low + high) >>> 1;\n    if (xs[middle] <= cursor) low = middle + 1;\n    else high = middle;\n}\nconst solidY = total[Math.max(0, low - 1)] ?? 0;\nlet guideY = solidY;\nconst firstObserved = xs.length > 2 ? xs[1] : xs[0];\nconst lastObserved = xs.length > 2 ? xs[xs.length - 2] : xs[xs.length - 1];\nif (trend.visible && (cursor < firstObserved || cursor > lastObserved)) {\n    const projected = trend.gradient * cursor + trend.y_intercept;\n    const lower = Math.min(plot.y_range.start, plot.y_range.end);\n    const upper = Math.max(plot.y_range.start, plot.y_range.end);\n    if (Number.isFinite(projected) && projected >= lower && projected <= upper) {\n        guideY = projected;\n    }\n}\nvertical.location = cursor;\nhorizontal.location = guideY;\nvertical.visible = true;\nhorizontal.visible = true;\n"}},"tooltips":[["Eastern time","$x{custom}"],["Rows done","@total{custom}"],["Completed claims","@completed{custom}"],["Errored claims","@errored{custom}"]],"formatters":{"type":"map","entries":[["$x",{"type":"object","name":"CustomJSHover","id":"p2003","attributes":{"code":"const minute = Math.round(special_vars.x);\nreturn new Intl.DateTimeFormat(\"en-US\", {\n    timeZone: \"America/New_York\", month: \"short\", day: \"numeric\",\n    hour: \"numeric\", minute: \"2-digit\", hour12: true, timeZoneName: \"short\"\n}).format(new Date(minute * 60000));"}}],["@total",{"type":"object","name":"CustomJSHover","id":"p2004","attributes":{"args":{"type":"map","entries":[["source",{"id":"p1006"}],["field","total"]]},"code":"const cursor = Math.round(special_vars.x);\nconst xs = source.data.x;\nconst values = source.data[field];\nlet low = 0;\nlet high = xs.length;\nwhile (low < high) {\n    const middle = (low + high) >>> 1;\n    if (xs[middle] <= cursor) low = middle + 1;\n    else high = middle;\n}\nreturn new Intl.NumberFormat(\"en-US\", {notation: \"standard\", useGrouping: true, maximumFractionDigits: 2}).format(values[Math.max(0, low - 1)] ?? 0);"}}],["@completed",{"type":"object","name":"CustomJSHover","id":"p2005","attributes":{"args":{"type":"map","entries":[["source",{"id":"p1006"}],["field","completed"]]},"code":"const cursor = Math.round(special_vars.x);\nconst xs = source.data.x;\nconst values = source.data[field];\nlet low = 0;\nlet high = xs.length;\nwhile (low < high) {\n    const middle = (low + high) >>> 1;\n    if (xs[middle] <= cursor) low = middle + 1;\n    else high = middle;\n}\nreturn new Intl.NumberFormat(\"en-US\", {notation: \"standard\", useGrouping: true, maximumFractionDigits: 2}).format(values[Math.max(0, low - 1)] ?? 0);"}}],["@errored",{"type":"object","name":"CustomJSHover","id":"p2006","attributes":{"args":{"type":"map","entries":[["source",{"id":"p1006"}],["field","errored"]]},"code":"const cursor = Math.round(special_vars.x);\nconst xs = source.data.x;\nconst values = source.data[field];\nlet low = 0;\nlet high = xs.length;\nwhile (low < high) {\n    const middle = (low + high) >>> 1;\n    if (xs[middle] <= cursor) low = middle + 1;\n    else high = middle;\n}\nreturn new Intl.NumberFormat(\"en-US\", {notation: \"standard\", useGrouping: true, maximumFractionDigits: 2}).format(values[Math.max(0, low - 1)] ?? 0);"}}]]},"sort_by":null,"mode":"vline"}}],"active_drag":{"id":"p1033"}}},"toolbar_location":"above","left":[{"type":"object","name":"LinearAxis","id":"p1028","attributes":{"ticker":{"type":"object","name":"BasicTicker","id":"p1029","attributes":{"mantissas":[1,2,5]}},"formatter":{"type":"object","name":"CustomJSTickFormatter","id":"p3021","attributes":{"code":"\nreturn new Intl.NumberFormat(\"en-US\", {\n    notation: \"standard\", useGrouping: true, maximumFractionDigits: 2\n}).format(tick);\n"}},"axis_label":"Finished runs","major_label_policy":{"type":"object","name":"AllLabels","id":"p1031"},"minor_tick_line_color":null}}],"below":[{"type":"object","name":"LinearAxis","id":"p1023","attributes":{"ticker":{"type":"object","name":"CustomJSTicker","id":"p1045","attributes":{"args":{"type":"map","entries":[["width",800]]},"major_code":"const start = Math.min(cb_data.start, cb_data.end);\nconst end = Math.max(cb_data.start, cb_data.end);\nconst span = end - start;\nconst target = Math.max(2, width / 40);\nconst intervals = [1, 2, 5, 10, 15, 30, 60, 120, 180, 360, 720, 1440, 2880, 10080, 43200, 129600, 525600];\nlet step = intervals[0];\nlet error = Infinity;\nfor (const candidate of intervals) {\n    const difference = Math.abs(span / candidate - target);\n    if (difference < error) {\n        step = candidate;\n        error = difference;\n    }\n}\nif (step < 1440) {\n    const first = Math.ceil(start / step) * step;\n    const ticks = [];\n    for (let minute = first; minute <= end && ticks.length < 1000; minute += step) ticks.push(minute);\n    return ticks;\n}\nconst zone = \"America/New_York\";\nconst calendar = new Intl.DateTimeFormat(\"en-US\", {\n    timeZone: zone, year: \"numeric\", month: \"2-digit\", day: \"2-digit\"\n});\nconst localClock = new Intl.DateTimeFormat(\"en-US\", {\n    timeZone: zone, year: \"numeric\", month: \"2-digit\", day: \"2-digit\",\n    hour: \"2-digit\", minute: \"2-digit\", hourCycle: \"h23\"\n});\nconst fields = (formatter, date) => Object.fromEntries(\n    formatter.formatToParts(date).map(part => [part.type, part.value])\n);\nconst firstDate = fields(calendar, new Date(start * 60000));\nconst firstDay = Date.UTC(Number(firstDate.year), Number(firstDate.month) - 1, Number(firstDate.day)) / 86400000;\nconst daysPerTick = step / 1440;\nconst ticks = [];\nfor (let day = Math.floor(firstDay / daysPerTick) * daysPerTick; ticks.length < 1000; day += daysPerTick) {\n    const utcMidnight = day * 86400000;\n    const probe = utcMidnight + 5 * 3600000;\n    const local = fields(localClock, new Date(probe));\n    const localAsUtc = Date.UTC(Number(local.year), Number(local.month) - 1,\n        Number(local.day), Number(local.hour), Number(local.minute));\n    const minute = (utcMidnight - (localAsUtc - probe)) / 60000;\n    if (minute > end) break;\n    if (minute >= start) ticks.push(minute);\n}\nreturn ticks;"}},"formatter":{"type":"object","name":"CustomJSTickFormatter","id":"p1046","attributes":{"code":"\nconst zone = \"America/New_York\";\nconst sorted = [...ticks].filter(Number.isFinite).sort((a, b) => a - b);\nconst clock = new Intl.DateTimeFormat(\"en-US\", {\n    timeZone: zone, year: \"numeric\", month: \"2-digit\", day: \"2-digit\",\n    hour: \"2-digit\", minute: \"2-digit\", hourCycle: \"h23\"\n});\nconst monthFormat = new Intl.DateTimeFormat(\"en-US\", {timeZone: zone, month: \"short\"});\nconst dayFormat = new Intl.DateTimeFormat(\"en-US\", {\n    timeZone: zone, month: \"short\", day: \"numeric\"\n});\nfunction localFields(ms) {\n    const fields = Object.fromEntries(clock.formatToParts(new Date(ms)).map(part => [part.type, part.value]));\n    return {\n        year: Number(fields.year), month: Number(fields.month), day: Number(fields.day),\n        hour: Number(fields.hour), minute: Number(fields.minute)\n    };\n}\nfunction easternMidnight(year, month, day) {\n    const target = Date.UTC(year, month - 1, day);\n    let guess = target + 5 * 3600000;\n    for (let i = 0; i < 3; i++) {\n        const seen = localFields(guess);\n        const represented = Date.UTC(seen.year, seen.month - 1, seen.day, seen.hour, seen.minute);\n        guess += target - represented;\n    }\n    return guess / 60000;\n}\nfunction closestTick(boundary) {\n    let best = sorted[0];\n    let distance = Math.abs(best - boundary);\n    for (const candidate of sorted) {\n        const nextDistance = Math.abs(candidate - boundary);\n        if (nextDistance < distance || (nextDistance === distance && candidate > best)) {\n            best = candidate;\n            distance = nextDistance;\n        }\n    }\n    return best;\n}\nconst intervals = sorted.slice(1).map((value, index) => value - sorted[index])\n    .filter(value => value > 0).sort((a, b) => a - b);\nconst gap = intervals.length ? intervals[Math.floor(intervals.length / 2)] : 60;\nconst low = sorted[0] - gap / 2;\nconst high = sorted.at(-1) + gap / 2;\nfunction ownedBoundary(boundaries) {\n    let best = null;\n    let distance = Infinity;\n    for (const boundary of boundaries) {\n        if (boundary < low || boundary > high) continue;\n        if (Math.abs(closestTick(boundary) - tick) > 0.000001) continue;\n        const currentDistance = Math.abs(boundary - tick);\n        if (currentDistance < distance) {\n            best = boundary;\n            distance = currentDistance;\n        }\n    }\n    return best;\n}\nconst local = localFields(Math.round(tick) * 60000);\nconst hour12 = hour => (hour % 12 || 12) + (hour < 12 ? \"AM\" : \"PM\");\n\n// A higher calendar unit replaces the ordinary label at its nearest visible tick.\nif (gap < 350 * 1440) {\n    const yearStart = easternMidnight(local.year, 1, 1);\n    const nextYear = easternMidnight(local.year + 1, 1, 1);\n    const boundary = ownedBoundary([yearStart, nextYear]);\n    if (boundary !== null) return String(localFields(boundary * 60000).year);\n}\nif (gap < 28 * 1440) {\n    const nextMonth = new Date(Date.UTC(local.year, local.month, 1));\n    const boundary = ownedBoundary([\n        easternMidnight(local.year, local.month, 1),\n        easternMidnight(nextMonth.getUTCFullYear(), nextMonth.getUTCMonth() + 1, 1)\n    ]);\n    if (boundary !== null) return monthFormat.format(new Date(boundary * 60000));\n}\nif (gap < 900) {\n    const nextDay = new Date(Date.UTC(local.year, local.month - 1, local.day + 1));\n    const boundary = ownedBoundary([\n        easternMidnight(local.year, local.month, local.day),\n        easternMidnight(nextDay.getUTCFullYear(), nextDay.getUTCMonth() + 1, nextDay.getUTCDate())\n    ]);\n    if (boundary !== null) return dayFormat.format(new Date(boundary * 60000));\n}\nif (gap < 45) {\n    const hourStart = Math.floor(tick / 60) * 60;\n    const boundary = ownedBoundary([hourStart, hourStart + 60]);\n    if (boundary !== null) return hour12(localFields(boundary * 60000).hour);\n    return (local.hour % 12 || 12) + \":\" + String(local.minute).padStart(2, \"0\");\n}\nif (gap < 900) return hour12(local.hour);\nif (gap < 28 * 1440) return String(local.day);\nif (gap < 350 * 1440) return monthFormat.format(new Date(tick * 60000));\nreturn String(local.year);\n"}},"axis_label":"Eastern time","major_label_standoff":3,"major_label_orientation":0.5235987755982988,"major_label_policy":{"type":"object","name":"AllLabels","id":"p1026"},"major_label_text_font_size":"8pt"}}],"center":[{"type":"object","name":"Grid","id":"p1027","attributes":{"axis":{"id":"p1023"},"grid_line_alpha":0.2}},{"type":"object","name":"Grid","id":"p1032","attributes":{"dimension":1,"axis":{"id":"p1028"},"grid_line_alpha":0.2}},{"id":"p2000"},{"id":"p2001"},{"id":"p3010"},{"id":"p3011"},{"id":"p4000"},{"id":"p4006"},{"id":"p4012"},{"id":"p4013"},{"id":"p5001"}],"extra_y_ranges":{"type":"map","entries":[["instances",{"type":"object","name":"Range1d","id":"p6001","attributes":{"start":0,"end":10}}]]},"right":[{"type":"object","name":"LinearAxis","id":"p6002","attributes":{"ticker":{"type":"object","name":"BasicTicker","id":"p6003","attributes":{"mantissas":[1,2,5],"min_interval":1}},"formatter":{"type":"object","name":"CustomJSTickFormatter","id":"p6004","attributes":{"code":"return Math.round(tick).toLocaleString();"}},"axis_label":"Running instances","major_label_policy":{"type":"object","name":"AllLabels","id":"p6005"},"minor_tick_line_color":null,"y_range_name":"instances"}}]}}],"defs":[]},"version":"3.9.2"};

		    function clockLabel(minute) {
		        return new Intl.DateTimeFormat("en-US", {
		            timeZone: "America/New_York", month: "short", day: "numeric",
		            hour: "numeric", minute: "2-digit", hour12: true, timeZoneName: "short"
		        }).format(new Date(minute * 60000));
		    }

		    function findSource(node, name = "series") {
		        if (!node || typeof node !== "object") return null;
		        if (node.name === "ColumnDataSource" && node.attributes?.name === name) return node;
		        for (const child of Object.values(node)) {
		            const found = findSource(child, name);
		            if (found) return found;
		        }
		        return null;
		    }

		    function loadBokeh() {
		        if (globalThis.Bokeh?.embed?.embed_item) return Promise.resolve(globalThis.Bokeh);
		        if (!globalThis.sparrowBokehPromise) {
		            globalThis.sparrowBokehPromise = new Promise((resolve, reject) => {
		                const script = document.createElement("script");
		                script.src = "https://cdn.bokeh.org/bokeh/release/bokeh-3.9.2.min.js";
		                script.onload = () => globalThis.Bokeh ? resolve(globalThis.Bokeh) : reject(new Error("Bokeh did not load"));
		                script.onerror = () => reject(new Error("Could not load Bokeh"));
		                document.head.appendChild(script);
		            });
		        }
		        return globalThis.sparrowBokehPromise;
		    }

		    onMount(() => {
		        let active = true;
		        let views;
		        let resizeObserver;
		        const body = plotElement.closest(".gallery-body.single");
		        const preview = body?.closest(".gallery-preview");
		        const previousHeight = body?.style.getPropertyValue("height");
		        const previousPriority = body?.style.getPropertyPriority("height");
		        let previewObserver;
		        let bodyObserver;
		        let themeObserver;
		        let removeCursorHandlers = () => {};
		        function fitPreview() {
		            if (!body || !preview) return;
		            const height = `${Math.max(1, Math.round(preview.clientHeight))}px`;
		            if (body.style.getPropertyValue("height") !== height ||
		                body.style.getPropertyPriority("height") !== "important") {
		                body.style.setProperty("height", height, "important");
		            }
		        }
		        if (preview) {
		            previewObserver = new ResizeObserver(fitPreview);
		            bodyObserver = new MutationObserver(fitPreview);
		            previewObserver.observe(preview);
		            bodyObserver.observe(body, {attributes: true, attributeFilter: ["style"]});
		            fitPreview();
		        }
		        function applySelectionTheme() {
		            const theme = getComputedStyle(document.documentElement);
		            const color = (name, fallback) => theme.getPropertyValue(name).trim() || fallback;
		            const dark = document.documentElement.dataset.theme === "dark";
		            const selectionColor = dark ? "#93c5fd" : "#1d4ed8";
		            const hoverColor = dark ? "#dbeafe" : "#3b82f6";
		            const ink = color("--text", "#ebe5f1");
		            const muted = color("--muted", "#afa6ba");
		            const grid = color("--line", "#544a60");
		            const background = color("--background", "#141218");
		            totalColor = color("--accent", "#ffad20");
		            completedColor = dark ? "#57d68d" : "#167c4b";
		            erroredColor = dark ? "#ff7373" : "#ba3038";
		            const seriesColors = {
		                "p1050c": completedColor, "p1050e": erroredColor,
		                "p1050": totalColor, "p6009": runningColor
		            };
		            for (const view of views ?? []) {
		                if (view.model.id !== template.root_id) continue;
		                const plot = view.model;
		                plot.background_fill_color = background;
		                plot.border_fill_color = background;
		                plot.outline_line_color = grid;
		                plot.title.text_color = ink;
		                for (const axis of [...plot.left, ...plot.below, ...plot.right]) {
		                    axis.axis_label_text_color = ink;
		                    axis.major_label_text_color = muted;
		                    axis.axis_line_color = grid;
		                    axis.major_tick_line_color = grid;
		                    axis.minor_tick_line_color = grid;
		                }
		                for (const guide of plot.center ?? []) {
		                    if (guide.id === "p1027" || guide.id === "p1032") {
		                        guide.grid_line_color = grid;
		                    }
		                    if (["p3010", "p3011", "p4000", "p4006"].includes(guide.id)) {
		                        guide.line_color = selectionColor;
		                        if (guide.id === "p4000" || guide.id === "p4006") {
		                            guide.start.line_color = selectionColor;
		                            guide.end.line_color = selectionColor;
		                        }
		                    }
		                    if (["p4012", "p4013", "p5001"].includes(guide.id)) {
		                        guide.text_color = selectionColor;
		                    }
		                }
		                for (const renderer of plot.renderers) {
		                    const lineColor = seriesColors[renderer.id];
		                    if (lineColor == null) continue;
		                    for (const kind of ["glyph", "nonselection_glyph", "muted_glyph"]) {
		                        renderer[kind].line_color = lineColor;
		                    }
		                }
		                plot.right[0].axis_label_text_color = runningColor;
		                plot.right[0].major_label_text_color = runningColor;
		                const hover = plot.toolbar.tools.find(tool => tool.id === "p1059");
		                for (const name of ["vertical", "horizontal"]) {
		                    if (hover?.callback?.args?.[name]) hover.callback.args[name].line_color = totalColor;
		                }
		                const markers = plot.renderers.find(renderer => renderer.id === "p3006")?.data_source;
		                if (markers?.data?.x?.length) {
		                    const fill = markers.data.x.map((_, i) =>
		                        markers.data.size?.[i] > 11 ? hoverColor : selectionColor
		                    );
		                    markers.data = {...markers.data, fill};
		                }
		            }
		        }
		        (async () => {
		            const Bokeh = await loadBokeh();
		            if (!active) return;
		            const item = structuredClone(template);
		            const root = item.doc.roots[0];
		            const rows = (points ?? []).filter(Boolean).map(p => ({
		                minute: Number(p.minute),
		                total: Number(p.total),
		                completed: Number(p.completed),
		                errored: Number(p.errored)
		            }));
		            const start = Number(startMinute);
		            const end = Math.max(start + 1, Number(nowMinute));
		            const x = [start, ...rows.map(p => p.minute), end];
		            const series = key => [0, ...rows.map(p => p[key]), rows.at(-1)?.[key] ?? 0];
		            const source = findSource(root);
		            const activitySource = findSource(root, "activity");
		            if (!activitySource) throw new Error("Bokeh running data source missing");
		            if (!source) throw new Error("Bokeh data source missing");
		            source.attributes.data.entries = [
		                ["x", x],
		                ["total", series("total")],
		                ["completed", series("completed")],
		                ["errored", series("errored")],
		                ["label", x.map(clockLabel)]
		            ];
		            const activityRows = (activePoints ?? []).filter(Boolean).map(p => ({
		                minute: Number(p.minute), running: Number(p.running)
		            }));
		            const activeX = activityRows.length
		                ? [start, ...activityRows.map(p => p.minute)]
		                : [start, end];
		            activitySource.attributes.data.entries = [
		                ["x", activeX],
		                ["active", activityRows.length ? [0, ...activityRows.map(p => p.running)] : [0, 0]],
		                ["label", activeX.map(clockLabel)]
		            ];

		            const theme = getComputedStyle(document.documentElement);
		            const color = (name, fallback) => theme.getPropertyValue(name).trim() || fallback;
		            const dark = document.documentElement.dataset.theme === "dark";
		            const ink = color("--text", "#ebe5f1");
		            const muted = color("--muted", "#afa6ba");
		            const grid = color("--line", "#544a60");
		            const background = color("--background", "#141218");
		            const font = getComputedStyle(plotElement).fontFamily;
		            totalColor = color("--accent", "#ffad20");
		            completedColor = dark ? "#57d68d" : "#167c4b";
		            erroredColor = dark ? "#ff7373" : "#ba3038";
		            const hover = root.attributes.toolbar.attributes.tools.find(tool => tool.name === "HoverTool");
		            for (const [name, guide] of hover.attributes.callback.attributes.args.entries) {
		                if (name === "vertical" || name === "horizontal") guide.attributes.line_color = totalColor;
		            }

		            root.attributes.title.attributes.text = label + " · rows done, claims, running runs · " + day;
		            root.attributes.title.attributes.text_color = ink;
		            root.attributes.title.attributes.text_font = font;
		            root.attributes.title.attributes.text_font_size = "13pt";
		            root.attributes.x_range.attributes.start = start;
		            root.attributes.x_range.attributes.end = end;
		            root.attributes.y_range.attributes.start = 0;
		            root.attributes.y_range.attributes.end = Math.max(1, Math.ceil(Math.max(rows.at(-1)?.total ?? 0, rows.at(-1)?.completed ?? 0, rows.at(-1)?.errored ?? 0) * 1.1));
		            root.attributes.extra_y_ranges.entries[0][1].attributes.end = scaleEnd(scalePosition);
		            root.attributes.background_fill_color = background;
		            root.attributes.border_fill_color = background;
		            root.attributes.outline_line_color = grid;
		            root.attributes.below[0].attributes.ticker.attributes.args.entries = [
		                ["width", Math.max(1, plotElement.clientWidth - 60)]
		            ];
		            root.attributes.below[0].attributes.axis_label = "Eastern time (ET)";
		            root.attributes.left[0].attributes.axis_label = "Rows / claims";
		            root.attributes.right[0].attributes.axis_label = "Running runs";
		            for (const axis of [...root.attributes.left, ...root.attributes.below, ...root.attributes.right]) {
		                axis.attributes.axis_label_text_color = ink;
		                axis.attributes.major_label_text_color = muted;
		                axis.attributes.axis_label_text_font = font;
		                axis.attributes.major_label_text_font = font;
		                axis.attributes.axis_line_color = grid;
		                axis.attributes.major_tick_line_color = grid;
		                axis.attributes.minor_tick_line_color = grid;
		            }
		            root.attributes.right[0].attributes.axis_label_text_color = runningColor;
		            root.attributes.right[0].attributes.major_label_text_color = runningColor;
		            for (const guide of root.attributes.center) {
		                if (guide.name !== "Grid") continue;
		                guide.attributes.grid_line_color = grid;
		                guide.attributes.grid_line_alpha = 0.4;
		            }
		            const styles = [
		                {color: completedColor, alpha: 0.5, width: 1.5},
		                {color: erroredColor, alpha: 0.5, width: 1.5},
		                {color: totalColor, alpha: 1, width: 3},
		                {color: runningColor, alpha: 0.85, width: 2}
		            ];
		            for (const [index, renderer] of root.attributes.renderers.entries()) {
		                if (renderer.attributes?.glyph?.name !== "Step") continue;
		                const style = styles[index];
		                for (const kind of ["glyph", "nonselection_glyph", "muted_glyph"]) {
		                    const glyph = renderer.attributes[kind];
		                    glyph.attributes.line_color = style.color;
		                    glyph.attributes.line_alpha = style.alpha;
		                    glyph.attributes.line_width = style.width;
		                }
		            }
		            root.attributes.sizing_mode = "fixed";
		            root.attributes.width = Math.max(1, Math.round(plotElement.clientWidth));
		            root.attributes.height = Math.max(1, Math.round(plotElement.clientHeight));
		            views = await Bokeh.embed.embed_item(item, plotElement);
		            const plotView = views.get_by_id(item.root_id);
		            if (!plotView) throw new Error("Bokeh plot view missing");
		            setRunningScale = value => {
		                plotView.model.extra_y_ranges.instances.end = scaleEnd(value);
		            };
		            const panTool = plotView.model.toolbar.tools.find(tool => tool.id === "p1033");
		            const hitArea = plotView.canvas_view.events_el;
		            if (!panTool || !hitArea) throw new Error("Bokeh pan controls missing");
		            const updateCursor = () => {
		                if (plotView.model.toolbar.gestures.pan.active !== panTool) return;
		                hitArea.style.cursor = "crosshair";
		            };
		            for (const name of ["pointerover", "pointermove", "pointerdown", "pointerup", "pointercancel"]) {
		                hitArea.addEventListener(name, updateCursor);
		            }
		            removeCursorHandlers = () => {
		                for (const name of ["pointerover", "pointermove", "pointerdown", "pointerup", "pointercancel"]) {
		                    hitArea.removeEventListener(name, updateCursor);
		                }
		            };
		            applySelectionTheme();
		            themeObserver = new MutationObserver(applySelectionTheme);
		            themeObserver.observe(document.documentElement, {
		                attributes: true, attributeFilter: ["data-theme"]
		            });
		            resizeObserver = new ResizeObserver(() => {
		                const width = Math.max(1, Math.round(plotElement.clientWidth));
		                const height = Math.max(1, Math.round(plotElement.clientHeight));
		                for (const view of views ?? []) {
		                    if (view.model.id !== template.root_id) continue;
		                    view.model.width = width;
		                    view.model.height = height;
		                    const ticker = view.model.below[0]?.ticker;
		                    const axisWidth = Math.max(1, width - 60);
		                    if (ticker && ticker.args.width !== axisWidth) {
		                        ticker.args = {...ticker.args, width: axisWidth};
		                    }
		                }
		            });
		            resizeObserver.observe(plotElement);
		        })().catch(reason => { if (active) error = reason.message; });
		        return () => {
		            active = false;
		            resizeObserver?.disconnect();
		            themeObserver?.disconnect();
		            previewObserver?.disconnect();
		            bodyObserver?.disconnect();
		            removeCursorHandlers();
		            if (body) {
		                if (previousHeight) body.style.setProperty("height", previousHeight, previousPriority);
		                else body.style.removeProperty("height");
		            }
		            setRunningScale = () => {};
		            views?.clear();
		        };
		    });
		</script>

		<div class="frame" style="position:relative; width:100%; height:100%; min-height:0;">
		    <div class="plot" bind:this={plotElement} style="width:auto; height:100%; min-width:0; min-height:0; background:var(--background);"></div>
		    <div class="scale-control" title="Drag up to enlarge the running line; drag down to shrink it.">
		        <span>Running</span>
		        <input type="range" min="0" max="100" step="1" value={scalePosition}
		            aria-label="Running runs vertical scale"
		            oninput={event => { scalePosition = Number(event.currentTarget.value); setRunningScale(scalePosition); }} />
		        <span>{scaleEnd(scalePosition)}</span>
		    </div>
		    <div class="legend" style="position:absolute; top:2.4rem; right:3.3rem; display:flex; gap:0.7rem; padding:0.25rem 0.5rem; color:var(--muted); background:var(--background); font-size:0.7rem; pointer-events:none;">
		        <span style="display:inline-flex; align-items:center; gap:0.25rem;"><i style={`display:block; width:1rem; height:0.15rem; background:${totalColor};`}></i>Rows done</span>
		        <span style="display:inline-flex; align-items:center; gap:0.25rem;"><i style={`display:block; width:1rem; height:0.15rem; background:${completedColor}; opacity:0.5;`}></i>Completed claims</span>
		        <span style="display:inline-flex; align-items:center; gap:0.25rem;"><i style={`display:block; width:1rem; height:0.15rem; background:${erroredColor}; opacity:0.5;`}></i>Errored claims</span>
		        <span style="display:inline-flex; align-items:center; gap:0.25rem;"><i style={`display:block; width:1rem; height:0.15rem; background:${runningColor};`}></i>Running runs</span>
		    </div>
		    {#if error}<div class="error" style="position:absolute; inset:0; display:grid; place-items:center; padding:1rem; color:var(--error, #b91c1c); background:var(--background);">{error}</div>{/if}
		</div>

		<style>
		    .frame { position: relative; display: flex; width: 100%; height: 100%; min-height: 28rem; }
		    .plot { flex: 1; width: auto; height: 100%; min-width: 0; min-height: 0; background: var(--background); }
		    .scale-control { display: flex; flex: none; flex-direction: column; align-items: center; gap: 0.25rem; width: 2.5rem; padding: 2.7rem 0 1rem; box-sizing: border-box; color: var(--muted); background: var(--background); font-size: 0.58rem; z-index: 2; }
		    .scale-control input { flex: 1; min-height: 5rem; width: 1rem; writing-mode: vertical-rl; direction: rtl; cursor: ns-resize; accent-color: #76c6ff; }
		    .scale-control span { writing-mode: vertical-rl; text-align: center; }
		    .legend { position: absolute; top: 2.4rem; right: 0.8rem; display: flex; gap: 0.7rem; padding: 0.25rem 0.5rem; color: var(--muted); background: var(--background); font-size: 0.7rem; pointer-events: none; }
		    .legend span { display: inline-flex; align-items: center; gap: 0.25rem; }
		    .legend i { display: block; width: 1rem; height: 0.15rem; }
		    .error { position: absolute; inset: 0; display: grid; place-items: center; padding: 1rem; color: var(--error, #b91c1c); background: var(--background); }
		</style>' AS source,
		        points AS points,
		        active_points AS "activePoints",
		        peak_running AS "activePeak",
		        label AS label,
		        day AS day,
		        now_minute AS "nowMinute",
		        start_minute AS "startMinute",
		        days AS days
		    ) AS chart
		FROM summary
		WHERE completed + errored > 0
		ORDER BY last_finish_epoch DESC NULLS LAST, label
	multires_progress sql
		-- encode_multires commits with the commit of Bluejay, without claims or runs, so claims_graph cannot show it. This counts its done columns in the tables
		SELECT
		    job,
		    done,
		    target,
		    target - done                                AS remaining,
		    round(100.0 * done / greatest(target, 1), 1) AS percent
		FROM (
		    SELECT 1 AS step, 'magick_samples: latent_rgb, latent_alpha at 768, 512, 256' AS job, count(latent_rgb_256)      AS done, count(*) AS target
		    FROM magick_samples        WHERE rgb_on_gray IS NOT NULL AND alpha IS NOT NULL -- Images that split_alpha did
		    UNION ALL
		    SELECT 2 AS step, 'trimask_augmentations: latent_trimask_1024'                AS job, count(latent_trimask_1024) AS done, count(*) AS target
		    FROM trimask_augmentations WHERE trimask IS NOT NULL                           -- Every trimask
		    UNION ALL
		    SELECT 3 AS step, 'trimask_augmentations: latent_trimask at 768, 512, 256'    AS job, count(latent_trimask_256)  AS done, count(*) AS target
		    FROM trimask_augmentations WHERE trimask IS NOT NULL                           -- The trimasks of LOWRES_DIGITS (5 of 16 first hex digits, as encode_multires.py)
		      AND contains('01234', left(encode(sha256(concat(page_id, method, CAST(variant AS VARCHAR))), 'hex'), 1))
		)
		ORDER BY step
