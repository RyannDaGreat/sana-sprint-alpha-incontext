queries
	claims_graph sql
		-- One tile and one chart per processor with finished claims in the window. Times are US Eastern; a claim is timed at the finished_at of its run.
		-- Rows done: completed claims that the claim pointer of a row still holds. Completed claims also count work that was released and redone (the trimask subsets).
		-- Errored claims count each failed try; failed rows are the errored claims that no retry replaced.
		-- Running runs come from finished runs only: Bluejay writes a run row when the run ends, so a run in flight shows only as its unfinished (started) claims.
		-- encode_multires commits without claims or runs, so it is not here: see the query multires_progress.
		WITH settings AS (
		    SELECT 2  AS days -- Eastern calendar days, including today.
		),
		clock AS (
		    SELECT
		        settings.days,
		        current_timestamp AS utc_now,
		        (current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'America/New_York' AS  eastern_now
		    FROM settings
		),
		date_window AS (
		    SELECT
		        days,
		        utc_now,
		        eastern_now,
		        to_date(to_char(eastern_now, '%Y-%m-%d')) AS today,
		        to_date(to_char(eastern_now, '%Y-%m-%d')) - (days - 1) AS first_day
		    FROM clock
		),
		run_types AS (
		    SELECT processor, processor AS label FROM bluejay_runs GROUP BY processor
		),
		pointers AS ( -- The claim pointer of a row holds the claim that made the row, or that holds it now. A row released and redone has its old claims in no pointer
		    SELECT                                                                                       -- One scan of each table: a UNION of 23 scans of magick_samples made the server hang
		        p.processor,
		        CASE p.processor
		            WHEN 'download_image'           THEN m.download_claim
		            WHEN 'split_alpha'              THEN m.split_alpha_claim
		            WHEN 'encode_latents'           THEN m.encode_latents_claim
		            WHEN 'encode_colorbg'           THEN m.encode_colorbg_claim
		            WHEN 'trimask_morph_band'       THEN m.trimask_morph_band_claim
		            WHEN 'trimask_noisy_band'       THEN m.trimask_noisy_band_claim
		            WHEN 'trimask_blur_quantize'    THEN m.trimask_blur_quantize_claim
		            WHEN 'trimask_scribbles'        THEN m.trimask_scribbles_claim
		            WHEN 'trimask_bbox_unknown'     THEN m.trimask_bbox_unknown_claim
		            WHEN 'trimask_convex_hull'      THEN m.trimask_convex_hull_claim
		            WHEN 'trimask_grid_coarsen'     THEN m.trimask_grid_coarsen_claim
		            WHEN 'trimask_polygon_simplify' THEN m.trimask_polygon_simplify_claim
		            WHEN 'trimask_unknown_patches'  THEN m.trimask_unknown_patches_claim
		            WHEN 'trimask_fuzzy_ramp'       THEN m.trimask_fuzzy_ramp_claim
		            WHEN 'trimask_combo_union'      THEN m.trimask_combo_union_claim
		            WHEN 'trimask_combo_chain'      THEN m.trimask_combo_chain_claim
		            WHEN 'trimask_skeleton_strokes' THEN m.trimask_skeleton_strokes_claim
		            WHEN 'trimask_partial_view'     THEN m.trimask_partial_view_claim
		            WHEN 'trimask_bilateral_blur'   THEN m.trimask_bilateral_blur_claim
		            WHEN 'trimask_random_stack'     THEN m.trimask_random_stack_claim
		            WHEN 'trimask_perlin_warp'      THEN m.trimask_perlin_warp_claim
		            WHEN 'trimask_op_chain'         THEN m.trimask_op_chain_claim
		            WHEN 'trimask_glass_ripple'     THEN m.trimask_glass_ripple_claim
		        END AS claim_id
		    FROM magick_samples AS m
		    CROSS JOIN (VALUES
		        ('download_image'),
		        ('split_alpha'),
		        ('encode_latents'),
		        ('encode_colorbg'),
		        ('trimask_morph_band'),
		        ('trimask_noisy_band'),
		        ('trimask_blur_quantize'),
		        ('trimask_scribbles'),
		        ('trimask_bbox_unknown'),
		        ('trimask_convex_hull'),
		        ('trimask_grid_coarsen'),
		        ('trimask_polygon_simplify'),
		        ('trimask_unknown_patches'),
		        ('trimask_fuzzy_ramp'),
		        ('trimask_combo_union'),
		        ('trimask_combo_chain'),
		        ('trimask_skeleton_strokes'),
		        ('trimask_partial_view'),
		        ('trimask_bilateral_blur'),
		        ('trimask_random_stack'),
		        ('trimask_perlin_warp'),
		        ('trimask_op_chain'),
		        ('trimask_glass_ripple')
		    ) AS p (processor)                                                                   UNION ALL
		    SELECT 'import_index'  AS processor, import_claim        AS claim_id FROM import_jobs      UNION ALL
		    SELECT 'plan_eval'     AS processor, plan_eval_claim     AS claim_id FROM eval_models      UNION ALL
		    SELECT 'generate_eval' AS processor, generate_eval_claim AS claim_id FROM eval_generations
		),
		claim_counts AS ( -- The one pass over the claims
		    SELECT
		        COALESCE(r.processor, p.processor)                                   AS processor,
		        c.claim_status                                                       AS status,
		        p.claim_id IS NOT NULL                                               AS current,
		        CAST(FLOOR(date_part('epoch', to_timestamp(r.finished_at)) / 60) AS BIGINT) AS minute,
		        count(*)                                                             AS claims
		    FROM bluejay_claims    AS c                                       -- Every claim,
		    LEFT JOIN bluejay_runs AS r ON r.run_id   = c.run_id   -- with its run if the run ended (Bluejay writes the run row at the end; minute is NULL before),
		    LEFT JOIN pointers     AS p ON p.claim_id = c.claim_id -- and the row that still points to it, if any
		    GROUP BY 1, 2, 3, 4
		),
		facts AS ( -- has_pointer: the processor has a claim pointer in the DTAB. Others (encode_trimask, now removed) count each completed claim as a row
		    SELECT
		        f.*,
		        bool_or(f.current) OVER (PARTITION BY f.processor) AS has_pointer,
		        f.minute IS NOT NULL
		            AND to_date(to_char((to_timestamp(f.minute * 60) AT TIME ZONE 'UTC') AT TIME ZONE 'America/New_York', '%Y-%m-%d'))
		                BETWEEN w.first_day AND w.today
		            AND f.minute * 60 <= date_part('epoch', w.utc_now)        AS in_window
		    FROM claim_counts AS f
		    CROSS JOIN date_window AS w
		),
		minute_counts AS (
		    SELECT
		        processor,
		        minute,
		        SUM(CASE WHEN in_window AND status = 'completed' AND (current OR NOT has_pointer) THEN claims ELSE 0 END) AS done,
		        SUM(CASE WHEN in_window AND status = 'completed'                                  THEN claims ELSE 0 END) AS completed,
		        SUM(CASE WHEN in_window AND status = 'errored'                                    THEN claims ELSE 0 END) AS errored,
		        SUM(CASE WHEN     current AND status = 'errored'                                  THEN claims ELSE 0 END) AS failed_rows, -- All time, not the window
		        SUM(CASE WHEN     current AND status = 'started'                                  THEN claims ELSE 0 END) AS unfinished,
		        SUM(CASE WHEN NOT current AND status = 'completed' AND has_pointer                THEN claims ELSE 0 END) AS redone,
		        SUM(CASE WHEN NOT current AND status = 'errored'   AND has_pointer                THEN claims ELSE 0 END) AS retried
		    FROM facts
		    GROUP BY processor, minute
		),
		running AS (
		    SELECT
		        processor,
		        minute,
		        done + completed + errored > 0                                AS has_point,
		        SUM(done)        OVER (PARTITION BY processor ORDER BY minute) AS done,
		        SUM(completed)   OVER (PARTITION BY processor ORDER BY minute) AS completed,
		        SUM(errored)     OVER (PARTITION BY processor ORDER BY minute) AS errored,
		        SUM(failed_rows) OVER (PARTITION BY processor)                 AS failed_rows,
		        SUM(unfinished)  OVER (PARTITION BY processor)                 AS unfinished,
		        SUM(redone)      OVER (PARTITION BY processor)                 AS redone,
		        SUM(retried)     OVER (PARTITION BY processor)                 AS retried
		    FROM minute_counts
		),
		run_intervals AS (
		    SELECT
		        r.processor,
		        GREATEST(
		            date_part('epoch', to_timestamp(r.started_at)) / 60.0,
		            date_part('epoch', CAST(w.first_day AS TIMESTAMP) AT TIME ZONE 'America/New_York') / 60.0
		        ) AS begin_minute,
		        LEAST(
		            date_part('epoch', to_timestamp(r.finished_at)) / 60.0,
		            date_part('epoch', w.utc_now) / 60.0
		        ) AS end_minute
		    FROM bluejay_runs AS r
		    CROSS JOIN date_window AS w
		    WHERE r.started_at IS NOT NULL
		        AND r.finished_at IS NOT NULL
		        AND date_part('epoch', to_timestamp(r.started_at)) < date_part('epoch', w.utc_now)
		        AND date_part('epoch', to_timestamp(r.finished_at)) >
		            date_part('epoch', CAST(w.first_day AS TIMESTAMP) AT TIME ZONE 'America/New_York')
		),
		activity_events AS (
		    SELECT processor, begin_minute AS minute, 1 AS change FROM run_intervals
		    UNION ALL
		    SELECT processor, end_minute AS minute, -1 AS change FROM run_intervals
		),
		activity_steps AS (
		    SELECT
		        processor,
		        minute,
		        SUM(change) OVER (PARTITION BY processor ORDER BY minute) AS running_instances
		    FROM (
		        SELECT processor, minute, SUM(change) AS change
		        FROM activity_events
		        GROUP BY processor, minute
		    ) AS events
		),
		activity_buckets AS (
		    SELECT
		        a.*,
		        CAST(FLOOR(159.0 * (a.minute - limits.begin_minute)
		            / GREATEST(limits.end_minute - limits.begin_minute, 1.0)) AS INT) AS bucket
		    FROM activity_steps AS a
		    CROSS JOIN (
		        SELECT
		            date_part('epoch', CAST(first_day AS TIMESTAMP) AT TIME ZONE 'America/New_York') / 60.0 AS begin_minute,
		            date_part('epoch', utc_now) / 60.0 AS end_minute
		        FROM date_window
		    ) AS limits
		),
		activity_ranked AS (
		    SELECT
		        *,
		        ROW_NUMBER() OVER (PARTITION BY processor, bucket ORDER BY minute) AS first_rank,
		        ROW_NUMBER() OVER (PARTITION BY processor, bucket ORDER BY minute DESC) AS last_rank,
		        ROW_NUMBER() OVER (PARTITION BY processor, bucket ORDER BY running_instances, minute) AS low_rank,
		        ROW_NUMBER() OVER (PARTITION BY processor, bucket ORDER BY running_instances DESC, minute) AS high_rank
		    FROM activity_buckets
		),
		per_processor AS ( -- One GROUP BY over the union of the minute rows, the running-run rows and the runs, so no join follows array_agg. Joins after it (as MulticamDailies did) made the server hang with the pointer scans
		    SELECT
		        processor,
		        MAX(done)        AS done,
		        MAX(completed)   AS completed,
		        MAX(errored)     AS errored,
		        MAX(failed_rows) AS failed_rows,
		        MAX(unfinished)  AS unfinished,
		        MAX(redone)      AS redone,
		        MAX(retried)     AS retried,
		        array_agg(struct(minute AS minute, done AS total, completed AS completed, errored AS errored) ORDER BY minute)
		            FILTER (WHERE kind = 'claims' AND has_point)                                AS points,
		        array_agg(struct(active_minute AS minute, running AS running) ORDER BY active_minute)
		            FILTER (WHERE kind = 'running')                                             AS active_points,
		        COALESCE(MAX(running), 0)                                                       AS peak_running,
		        MAX(last_finish_epoch)                                                          AS last_finish_epoch
		    FROM (
		        SELECT 'claims' AS kind, processor, minute, has_point, done, completed, errored, failed_rows, unfinished, redone, retried,
		               CAST(NULL AS DOUBLE) AS active_minute, CAST(NULL AS BIGINT) AS running, CAST(NULL AS DOUBLE) AS last_finish_epoch
		        FROM running
		        UNION ALL
		        SELECT 'running' AS kind, processor, CAST(NULL AS BIGINT) AS minute, false AS has_point, NULL AS done, NULL AS completed, NULL AS errored,
		               NULL AS failed_rows, NULL AS unfinished, NULL AS redone, NULL AS retried,
		               activity_ranked.minute AS active_minute, running_instances AS running, NULL AS last_finish_epoch
		        FROM activity_ranked
		        WHERE first_rank = 1 OR last_rank = 1 OR low_rank = 1 OR high_rank = 1
		        UNION ALL
		        SELECT 'runs' AS kind, processor, CAST(NULL AS BIGINT) AS minute, false AS has_point, NULL AS done, NULL AS completed, NULL AS errored,
		               NULL AS failed_rows, NULL AS unfinished, NULL AS redone, NULL AS retried,
		               NULL AS active_minute, NULL AS running, date_part('epoch', to_timestamp(finished_at)) AS last_finish_epoch
		        FROM bluejay_runs
		    ) AS parts
		    WHERE processor IS NOT NULL
		    GROUP BY processor
		),
		summary AS (
		    SELECT
		        p.processor AS label,
		        to_char(w.first_day, '%b %-d, %Y') || ' – '
		            || to_char(w.eastern_now, '%b %-d, %Y') AS day,
		        w.days,
		        CAST(FLOOR(date_part('epoch',
		            CAST(w.first_day AS TIMESTAMP) AT TIME ZONE 'America/New_York'
		        ) / 60) AS BIGINT) AS start_minute,
		        CAST(FLOOR(date_part('epoch', w.utc_now) / 60) AS BIGINT) AS now_minute,
		        COALESCE(p.done, 0) AS done,
		        COALESCE(p.completed, 0) AS completed,
		        COALESCE(p.errored, 0) AS errored,
		        COALESCE(p.failed_rows, 0) AS failed_rows,
		        COALESCE(p.unfinished, 0) AS unfinished,
		        COALESCE(p.redone, 0) AS redone,
		        COALESCE(p.retried, 0) AS retried,
		        p.points,
		        p.active_points,
		        p.peak_running,
		        p.last_finish_epoch
		    FROM per_processor AS p
		    CROSS JOIN date_window AS w
		)
		SELECT
		    struct(
		        'svelte' AS widget,
		        -last_finish_epoch AS sort,
		        '<script>
		    import { onMount } from "svelte";

		    let {
		        done = 0, completed = 0, errored = 0, failedRows = 0, unfinished = 0, redone = 0, retried = 0,
		        label = "", samplePoints = [], activeSamplePoints = [], activePeak = 0,
		        startMinute = 0, nowMinute = 0, lastFinishEpoch = 0
		    } = $props();
		    let nowMs = $state(Date.now());
		    let totalColor = $state("#ffad20");
		    let completedColor = $state("#57d68d");
		    let erroredColor = $state("#ff7373");

		    onMount(() => {
		        const theme = getComputedStyle(document.documentElement);
		        totalColor = theme.getPropertyValue("--accent").trim() || "#ffad20";
		        const dark = document.documentElement.dataset.theme === "dark";
		        completedColor = dark ? "#57d68d" : "#167c4b";
		        erroredColor = dark ? "#ff7373" : "#ba3038";
		        const timer = window.setInterval(() => nowMs = Date.now(), 1000);
		        return () => window.clearInterval(timer);
		    });

		    const segments = {
		        "0": [0, 1, 2, 3, 4, 5], "1": [1, 2],
		        "2": [0, 1, 6, 4, 3], "3": [0, 1, 6, 2, 3],
		        "4": [5, 6, 1, 2], "5": [0, 5, 6, 2, 3],
		        "6": [0, 5, 6, 4, 2, 3], "7": [0, 1, 2],
		        "8": [0, 1, 2, 3, 4, 5, 6], "9": [0, 1, 2, 3, 5, 6]
		    };
		    const boxes = [
		        [3, 0, 12, 2], [15, 2, 2, 11], [15, 17, 2, 11],
		        [3, 28, 12, 2], [1, 17, 2, 11], [1, 2, 2, 11],
		        [3, 14, 12, 2]
		    ];
		    const box = (x, y, width, height) => `M ${x} ${y} h ${width} v ${height} h -${width} Z`;

		    function sevenSegment(value) {
		        let x = 0;
		        let path = "";
		        for (const character of value) {
		            if (character === ":") {
		                path += box(x + 2, 8, 2, 3) + box(x + 2, 20, 2, 3);
		                x += 7;
		            } else {
		                for (const segment of segments[character] ?? []) {
		                    const [left, top, width, height] = boxes[segment];
		                    path += box(x + left, top, width, height);
		                }
		                x += 20;
		            }
		        }
		        return { path, width: Math.max(x - 2, 1) };
		    }

		    let elapsed = $derived.by(() => {
		        const seconds = Math.max(0, Math.floor(nowMs / 1000 - Number(lastFinishEpoch)));
		        const days = Math.floor(seconds / 86400);
		        const hours = Math.floor(seconds % 86400 / 3600);
		        const minutes = Math.floor(seconds % 3600 / 60);
		        const remainder = seconds % 60;
		        const two = number => String(number).padStart(2, "0");
		        return {
		            dayWord: days === 1 ? "day" : "days",
		            dayDigits: sevenSegment(String(days)),
		            clockDigits: sevenSegment(`${two(hours)}:${two(minutes)}:${two(remainder)}`)
		        };
		    });

		    let graph = $derived.by(() => {
		        const start = Number(startMinute);
		        const end = Math.max(start + 1, Number(nowMinute));
		        const points = (samplePoints ?? []).filter(Boolean).map(point => ({
		            minute: Number(point.minute),
		            total: Number(point.total),
		            completed: Number(point.completed),
		            errored: Number(point.errored)
		        }));
		        const peak = Math.max(1, Number(done), Number(completed), Number(errored));
		        const x = minute => 1000 * Math.max(0, Math.min(1, (minute - start) / (end - start)));
		        const y = value => 100 - 100 * Math.max(0, Math.min(1, value / peak));
		        function step(field) {
		            let path = `M 0 ${y(0)}`;
		            for (const point of points) path += ` H ${x(point.minute)} V ${y(point[field])}`;
		            return path + " H 1000";
		        }
		        const active = (activeSamplePoints ?? []).filter(Boolean).map(point => ({
		            minute: Number(point.minute), running: Number(point.running)
		        }));
		        const activeY = value => 100 - 100 * Math.max(0, Math.min(1, value / Math.max(1, Number(activePeak))));
		        let running = `M 0 ${activeY(0)}`;
		        for (const point of active) running += ` H ${x(point.minute)} V ${activeY(point.running)}`;
		        return {
		            total: step("total"),
		            completed: step("completed"),
		            errored: step("errored"),
		            running
		        };
		    });
		</script>

		<div style="position:relative; box-sizing:border-box; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0.1rem; width:100%; height:100%; min-height:6rem; padding:0.3rem; text-align:center; font-family:inherit; overflow:hidden;">
		    <svg viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true" style="position:absolute; inset:0; width:100%; height:100%; opacity:0.5; pointer-events:none; z-index:0;">
		        <path d={graph.completed} fill="none" stroke={completedColor} stroke-width="1.5" vector-effect="non-scaling-stroke" />
		        <path d={graph.errored} fill="none" stroke={erroredColor} stroke-width="1.5" vector-effect="non-scaling-stroke" />
		        <path d={graph.total} fill="none" stroke={totalColor} stroke-width="2.5" vector-effect="non-scaling-stroke" />
		        <path d={graph.running} fill="none" stroke="#76c6ff" stroke-width="1.5" vector-effect="non-scaling-stroke" />
		    </svg>
		    <div style="position:relative; z-index:1; width:100%; text-align:center; font-size:0.9rem; font-weight:700; line-height:1.1; overflow-wrap:anywhere;">{label}</div>
		    <div style="position:relative; z-index:1; width:100%; text-align:center; color:#15803d; font-size:1.3rem; font-weight:700; line-height:1.1; font-variant-numeric:tabular-nums;" title="Rows done: completed claims that the claim pointer of a row still holds">{Number(done).toLocaleString()} rows</div>
		    <div style="position:relative; z-index:1; width:100%; text-align:center; color:#dc2626; font-size:0.65rem; font-weight:600; line-height:1.1;" title="Failed rows: errored claims that no retry replaced. Retried: errored claims that a retry replaced">{Number(failedRows).toLocaleString()} failed rows · {Number(retried).toLocaleString()} retried errors</div>
		    <div style="position:relative; z-index:1; width:100%; text-align:center; color:var(--muted); font-size:0.65rem; line-height:1.1;" title="Redone: completed claims of rows that were released and made again. Unfinished: started claims that a row still holds, in flight or abandoned">{Number(redone).toLocaleString()} redone · {Number(unfinished).toLocaleString()} unfinished</div>
		    <div style="position:relative; z-index:1; display:flex; align-items:center; justify-content:center; gap:0.3rem; width:100%; margin-top:auto; white-space:nowrap; color:var(--text);">
		        <svg viewBox={`0 0 ${elapsed.dayDigits.width} 30`} aria-label={String(Math.floor(Math.max(0, nowMs / 1000 - Number(lastFinishEpoch)) / 86400))} style={`width:${elapsed.dayDigits.width / 2}px; height:15px; flex:none;`}><path d={elapsed.dayDigits.path} fill="currentColor" /></svg>
		        <span style="font-size:0.75rem; line-height:1;">{elapsed.dayWord}</span>
		        <svg viewBox={`0 0 ${elapsed.clockDigits.width} 30`} aria-label="hours minutes seconds" style={`width:${elapsed.clockDigits.width / 2}px; height:15px; flex:none;`}><path d={elapsed.clockDigits.path} fill="currentColor" /></svg>
		    </div>
		</div>' AS source,
		        done AS done,
		        completed AS completed,
		        errored AS errored,
		        failed_rows AS "failedRows",
		        unfinished AS unfinished,
		        redone AS redone,
		        retried AS retried,
		        label AS label,
		        points AS "samplePoints",
		        active_points AS "activeSamplePoints",
		        peak_running AS "activePeak",
		        start_minute AS "startMinute",
		        now_minute AS "nowMinute",
		        last_finish_epoch AS "lastFinishEpoch"
		    ) AS thumbnail,
		    struct(
		        'svelte' AS widget,
		        '<script>
		    import { onMount } from "svelte";

		    let { points = [], activePoints = [], activePeak = 0, label = "", day = "", nowMinute = 0, startMinute = 0, days = 1 } = $props();
		    let plotElement;
		    let error = $state("");
		    let totalColor = $state("#ffad20");
		    let completedColor = $state("#57d68d");
		    let erroredColor = $state("#ff7373");
		    let runningColor = $state("#76c6ff");
		    let scalePosition = $state(50);
		    let setRunningScale = () => {};
		    const scaleEnd = value => Math.max(1, Math.ceil(Math.max(1, Number(activePeak)) * 1.2 * Math.pow(2, (50 - value) / 20)));
		    const template = {"target_id":null,"root_id":"p1011","doc":{"version":"3.9.2","title":"","config":{"type":"object","name":"DocumentConfig","id":"p1060","attributes":{"notifications":{"type":"object","name":"Notifications","id":"p1061"}}},"roots":[{"type":"object","name":"Figure","id":"p1011","attributes":{"js_event_callbacks":{"type":"map","entries":[["tap",[{"type":"object","name":"CustomJS","id":"p3018","attributes":{"args":{"type":"map","entries":[["markers",{"type":"object","name":"ColumnDataSource","id":"p3000","attributes":{"js_property_callbacks":{"type":"map","entries":[["change:data",[{"type":"object","name":"CustomJS","id":"p5000","attributes":{"args":{"type":"map","entries":[["markers",{"id":"p3000"}],["plot",{"id":"p1011"}],["vertical",{"type":"object","name":"Arrow","id":"p4000","attributes":{"visible":false,"source":{"type":"object","name":"ColumnDataSource","id":"p4001","attributes":{"selected":{"type":"object","name":"Selection","id":"p4002","attributes":{"indices":[],"line_indices":[]}},"selection_policy":{"type":"object","name":"UnionRenderers","id":"p4003"}}},"x_start":{"type":"value","value":0},"y_start":{"type":"value","value":0},"start":{"type":"object","name":"OpenHead","id":"p4004","attributes":{"size":{"type":"value","value":8},"line_color":{"type":"value","value":"#4f90ff"},"line_alpha":{"type":"value","value":0.5}}},"x_end":{"type":"value","value":1},"y_end":{"type":"value","value":1},"end":{"type":"object","name":"OpenHead","id":"p4005","attributes":{"size":{"type":"value","value":8},"line_color":{"type":"value","value":"#4f90ff"},"line_alpha":{"type":"value","value":0.5}}},"line_color":{"type":"value","value":"#4f90ff"},"line_alpha":{"type":"value","value":0.5}}}],["horizontal",{"type":"object","name":"Arrow","id":"p4006","attributes":{"visible":false,"source":{"type":"object","name":"ColumnDataSource","id":"p4007","attributes":{"selected":{"type":"object","name":"Selection","id":"p4008","attributes":{"indices":[],"line_indices":[]}},"selection_policy":{"type":"object","name":"UnionRenderers","id":"p4009"}}},"x_start":{"type":"value","value":0},"y_start":{"type":"value","value":0},"start":{"type":"object","name":"OpenHead","id":"p4010","attributes":{"size":{"type":"value","value":8},"line_color":{"type":"value","value":"#4f90ff"},"line_alpha":{"type":"value","value":0.5}}},"x_end":{"type":"value","value":1},"y_end":{"type":"value","value":1},"end":{"type":"object","name":"OpenHead","id":"p4011","attributes":{"size":{"type":"value","value":8},"line_color":{"type":"value","value":"#4f90ff"},"line_alpha":{"type":"value","value":0.5}}},"line_color":{"type":"value","value":"#4f90ff"},"line_alpha":{"type":"value","value":0.5}}}],["series",{"type":"object","name":"ColumnDataSource","id":"p1006","attributes":{"name":"series","selected":{"type":"object","name":"Selection","id":"p1007","attributes":{"indices":[],"line_indices":[]}},"selection_policy":{"type":"object","name":"UnionRenderers","id":"p1008"},"data":{"type":"map","entries":[["x",[0,1]],["y",[0,0]],["label",["12:00 AM","12:01 AM"]]]}}}],["trend",{"type":"object","name":"Slope","id":"p3010","attributes":{"level":"underlay","visible":false,"gradient":0,"y_intercept":0,"line_color":"#4f90ff","line_alpha":0.5,"line_width":2,"line_dash":[6]}}],["sameTime",{"type":"object","name":"Span","id":"p3011","attributes":{"level":"underlay","visible":false,"location":0,"dimension":"height","line_color":"#4f90ff","line_alpha":0.5,"line_width":2,"line_dash":[6]}}],["claimsLabel",{"type":"object","name":"Label","id":"p4012","attributes":{"visible":false,"text_color":"#4f90ff","text_alpha":0.5,"text_font_size":"10pt","text_align":"center","text_baseline":"middle","x":0,"y":0,"x_offset":-11,"angle":1.5707963267948966}}],["timeLabel",{"type":"object","name":"Label","id":"p4013","attributes":{"visible":false,"text_color":"#4f90ff","text_alpha":0.5,"text_font_size":"10pt","text_align":"center","x":0,"y":0,"y_offset":10}}],["rateLabel",{"type":"object","name":"Label","id":"p5001","attributes":{"visible":false,"text_color":"#4f90ff","text_alpha":0.5,"text_font_size":"10pt","text_align":"right","text_baseline":"middle","x":0,"y":0,"x_offset":-11.464466094067262,"y_offset":11.464466094067262,"angle":-0.7853981633974483}}]]},"code":"\n// Keep dragged measurements on the plotted total-claims series.\nconst times = series.data.x;\nconst totals = series.data.total;\nif (times?.length && markers.data.x?.length) {\n    const x = [...markers.data.x];\n    const y = [...markers.data.y];\n    let changed = false;\n    for (let i = 0; i < x.length; i++) {\n        const minute = Math.max(times[0], Math.min(times.at(-1), Math.round(Number(x[i]))));\n        let low = 0;\n        let high = times.length;\n        while (low < high) {\n            const middle = (low + high) >>> 1;\n            if (times[middle] <= minute) low = middle + 1;\n            else high = middle;\n        }\n        const total = Number(totals[Math.max(0, low - 1)] ?? 0);\n        if (x[i] !== minute || y[i] !== total) changed = true;\n        x[i] = minute;\n        y[i] = total;\n    }\n    if (changed) {\n        markers.data = {...markers.data, x, y};\n        return;\n    }\n}\n\nconst xs = markers.data.x ?? [];\nconst ys = markers.data.y ?? [];\nif (xs.length !== 2 || ys.length !== 2) {\n    vertical.visible = false;\n    horizontal.visible = false;\n    trend.visible = false;\n    sameTime.visible = false;\n    claimsLabel.visible = false;\n    timeLabel.visible = false;\n    rateLabel.visible = false;\n    return;\n}\nconst width = Number(plot.inner_width);\nconst height = Number(plot.inner_height);\nconst xSpan = Math.abs(plot.x_range.end - plot.x_range.start);\nconst ySpan = Math.abs(plot.y_range.end - plot.y_range.start);\nif (!(width > 0 && height > 0 && xSpan > 0 && ySpan > 0)) {\n    vertical.visible = false;\n    horizontal.visible = false;\n    return;\n}\nconst earlier = xs[0] <= xs[1] ? 0 : 1;\nconst later = 1 - earlier;\nconst leftX = xs[earlier];\nconst rightX = xs[later];\nconst leftY = ys[earlier];\nconst rightY = ys[later];\nconst leftRadiusPx = Number(markers.data.size?.[earlier] ?? 11) / 2;\nconst rightRadiusPx = Number(markers.data.size?.[later] ?? 11) / 2;\nconst gapPx = 4;\nconst xPerPixel = xSpan / width;\nconst yPerPixel = ySpan / height;\nconst yDirection = Math.sign(rightY - leftY);\n\nvertical.x_start = leftX;\nvertical.y_start = leftY + yDirection * (leftRadiusPx + gapPx) * yPerPixel;\nvertical.x_end = leftX;\nvertical.y_end = rightY - yDirection * gapPx * yPerPixel;\nvertical.visible = Math.abs(rightY - leftY) > (leftRadiusPx + 2 * gapPx) * yPerPixel;\n\nhorizontal.x_start = leftX + gapPx * xPerPixel;\nhorizontal.y_start = rightY;\nhorizontal.x_end = rightX - (rightRadiusPx + gapPx) * xPerPixel;\nhorizontal.y_end = rightY;\nhorizontal.visible = rightX - leftX > (rightRadiusPx + 2 * gapPx) * xPerPixel;\n\n\n// Recalculate the trend and labels whenever a point is dragged.\nif (xs[0] === xs[1]) {\n    trend.visible = false;\n    sameTime.location = xs[0];\n    sameTime.visible = true;\n} else {\n    sameTime.visible = false;\n    const gradient = (ys[1] - ys[0]) / (xs[1] - xs[0]);\n    trend.gradient = gradient;\n    trend.y_intercept = ys[0] - gradient * xs[0];\n    trend.visible = true;\n}\nclaimsLabel.x = leftX;\nclaimsLabel.y = (leftY + rightY) / 2;\nclaimsLabel.text = (rightY - leftY).toLocaleString();\nclaimsLabel.visible = true;\nconst minutes = Math.abs(rightX - leftX);\nlet duration;\nif (minutes < 60) {\n    duration = `${minutes} min`;\n} else if (minutes < 1440) {\n    const hours = Math.floor(minutes / 60);\n    const rest = minutes % 60;\n    duration = `${hours} hr${rest ? ` ${rest} min` : \"\"}`;\n} else {\n    const days = Math.floor(minutes / 1440);\n    const hours = Math.floor(minutes % 1440 / 60);\n    const rest = minutes % 60;\n    duration = `${days} d${hours ? ` ${hours} hr` : \"\"}${rest ? ` ${rest} min` : \"\"}`;\n}\ntimeLabel.x = (leftX + rightX) / 2;\ntimeLabel.y = rightY;\ntimeLabel.text = duration;\ntimeLabel.visible = true;\nif (minutes > 0) {\n    const unitMinutes = minutes < 60 ? 1 : minutes < 1440 ? 60 : 1440;\n    const unit = minutes < 60 ? \"min\" : minutes < 1440 ? \"hr\" : \"day\";\n    const rate = (rightY - leftY) * unitMinutes / minutes;\n    rateLabel.x = leftX;\n    rateLabel.y = rightY;\n    rateLabel.text = `${new Intl.NumberFormat(\"en-US\", {maximumSignificantDigits: 3}).format(rate)}/${unit}`;\n    rateLabel.visible = true;\n} else {\n    rateLabel.visible = false;\n}\n"}}]]]},"selected":{"type":"object","name":"Selection","id":"p3001","attributes":{"indices":[],"line_indices":[]}},"selection_policy":{"type":"object","name":"UnionRenderers","id":"p3002"},"data":{"type":"map","entries":[["x",[]],["y",[]],["size",[]],["fill",[]]]}}}],["state",{"type":"object","name":"ColumnDataSource","id":"p3012","attributes":{"selected":{"type":"object","name":"Selection","id":"p3013","attributes":{"indices":[],"line_indices":[]}},"selection_policy":{"type":"object","name":"UnionRenderers","id":"p3014"},"data":{"type":"map","entries":[["next",[0]],["hovered",[-1]]]}}}],["trend",{"id":"p3010"}],["sameTime",{"id":"p3011"}],["series",{"id":"p1006"}],["plot",{"id":"p1011"}],["vertical",{"id":"p4000"}],["horizontal",{"id":"p4006"}],["claimsLabel",{"id":"p4012"}],["timeLabel",{"id":"p4013"}],["rateLabel",{"id":"p5001"}]]},"code":"\nfunction hideMeasurement() {\n    vertical.visible = false;\n    horizontal.visible = false;\n    claimsLabel.visible = false;\n    timeLabel.visible = false;\n    rateLabel.visible = false;\n}\n\nconst selectionColor = document.documentElement.dataset.theme === \"dark\" ? \"#93c5fd\" : \"#1d4ed8\";\nconst xs = markers.data.x;\nconst ys = markers.data.y;\nconst xSpan = Math.abs(plot.x_range.end - plot.x_range.start);\nconst ySpan = Math.abs(plot.y_range.end - plot.y_range.start);\nconst width = plot.inner_width;\nconst height = plot.inner_height;\nlet hit = -1;\nlet best = 8;\nif (Number.isFinite(cb_obj.x) && Number.isFinite(cb_obj.y) &&\n    Number.isFinite(width) && Number.isFinite(height) &&\n    xSpan > 0 && ySpan > 0) {\n    for (let i = 0; i < xs.length; i++) {\n        const dx = (cb_obj.x - xs[i]) * width / xSpan;\n        const dy = (cb_obj.y - ys[i]) * height / ySpan;\n        const distance = Math.hypot(dx, dy);\n        if (distance <= best) {\n            hit = i;\n            best = distance;\n        }\n    }\n}\n\nif (hit !== -1) {\n    const x = [...xs];\n    const y = [...ys];\n    x.splice(hit, 1);\n    y.splice(hit, 1);\n    markers.data = {\n        x, y,\n        size: x.map(() => 11),\n        fill: x.map(() => selectionColor)\n    };\n    markers.selected.indices = [];\n    state.data = {next: [x.length], hovered: [-1]};\n    trend.visible = false;\n    sameTime.visible = false;\n    hideMeasurement();\n    return;\n}\n\nconst time = Math.round(cb_obj.x);\nconst times = series.data.x;\nconst totals = series.data.total;\nif (!Number.isFinite(time) || time < times[0] || time > times[times.length - 1]) return;\nlet low = 0;\nlet high = times.length;\nwhile (low < high) {\n    const middle = (low + high) >>> 1;\n    if (times[middle] <= time) low = middle + 1;\n    else high = middle;\n}\nconst total = totals[Math.max(0, low - 1)] ?? 0;\nconst x = [...xs];\nconst y = [...ys];\nconst slot = x.length < 2 ? x.length : (state.data.next[0] ?? 0);\nif (slot < x.length) {\n    x[slot] = time;\n    y[slot] = total;\n} else {\n    x.push(time);\n    y.push(total);\n}\nmarkers.data = {\n    x, y,\n    size: x.map(() => 11),\n    fill: x.map(() => selectionColor)\n};\nmarkers.selected.indices = [];\nstate.data = {next: [1 - slot], hovered: [-1]};\nif (x.length < 2) {\n    trend.visible = false;\n    sameTime.visible = false;\n    hideMeasurement();\n    return;\n}\nif (x[0] === x[1]) {\n    trend.visible = false;\n    sameTime.location = x[0];\n    sameTime.visible = true;\n} else {\n    sameTime.visible = false;\n    const gradient = (y[1] - y[0]) / (x[1] - x[0]);\n    trend.gradient = gradient;\n    trend.y_intercept = y[0] - gradient * x[0];\n    trend.visible = true;\n}\n\n// Keep the right angle anchored to the earlier and later selected points.\nconst earlier = x[0] <= x[1] ? 0 : 1;\nconst later = 1 - earlier;\nconst leftX = x[earlier];\nconst rightX = x[later];\nconst leftY = y[earlier];\nconst rightY = y[later];\n\nclaimsLabel.x = leftX;\nclaimsLabel.y = (leftY + rightY) / 2;\n// claimsLabel.text = `\ud835\udeabClaims: ${(rightY - leftY).toLocaleString()}`;\nclaimsLabel.text = (rightY - leftY).toLocaleString();\nclaimsLabel.visible = true;\n\nconst minutes = Math.abs(rightX - leftX);\nlet duration;\nif (minutes < 60) {\n    duration = `${minutes} min`;\n} else if (minutes < 1440) {\n    const hours = Math.floor(minutes / 60);\n    const rest = minutes % 60;\n    duration = `${hours} hr${rest ? ` ${rest} min` : \"\"}`;\n} else {\n    const days = Math.floor(minutes / 1440);\n    const hours = Math.floor(minutes % 1440 / 60);\n    const rest = minutes % 60;\n    duration = `${days} d${hours ? ` ${hours} hr` : \"\"}${rest ? ` ${rest} min` : \"\"}`;\n}\ntimeLabel.x = (leftX + rightX) / 2;\ntimeLabel.y = rightY;\n// timeLabel.text = `\ud835\udeabTime: ${duration}`;\ntimeLabel.text = duration;\ntimeLabel.visible = true;\n\n// The label ends at the right-angle corner and extends down-left at 45\u00b0.\nif (minutes > 0) {\n    const unitMinutes = minutes < 60 ? 1 : minutes < 1440 ? 60 : 1440;\n    const unit = minutes < 60 ? \"min\" : minutes < 1440 ? \"hr\" : \"day\";\n    const rate = (rightY - leftY) * unitMinutes / minutes;\n    rateLabel.x = leftX;\n    rateLabel.y = rightY;\n    rateLabel.text = `${new Intl.NumberFormat(\"en-US\", {maximumSignificantDigits: 3}).format(rate)}/${unit}`;\n    rateLabel.visible = true;\n} else {\n    rateLabel.visible = false;\n}\n\n"}}]],["mousemove",[{"type":"object","name":"CustomJS","id":"p3019","attributes":{"args":{"type":"map","entries":[["markers",{"id":"p3000"}],["stat