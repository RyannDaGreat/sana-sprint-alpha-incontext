				method_id @	    [Key]  str   The candidate                                                                    "r2a5_e1h0_skip16"
				model_dir @	          ~str   Folder of model.py, ckpt.pt, genome.json                                         "agents/.scratchpad/fastdec_ga/r2/agent_5"
		commit
			fd_renders
				children/	                TYPE   DESCRIPTION                                                                      EXAMPLE
					mp4 clip.mp4	         blob   H.264 CRF 12, 141 frames, 24 fps, 512 x 512                                      3 MB .mp4
					fields.json	   SUBFIELD  TYPE   DESCRIPTION                                                                      EXAMPLE
						method_id @	   [Key]  str    The candidate                                                                    "r2a5_e1h0_skip16"
						clip_id @	   [Key]  str    The Pexels id of the val clip                                                    "8620887"
						n_frames @	          int    Frames                                                                           141
						fps @	              float  Frames per second                                                                24.0
						psnr_vs_full @	      float  This clip against the full decode, dB                                            30.9
						ssim_vs_full @	      float  This clip against the full decode                                                0.83
						lpips_vs_full @	      float  This clip against the full decode, alex                                          0.165

