environ
	 Batch sizes, in processor order. Not measured yet: tune them on the node
	DOWNLOAD_BATCH_SIZE 64	 Images per run of download_image. Network bound: 1.5 MB per PNG
	SPLIT_BATCH_SIZE 64	     Images per run of split_alpha. CPU only: it reads 1 PNG and writes 2
	ENCODE_BATCH_SIZE 64	 Images per run of encode_latents. run_proc_curate.fish starts one loop per GPU

	 Data
	MAGICK_REPO OneOverZero/MAGICK	 Hugging Face dataset: 140,955 RGBA PNGs, 1024 x 1024, straight alpha, 191 GB
	GRAY_LEVEL 0.5	                 Background of rgb_on_gray as a fraction of white: rgb * alpha + GRAY_LEVEL * (1 - alpha)
	EVAL_MODULUS 4000	             An image is eval, never trained on, when sha256(page_id) mod EVAL_MODULUS is 0: about 35 images

	 Models
	TEACHER_MODEL Efficient-Large-Model/SANA_Sprint_1.6B_1024px_teacher_diffusers	 The model we fine-tune. Its vae subfolder (DC-AE f32c32) makes the latents, so they match the model

	 Database
	DATABASE_PORT 23947	 Far from the ports of the Bluejay demos on the laptop (19471, 19683, 19783)

database
	backend bluejay.local_database.LocalLanceBackend
	host 0.0.0.0
	port $DATABASE_PORT
	root lance

claims_table bluejay_claims
runs_table bluejay_runs
lineage_table bluejay_lineage
lineage true


 RULES FOR MAINTAINING THIS DTAB (copied from MulticamDailies' project.dtab, the house style):
 SEMANTIC BINDING: dtab-rules
    - One tab renders as four spaces. After each edit run: python3 agents/dtab_format.py check data/project.dtab (fix repairs the columns)
    - Formatting is part of the interface. Copy the alignment of nearby blocks exactly. Do not reformat what the user aligned by hand
    - These rules are for the AI. Keep the user's own prose in the user's voice: do not rewrite it
    - Everything is written in ASD-STE100
    - Sort tables and processors by dependency: an item comes after each item that it reads
    - Put the primary key first, then group the columns by the processor that writes them
    - Give each committed column a TYPE, a DESCRIPTION and an EXAMPLE
    - [Key] identifies a primary key. A tilde immediately before the type identifies a materialized field copied unchanged to the commit output,
      with no other use by the processor, including diagnostic logging.
    - Annotate each corresponding materialize and commit row that exists in the DTAB. Replace the space before the type with ~, as in [Key] ~str,
      without moving the columns. Preserve at least one space after the comment tab; widen the table if necessary. The marker is part of the comment, not the field name.
    - Delete a query that no processor or widget uses
    - Delete a processor file that this dtab does not use, in its own commit
    - Remove a note when it is resolved
    - Right-align values at their shared suffix, like numbers at the decimal point: ` 720p.mp4` under `1080p.mp4`
    - Lay out a big query's SELECT like view_dataset: one item per line, struct fields aligned
    - Write each query that is not tiny and simple as an annotated SQL query, like pending_latents, for a reader who does not speak SQL.
      An annotated SQL query has these properties in its FROM, JOIN and WHERE:
        - Break lines where the English breaks: each line is one short statement. Join lines that make one statement, like SELECT ... FROM
        - End each line with a tiny -- comment, so that the comments read down as one sentence
        - Align the comments one space after the longest line. Inside parentheses, indent the comment text 4 more, so the reader can skip it
        - Align the parts that nearby lines share, such as AND, IS, ON and =
    - Eval is not done here: the agent runs it itself (user, m00371). These tables only curate the training data


tables

	bluejay_claims
		 Bluejay requires this table
		primary_key claim_id
		index	claim_id btree
		columns
			claim_id, run_id, claim_status string

	bluejay_runs
		 Bluejay requires this table
		primary_key run_id
		columns
			run_id, run_status, started_at, finished_at, processor, metadata, dtab, query string
			exit_code int64
			log blob
			profiler blob

	bluejay_lineage
		 Bluejay requires this table, because lineage is true
		columns
			claim_id, table string
			key, materialized map_(string(), binary())
			committed list_(string())

	import_jobs
		 One seeded row makes import_index read magick_index.tsv exactly once
		primary_key job_id
		columns
			job_id string
			index_tsv blob
		initial_rows
			,	job_id magick

	magick_samples
		 One row per MAGICK image: 140,955 rows when the download is done
		primary_key page_id
		columns
			page_id string

			 Written by import_index, from magick_index.tsv
			subject, color, split, source_claim_id, source_run_id string
			sim_score float64
			nsfw, hand_picked bool

			 Written by download_image
			rgba blob

			 Written by split_alpha
			alpha, rgb_on_gray blob
			alpha_coverage, alpha_soft_fraction, green_spill float64

			 Written by encode_latents
			latent_alpha_1024, latent_rgb_1024 blob
			vae_psnr_1024 float64


processors

	import_index	 Downloads magick_index.tsv (16 MB) and adds one magick_samples row per image. No image yet
		query pending_import
		claim	import_claim import_jobs
		command bash
			uv run --script processors/import_index.py "$SAMPLE" $MAGICK_REPO $EVAL_MODULUS
		materialize
			input.json	            TYPE  DESCRIPTION         EXAMPLE
				job_id @	  [Key]  str   The one import job  "magick"
		commit
			import_jobs	               TYPE  DESCRIPTION                                                                  EXAMPLE
				index_tsv index.tsv	    blob  magick_index.tsv as downloaded: 148,193 rows, 7,238 of them repeat an image  16.1 MB .tsv
			magick_samples
				rows.parquet	                    TYPE   DESCRIPTION                                                                              EXAMPLE
					page_id @	              [Key]  str    MAGICK image ID, the PNG's file name                                                     "Hcx82jcUpM"
					subject @	                     str    The caption: a short subject phrase                                                      "red boiled crayfish on a plate ."
					color @	                         str    Screen color that MAGICK keyed out                                                       "green"
					sim_score @	                     float  Agreement of MAGICK's 3 alpha extractors (MS-SSIM). Low: maybe color spill               0.9879238
					nsfw @	                         bool   MAGICK's NSFW flag. 3,000 index rows                                                     false
					hand_picked @	                 bool   The index lists it as "hand". A repeated image is listed once as "hand", once as "auto"  true
					split @	                         str    "eval" when sha256(page_id) mod EVAL_MODULUS is 0, else "train"                          "train"
					source_claim_id $CLAIM	         str    Claim of the import run                                                                  "9f1c…"
					source_run_id $RUN	             str    The import run                                                                           "4b2e…"

	download_image	 Downloads each image's RGBA PNG from Hugging Face: images/<first 2 letters>/<page_id>.png
		query pending_download
		claim	download_claim magick_samples
		command bash
			uv run --script processors/download_image.py "$BATCH" $MAGICK_REPO
		materialize
			input.json	            TYPE  DESCRIPTION                           EXAMPLE
				page_id @	  [Key]  str   MAGICK image ID, the PNG's file name  "Hcx82jcUpM"
		commit
			magick_samples	       TYPE  DESCRIPTION                                                       EXAMPLE
				rgba rgba.png	    blob  The MAGICK image as downloaded: 1024 x 1024 RGBA, straight alpha  1.5 MB .png

	split_alpha	 Splits each RGBA PNG into its matte and its RGB composited on gray, and measures the matte
		query pending_split_alpha
		claim	split_alpha_claim magick_samples
		command bash
			uv run --script processors/split_alpha.py "$BATCH" $GRAY_LEVEL
		materialize	           TYPE  DESCRIPTION       EXAMPLE
			rgba.png rgba	    blob  The MAGICK image  1.5 MB .png
		commit
			magick_samples	                           TYPE   DESCRIPTION                                                          EXAMPLE
				alpha alpha.png	                        blob   The matte: 1024 x 1024 grayscale, 8 bit                              120 KB .png
				rgb_on_gray rgb_on_gray.png	            blob   rgb * alpha + GRAY_LEVEL * (1 - alpha): 1024 x 1024 RGB, 8 bit       1.4 MB .png
				result.json	                 SUBFIELD  TYPE   DESCRIPTION                                                          EXAMPLE
					alpha_coverage @	                float  Mean alpha: how much of the frame the object fills                   0.31
					alpha_soft_fraction @	            float  Fraction of pixels with 0 < alpha < 1: hair, glass, smoke            0.04
					green_spill @	                    float  Mean of max(0, g - max(r, b)) where alpha > 0.5. High: green fringe  0.006

	encode_latents	 Encodes each matte and each RGB-on-gray with the teacher's DC-AE, and measures the round trip
		query pending_latents
		claim	encode_latents_claim magick_samples
		command bash
			uv run --script processors/encode_latents.py "$BATCH" $TEACHER_MODEL
		materialize	                       TYPE  DESCRIPTION                                      EXAMPLE
			alpha.png alpha	                blob  The matte, copied to 3 channels before encoding  120 KB .png
			rgb_on_gray.png rgb_on_gray	    blob  The RGB on gray                                  1.4 MB .png
		commit
			magick_samples	                                           TYPE   DESCRIPTION                                                                                    EXAMPLE
				latent_alpha_1024 latent_alpha.safetensors	            blob   DC-AE latent of the matte: (32, 32, 32) bfloat16, key "latent"                                 64 KB .safetensors
				latent_rgb_1024 latent_rgb.safetensors	                blob   DC-AE latent of the RGB on gray: (32, 32, 32) bfloat16, key "latent"                           64 KB .safetensors
				result.json	                                 SUBFIELD  TYPE   DESCRIPTION                                                                                    EXAMPLE
					vae_psnr_1024 @	                                    float  PSNR in dB of the decoded RGB on gray against the original. Low: DC-AE cannot hold this image  31.2


queries
	 Convention: queries used only as processor queries are prefixed with pending_

	pending_import SELECT job_id FROM import_jobs WHERE import_claim IS NULL

	pending_download sql
		SELECT page_id FROM magick_samples           -- MAGICK images
		WHERE download_claim IS NULL                 -- not yet claimed,
		ORDER BY random() LIMIT $DOWNLOAD_BATCH_SIZE -- one batch at a time, in random order

	pending_split_alpha sql
		SELECT page_id, rgba FROM magick_samples  -- MAGICK images
		WHERE   split_alpha_claim IS NULL         -- not yet claimed,
		    AND rgba              IS NOT NULL     -- that download_image did,
		ORDER BY random() LIMIT $SPLIT_BATCH_SIZE -- one batch at a time, in random order

	pending_latents sql
		SELECT page_id, alpha, rgb_on_gray FROM magick_samples -- MAGICK images
		WHERE   encode_latents_claim IS NULL                   -- not yet claimed,
		    AND rgb_on_gray          IS NOT NULL               -- that split_alpha did,
		ORDER BY random() LIMIT $ENCODE_BATCH_SIZE             -- one batch at a time, in random order

	view_dataset sql
		SELECT
		    struct('image' AS widget,       alpha AS src, subject   AS caption) AS alpha,
		    struct('image' AS widget, rgb_on_gray AS src, 'on gray' AS caption) AS on_gray,
		    page_id,
		    subject,
		    split,
		    nsfw,
		    hand_picked,
		    sim_score,
		    green_spill,
		    alpha_coverage,
		    vae_psnr_1024
		FROM magick_samples           -- MAGICK images
		WHERE rgb_on_gray IS NOT NULL -- that split_alpha did,
		ORDER BY page_id              -- in a fixed order

sparrow
	saves sparrow_saves

albatross
	saves albatross_saves
