	h3_eval_generations
		 One row per H3 model and eval prompt: what the model makes from the prompt and its seed
		primary_key model_tag,prompt_id
		columns
			model_tag, prompt_id string

			 Written by h3_generate.py plan
			seed int64

			 Written by h3_generate.py work: long-lived per-GPU workers (started by run_proc_h3_eval.fish), committed with Bluejay's commit, not Bluejay runs
			 video: 141 frames, 24 fps, 512 x 512, H.264 CRF 12 MP4 (mode video). image: 512 x 512 PNG (mode image). seconds: generation time. gpu: its GPU
			video, image blob
			seconds float64
			gpu int64

			 Written by h3_generate.py work for a model with split_adapter: video / image above are its gray head; these are its white and black heads,
			 the alpha (gray, white = opaque) and RGBA of the three by iterative least squares (manifest §17), video_rgba over a checkerboard, image_rgba a straight-alpha PNG.
			 split_residual: the fit's mean RMS residual. split_x0_psnr: head 0 through the x0 path vs the pipeline's gray (dB, a check)
			video_white, video_black, video_alpha, video_rgba, image_white, image_black, image_alpha, image_rgba blob
			split_residual, split_x0_psnr float64

			 Written by h3_generate.py work for a grid2x2 model (split v3-grid, manifest §23): white / black = its panels, alpha = the 4th panel (the mask),
			 rgba = colour decontaminated with that alpha. alpha_ls = the least-squares alpha of the three background panels; grid_dalpha_* = |alpha − alpha_ls|
			 statistics over all pixels and over the edge band (0.02 < alpha < 0.98)
			video_alpha_ls, image_alpha_ls blob
			grid_dalpha_mean, grid_dalpha_median, grid_dalpha_p95, grid_dalpha_edge_mean, grid_dalpha_edge_median, grid_dalpha_edge_p95 float64

	h3_motion_clips
		 Alpha Video v2 (manifest §23 item 4): one synthetic moving cut-out per chosen MAGICK row (the first train rows by page_id + every val row).
		 The row's RGBA moves along a smooth random path (h3magic/synth_motion.py), 141 frames at 768 x 768, composited on 0.5 gray, white and black
		primary_key page_id
		columns
			page_id string

			 Written by h3_motion_clip (data/processors/h3_motion_clip.py): a long-lived per-GPU worker committed with Bluejay's commit, not a Bluejay run
			 The latents: {"latent": (24, 42, 48, 48) bfloat16}, H3 VAE video latents, normalized (h3magic/h3.py encode). The caption: h3_magick_images.h3_text_embed_v3
			h3_motion_gray_768, h3_motion_white_768, h3_motion_black_768 blob
			 The same clips, TILED encode (256-px tiles, manifest §25; h3_motion_clip's default since 2026-11-23 7 AM)
			h3_motion_gray_768t, h3_motion_white_768t, h3_motion_black_768t blob
			 Split v3-grid clips (h3_motion_clip grid): 39 frames of 2 x 2 panels of 384 (gray, white / black, alpha), tiled encode {"latent": (24, 12, 48, 48)},
			 and the row's grid caption + embedding copied from h3_magick_images (so train.py --data motion reads one table)
			h3_motion_grid_768t blob
			h3_caption_grid string
			h3_text_embed_grid blob
			h3_text_grid_sha256 string
			split string	 train or val, from h3_magick_images
			path_seed int64	 The path's seed with page_id (h3_motion_clip.path_of)
			scale_0, scale_1, center_x_0, center_y_0, center_x_1, center_y_1, angle_0, angle_1 float64

	h3_enc_samples
		 Is H3's encoder the bottleneck? (manifest §25, m00992): one row per held-out image or clip whose latent is optimized through the frozen H3 decoder
		primary_key sample_id
		columns
			sample_id string

			 Written by h3_enc_opt.py register (CPU, once). origin: pexels_val = a frame or clip of the 20 held-out clips of the decoder frenzy
			 (agents/.scratchpad/fastdec_h3/data/val_*.npz, the source of BASELINE.json); magick = a Latent Compositor test foreground over 50% gray; pexbg = its Pexels background
			kind, origin, pexels_id string	 kind: image (1 frame) or video (141 frames, 24 fps)
			side, frame int64	             frame: the clip frame of a pexels_val image
			source blob	                   The lossless PNG: the image, or frame 70 of a video
			source_frames blob	             video only: {"frames": (141, 512, 512, 3) uint8} safetensors, lossless (what the scores compare to)
			source_mp4 blob	               video only: H.264 CRF 12, to view

	h3_enc_runs
		 One row per kind of latent: the encoder baselines (encoder_sample = the pipeline's latent, encoder_mode, encoder_tiled) and each optimization run
		primary_key run_id
		columns
			run_id string

			 Written by h3_enc_opt.py images and video
			method string	             encoder_sample, encoder_mode, encoder_tiled, optimize (Adam on the latent from the posterior mode) or encoder_finetuned (h3_enc_train.py)
			objective, terms string	     terms: JSON {loss term: weight} of h3_enc_lib.OBJECTIVES, e.g. {"l1": 1.0, "lpips_vgg": 0.1}
			steps int64
			lr, prior_weight float64	 prior_weight: weight of mean(((z - mode) / std)^2), the encoder's posterior as a prior (0 = none); encoder_finetuned: the weight of mean((z - z_H3)^2)

			 Written by h3_enc_train.py train (method encoder_finetuned)
			checkpoint string	 The fine-tuned encoder: encoder.* and quant_conv.* weights, relative to the repo root
			train_log string	 JSON list of {step, loss, rec, rec_h3, reg, seconds}: rec_h3 = the same loss with H3's own encoder

	h3_enc_results
		 One row per run and sample: the decode of that latent by the frozen H3 decoder and its scores vs the source
		primary_key run_id,sample_id
		columns
			run_id, sample_id string

			 Written by h3_enc_opt.py images and video, and h3_enc_train.py evaluate: long-lived GPU workers committed with Bluejay's commit, not Bluejay runs
			 image: lossless PNG (kind image); video: H.264 CRF 12 MP4 + frames 0 / 70 / 140 as lossless PNGs (kind video); latent: {"latent": (24, T, LH, LW) float32} normalized
			 Scores vs the source (fastdec_ga/score.py's functions): psnr dB, ssim, lpips_alex, lpips_vgg, dists, de2000, flux_mse (FIBO2's FLUX.2 VAE latents),
			 sharp_grad, sharp_fft (decode / source), flicker (video). z_dev: mean |z - mode|; z_dev_std: the same in posterior std units
			image, video, frame_000, frame_070, frame_140, latent blob
			psnr, ssim, lpips_alex, lpips_vgg, dists, de2000, flux_mse, sharp_grad, sharp_fft, flicker, z_dev, z_dev_std, seconds float64
			curve string	 JSON list of {step, loss, psnr, lpips_alex, dists, z_dev} during the optimization
			gpu int64

			 Written by h3_enc_fmloss.py fmloss (runs fm_untiled, fm_tiled: the project's latent recipe, untiled or tiled): stock H3's flow-matching loss
			 on this latent (its caption, CFG off, fixed noise shared by both runs). fm_loss: the mean over FM_SIGMAS; fm_loss_by_sigma: JSON {sigma: loss}
			fm_loss float64
			fm_loss_by_sigma string

	h3_enc_stats
		 Per-channel statistics of a set of normalized H3 latents (manifest §25): do the project's latents match H3's latents_mean / latents_std?
		primary_key stat_id
		columns
			stat_id string

			 Written by h3_enc_fmloss.py stats (stored project latents) and fmloss (re-encodes of the same clips, untiled / tiled / other tile sizes)
			source, recipe string	  source: the table and column, or the clips; recipe: e.g. untiled sample, tiled 256 / 64
			count int64	              latents in the set
			channel_mean, channel_std list_(float64())	 24 values each: 0 and 1 = H3's own normalization


	 FASTDEC GA (manifest §22, m00998: every experiment goes through BlueJay). The genetic search for a fast replacement of the H3 VAE decoder.
	 Round 0 = everything done before the literature research (rounds 1-3 of the first search, and the lead's copies). Rounds 1-5 are the cited searches
	 A candidate is a model dir (model.py, ckpt.pt, genome.json). Run: fd_register, then fd_score and fd_render (GPU). View: view_fd_leaderboard

	fd_methods
		 One row per candidate decoder (and the two references: the original decode and the source). A new candidate is a new row with method_id, round and model_dir
		primary_key method_id
		columns
			method_id string

			 Written by the seed rows (initial_rows below) or by whoever adds a candidate
			round int64	 The search round. 0 = everything before the research
			model_dir string	 Folder of model.py, ckpt.pt, genome.json, relative to the repo root. Empty for the references
			status string	 Seed: "winner" (a tier winner of round 0) or "reference". Else fd_register writes "registered"

			 Written by fd_register, from MODEL_DIR/genome.json
			name, tier_target, kind string	 kind: mutation, crossover, wildcard, reference or source. tier_target: T10, T30, T100 or TQ, as the agent wrote it
			agent int64
			parents list_(string())	 The candidates or methods it descends from
			paper, paper_url string	 The paper or method cited, and its URL. Empty in round 0: it came before the literature research
			hypothesis, change string	 The idea in one sentence, and what exactly was changed
			params string	 JSON: n_params and the agent's own note on the checkpoint
			ckpt_path string	 The weights, relative to the repo root
			how_to_load string	 How to build the model and load the weights, as the agent wrote it
			genome_json string	 The whole genome card, as JSON text
			verdict string	 The agent's own verdict on the candidate
			created string	 When it was registered, ISO 8601 with the time zone
		initial_rows
			,	method_id original_full_decode	round 0	name original_full_decode	tier_target reference	kind reference	status reference	hypothesis The reference: the H3 VAE decoder (36-layer ViT), bf16 with tiling. Every speedup and every vs_full score is relative to it
			,	method_id source	round 0	name source	tier_target reference	kind source	status reference	hypothesis The source frames: the Pexels clip as cut for H3 (141 frames, 512 x 512), before any encode. Every vs_source score is relative to it
			,	method_id r1a1_w64b1t1q1k3e1h0	round 0	model_dir agents/.scratchpad/fastdec_ga/r1/agent_1
			,	method_id r1a2_C_teacher	round 0	model_dir agents/.scratchpad/fastdec_ga/r1/agent_2
			,	method_id r1a3_wide_halfres	round 0	model_dir agents/.scratchpad/fastdec_ga/r1/agent_3
			,	method_id r1a4_patch	round 0	model_dir agents/.scratchpad/fastdec_ga/r1/agent_4
			,	method_id r1a5_trunc_h3	round 0	model_dir agents/.scratchpad/fastdec_ga/r1/agent_5
			,	method_id r1a6_mix	round 0	model_dir agents/.scratchpad/fastdec_ga/r1/agent_6
			,	method_id r1a7_tq_refiner	round 0	model_dir agents/.scratchpad/fastdec_ga/r1/agent_7
			,	method_id r2a1_long_wide	round 0	model_dir agents/.scratchpad/fastdec_ga/r2/agent_1
			,	method_id r2a2_wide_anchor_cheaphead	round 0	model_dir agents/.scratchpad/fastdec_ga/r2/agent_2
			,	method_id r2a3_C_freeze300_long	round 0	model_dir agents/.scratchpad/fastdec_ga/r2/agent_3
			,	method_id r2a5_e1h0_skip16	round 0	model_dir agents/.scratchpad/fastdec_ga/r2/agent_5
			,	method_id r2a4_w64e1h0_long_extra	round 0	model_dir agents/.scratchpad/fastdec_ga/r2/agent_4/v_A
			,	method_id r2a4_v_B	round 0	model_dir agents/.scratchpad/fastdec_ga/r2/agent_4/v_B
			,	method_id r2a4_v_C	round 0	model_dir agents/.scratchpad/fastdec_ga/r2/agent_4/v_C
			,	method_id r2a6_lp05_antiblur	round 0	model_dir agents/.scratchpad/fastdec_ga/r2/agent_6/variants/lp05
			,	method_id r2a7_trunc_h3_k4	round 0	model_dir agents/.scratchpad/fastdec_ga/r2/agent_7/k4
			,	method_id r2a7_trunc_h3_k2	round 0	model_dir agents/.scratchpad/fastdec_ga/r2/agent_7/k2
			,	method_id lead_a1_wide	round 0	model_dir agents/.scratchpad/fastdec_ga/lead/lead_a1_wide
			,	method_id lead_a2_anchor	round 0	model_dir agents/.scratchpad/fastdec_ga/lead/lead_a2_anchor
			,	method_id lead_a3_seed	round 0	model_dir agents/.scratchpad/fastdec_ga/lead/lead_a3_seed	status winner
			,	method_id lead_a5_skip16	round 0	model_dir agents/.scratchpad/fastdec_ga/lead/lead_a5_skip16	status winner
			,	method_id lead_a7_k4	round 0	model_dir agents/.scratchpad/fastdec_ga/lead/lead_a7_k4	status winner
			,	method_id r3a2_fullh3_ft	round 0	model_dir agents/.scratchpad/fastdec_ga/r3/agent_2
			,	method_id r3a4_antiblur_finetune	round 0	model_dir agents/.scratchpad/fastdec_ga/r3/agent_4
			,	method_id r3a5_skip16_wide96_head2	round 0	model_dir agents/.scratchpad/fastdec_ga/r3/agent_5
			,	method_id r3a6_deep_lean	round 0	model_dir agents/.scratchpad/fastdec_ga/r3/agent_6

	fd_scores
		 One row per method and evaluation: the speed and the quality of one candidate on one set of clips
		primary_key method_id,eval_id
		columns
			method_id, eval_id string	 eval_id: val20_stride<N> = the 20 held-out clips with SSIM and LPIPS on every Nth frame (score.py); genome_card = the numbers on the agent's own card
			 Written by fd_score
			ms_clean float64	 The decode time of one latent (141 frames), ms, from the coordinator's clean timing. Empty when it was never timed clean
			ms_note string	 Where the time comes from. A scorer time on a shared GPU is named here and never put into ms_clean
			speedup float64	 The full decode's ms divided by ms_clean
			tier string	 T100 (speedup >= 100), T30, T10, slow, untimed or reference
			ssim_vs_full, lpips_vs_full, psnr_vs_full float64	 Against the full H3 decode, mean over the clips. LPIPS is alex; lower is better
			ssim_vs_source, lpips_vs_source, psnr_vs_source float64	 Against the source frames
			de2000 float64	 CIEDE2000 against the source
			flicker, flicker_vs_source float64	 The gap between the candidate's mean temporal difference and the full decode's (flicker) or the source's (flicker_vs_source). Lower is better
			sharp_grad, sharp_fft float64	 Sobel gradient and high-frequency energy of the candidate over the source's. 1 = as sharp as the source
			steps int64	 Training steps, when known

	fd_renders
		 One row per method and held-out clip: the candidate's decode of the clip as a video
		primary_key method_id,clip_id
		columns
			method_id, clip_id string	 clip_id = the Pexels id
			 Written by fd_render (the 20 val clips) or fd_import_mp4 (the journal page's 6 clips, round 0)
			mp4 blob	 141 frames, 24 fps, 512 x 512, H.264 CRF 12, no audio
			n_frames int64
			fps float64
			psnr_vs_full, ssim_vs_full, lpips_vs_full float64	 Of this clip against the full decode (SSIM and LPIPS on every 4th frame)

	 LATENT COMPOSITOR (manifest §24, m00998: every experiment goes through BlueJay). A small network in H3 latent space: the latents of a matte,
	 a foreground and a background in, the latent of their composite out. Its files stay in LC_DIR: lc_find finds them, lc_import_shard and
	 lc_import_renders import them. Run: fish data/run_proc_latentcomp.fish. View: view_lc_methods, view_lc_compare, view_lc_renders, view_lc_samples

	lc_jobs
		 One seeded row. lc_find scans LC_DIR once per Claim: run_proc_latentcomp.fish unclaims it before each run, so new candidates are found
		primary_key job_id
		columns
			job_id string
		initial_rows
			,	job_id find

	lc_shards
		 One row per dataset shard of LC_DIR/data: <split>_<k>.safetensors (latents), <split>_<k>_pixels.safetensors and <split>_<k>.json, 100 samples
		primary_key shard
		columns
			shard string

			 Written by lc_find
			split string
			files_stamp string	 size:mtime_ns of the 3 files. When it is not imported_stamp, run_proc_latentcomp.fish unclaims the shard and lc_import_shard imports it again

			 Written by lc_import_shard
			imported_stamp string
			samples int64

	lc_samples
		 One row per Latent Compositor sample: 300 test (the curated test set, LC_DIR/data/test_plan.json) and 8,000 train.
		 Train rows hold only metadata and latents. Their pixels stay in the shards (LC_DIR/data/train_<k>_pixels.safetensors, 734 MB per 100 samples)
		primary_key sample_id
		columns
			sample_id string

			 Written by lc_import_shard
			split, subset, page_id, pexels_id, shard string
			position int64	 The place in its split. For a test sample, the key of its scores in results.json's per_sample (0..299)
			rating int64	 Test only: the Sonnet swarm's rating of how tricky the matte is to composite, 1-5
			tags string	 Test only: JSON list of the swarm's tags
			placement, background string	 JSON: the foreground's scale, x, y and flip; the background frame's time t (s) and flip
			alpha_mean float64
			latents blob	 safetensors {"latents": (6, 24, 64, 64) float16}: normalized H3 posterior modes in LC_DIR/lc.py KEYS order
			 Test only: lossless 1024 x 1024 PNGs of the matte (gray), the straight RGBA foreground, the background, the true composite,
			 and the oracle (the H3 decode of the true composite's latent: the ceiling of every candidate)
			alpha_png, fg_rgba_png, bg_png, comp_png, oracle_png blob

	lc_methods
		 One row per scored candidate: a folder LC_DIR/r<k>/<name>/ with results.json (LC_DIR/evaluate.py). Image metrics are means over EVAL:
		 96 test samples, the hardest 48 hard_soft, 24 hard_contrast and 24 random
		primary_key method_id
		columns
			method_id string

			 Written by lc_find, from the candidate's genome.json, results.json and cost_clean.json (a clean re-timing: used before the time in results.json)
			name, what, how, fg_key, verdict string	 fg_key: the foreground latent it takes (fg_straight, fg_premult or fg_gray)
			parents, cites string	 JSON lists, from genome.json
			track string	 From the measured cost: L (<= 10 ms forward + backward, <= 5 M params), H (<= 100 ms, <= 50 M), none, or ref (no cost: not a module)
			wildcard bool
			round, params int64
			ms_fwd, ms_fwdbwd float64	 fp32, batch 1, one 1024 x 1024 sample on an A100: the forward, and the forward + backward to the inputs
			psnr, psnr_hard_soft, psnr_hard_contrast, psnr_random, ssim, lpips, flux2_mse float64	 The decoded composite against the true composite. psnr (dB) is the fitness
			latent_mse float64	 Against the true composite's latent, all 300 test samples
			oracle_psnr float64	 The decode of the true latent: the ceiling
			folder string	 The candidate folder, relative to the repo root
			results_sha256 string	 sha256 (hex) of results.json. When it is not renders_sha256, run_proc_latentcomp.fish unclaims the candidate and lc_import_renders imports it again

			 Written by lc_import_renders
			renders_sha256 string
			renders int64

	lc_renders
		 One row per scored candidate and decoded test sample (each EVAL sample; all 300 for a finalist): the decoded composite, its error map, its scores
		primary_key render_id
		columns
			render_id, method_id, sample_id string	 render_id = method_id|sample_id

			 Written by lc_import_renders
			decoded_png blob	 Byte for byte the candidate's decoded/<index>.png (or showcase/<index>.png): the H3 decode (bf16) of its predicted latent
			error_png blob	 |decoded - true composite| x 4 per channel
			psnr, ssim, lpips, flux2_mse float64	 From results.json's per_sample
			latent_mse float64	 pred.safetensors (fp16) against the true composite's latent

	 DIFFDEC (manifest §26, m01001, m00998: every experiment goes through BlueJay). Sampling decoders (diffusion / flow) conditioned on the frozen
	 H3 latent, against H3's own decoder. Their files stay in DD_DIR (DD_DIR/CONTRACT.md has the formats): dd_find finds them, dd_import_samples
	 and dd_import_renders import them. Run: fish data/run_proc_diffdec.fish. View: view_dd_methods, view_dd_compare, view_dd_renders, view_dd_samples

	dd_jobs
		 One seeded row. dd_find scans DD_DIR once per Claim, and dd_import_samples imports the test set once per Claim: run_proc_diffdec.fish
		 unclaims dd_find before each run, and dd_import_samples when the test set is complete and not imported (its stamp is not imported_samples_stamp)
		primary_key job_id
		columns
			job_id string

			 Written by dd_find
			samples_stamp string	 sha256 of DD_DIR/data/test/samples.json when every test sample has its 3 files, else null (nothing to import yet)

			 Written by dd_import_samples
			imported_samples_stamp string	 The samples_stamp that it imported
		initial_rows
			,	job_id find

	dd_samples
		 One row per test sample of DD_DIR/data/test (manifest §26: 20 pexels_val, 8 magick, 8 pexbg, 32 pexels_spare; 512 x 512 only in round 1).
		 Every file is byte for byte the file of DD_DIR/data/test/<sample_id>/
		primary_key sample_id
		columns
			sample_id string

			 Written by dd_import_samples, from samples.json
			origin, side, pexels_id, page_id, source_table string	 origin: pexels_val, magick, pexbg or pexels_spare. pexels_id or page_id is null for the other source
			has_upper_bound bool	 The sample has an h3_enc_results row of run img_l1vgg: optimized_l1vgg scores it (12 samples)
			source_png blob	 source.png: lossless 512 x 512 RGB, the truth that every score compares to
			latent blob	 latent.safetensors: {"sample", "mode", "std"}, each (24, 1, 32, 32) float32: the normalized H3 posterior
			flux2 blob	 flux2.safetensors: {"latent": (32, 64, 64) float32}: the FIBO2-normalized FLUX.2 latent of source.png

	dd_methods
		 One row per candidate folder DD_DIR/g<round>/<name>/ with a genome.json. A candidate that has no results.json yet is still training:
		 status "training", only its genome. When results.json appears (DD_DIR/dd_eval.py), dd_find fills the scores and sets status "scored"
		primary_key method_id
		columns
			method_id string

			 Written by dd_find, from genome.json (the child writes it before training)
			name, agent, kind, parents, paper, paper_url, idea, why_win, ablation_of, ablation_change string	 kind: reference, baseline, child, wildcard or ablation. parents: JSON list of method_ids
			space, conditioning, how_to_load, verdict, why_held_or_failed, train_gpu_type string	 space: rgb, flux2, h3dec ... conditioning: concat, adagn, crossattn ... train_gpu_type: genome.json's gpu_type
			round int64	 The round of the folder name g<round>
			text_cond bool
			steps, params int64	 steps: sampling steps at eval
			train_gpu_hours float64

			 Written by dd_find, from results.json. Means over the test samples, the latent kind in latent_kind
			status string	 "training" (no results.json yet) or "scored"
			psnr, ssim, lpips_alex, lpips_vgg, dists, de2000, flux_mse, sharp_grad, sharp_fft float64	 Of the seed 0 render against the source. psnr: dB. de2000: CIEDE2000
			psnr_mean8, dists_mean8 float64	 Of the mean of 8 seeds (deterministic decoders: same as seed 0)
			ms_per_image float64
			gpu_type, latent_kind string	 gpu_type: of the eval. latent_kind: "sample" (the pipeline's latent) or "mode"
			eval_steps, n_samples int64
			folder string	 The candidate folder, relative to the repo root
			results_sha256 string	 sha256 (hex) of results.json. When it is not renders_sha256, run_proc_diffdec.fish unclaims the candidate and dd_import_renders imports it again

			 Written by dd_import_renders
			renders_sha256 string
			renders int64

	dd_renders
		 One row per scored candidate and test sample: the render (seed 0), the mean of 8 seeds, an error map, the scores
		primary_key render_id
		columns
			render_id, method_id, sample_id string	 render_id = method_id|sample_id

			 Written by dd_import_renders
			render_png blob	 Byte for byte the candidate's renders/<sample_id>.png (seed 0)
			mean8_png blob	 Byte for byte renders_mean8/<sample_id>.png, null when the candidate has none
			error_png blob	 |render - source| x 4 per channel
			psnr, ssim, lpips_alex, lpips_vgg, dists, de2000, flux_mse, sharp_grad, sharp_fft, psnr_mean8, dists_mean8 float64	 From results.json's per_sample

processors

	import_index	 Downloads magick_index.tsv (16 MB) and adds one magick_samples row per image. No image yet
		query SELECT job_id FROM import_jobs WHERE import_claim IS NULL
		claim	import_claim import_jobs
		command bash
			uv run --script processors/import_index.py "$SAMPLE" $MAGICK_REPO $EVAL_MODULUS
		materialize
			input.json	            TYPE  DESCRIPTION         EXAMPLE
				job_id @	  [Key]  str   The one import job  "magick"
		commit
			import_jobs	               TYPE  DESCRIPTION                                                                  EXAMPLE
				index_tsv index.tsv	    blob  magick_index.tsv as downloaded: 148,193 rows, 7,238 of them repeat an image  16.1 MB .tsv
			magick_samples
				rows.parquet	                    TYPE   DESCRIPTION                                                                              EXAMPLE
					page_id @	              [Key]  str    MAGICK image ID, the PNG's file name                                                     "Hcx82jcUpM"
					subject @	                     str    The caption: a short subject phrase                                                      "red boiled crayfish on a plate ."
					color @	                         str    Screen color that MAGICK keyed out                                                       "green"
					sim_score @	                     float  Agreement of MAGICK's 3 alpha extractors (MS-SSIM). Low: maybe color spill               0.9879238
					nsfw @	                         bool   MAGICK's NSFW flag. 3,000 index rows                                                     false
					hand_picked @	                 bool   The index lists it as "hand". A repeated image is listed once as "hand", once as "auto"  true
					split @	                         str    "eval" when sha256(page_id) mod EVAL_MODULUS is 0, else "train"                          "train"
					source_claim_id $CLAIM	         str    Claim of the import run                                                                  "9f1c…"
					source_run_id $RUN	             str    The import run                                                                           "4b2e…"

	download_image	 Downloads each image's RGBA PNG from Hugging Face: images/<first 2 letters>/<page_id>.png
		query sql
			SELECT page_id FROM magick_samples           -- MAGICK images
			WHERE download_claim IS NULL                 -- not yet claimed,
			ORDER BY random() LIMIT $DOWNLOAD_BATCH_SIZE -- one batch at a time, in random order
		claim	download_claim magick_samples
		command bash
			uv run --script processors/download_image.py "$BATCH" $MAGICK_REPO
		materialize
			input.json	            TYPE  DESCRIPTION                           EXAMPLE
				page_id @	  [Key]  str   MAGICK image ID, the PNG's file name  "Hcx82jcUpM"
		commit
			magick_samples	       TYPE  DESCRIPTION                                                       EXAMPLE
				rgba rgba.png	    blob  The MAGICK image as downloaded: 1024 x 1024 RGBA, straight alpha  1.5 MB .png

	split_alpha	 Splits each RGBA PNG into its matte and its RGB composited on gray, and measures the matte
		query sql
			SELECT page_id, rgba FROM magick_samples  -- MAGICK images
			WHERE   split_alpha_claim IS NULL         -- not yet claimed,
			    AND rgba              IS NOT NULL     -- that download_image did,
			ORDER BY random() LIMIT $SPLIT_BATCH_SIZE -- one batch at a time, in random order
		claim	split_alpha_claim magick_samples
		command bash
			uv run --script processors/split_alpha.py "$BATCH" $GRAY_LEVEL
		materialize	           TYPE  DESCRIPTION       EXAMPLE
			rgba.png rgba	    blob  The MAGICK image  1.5 MB .png
		commit
			magick_samples	                           TYPE   DESCRIPTION                                                          EXAMPLE
				alpha alpha.png	                        blob   The matte: 1024 x 1024 grayscale, 8 bit                              120 KB .png
				rgb_on_gray rgb_on_gray.png	            blob   rgb * alpha + GRAY_LEVEL * (1 - alpha): 1024 x 1024 RGB, 8 bit       1.4 MB .png
				result.json	                 SUBFIELD  TYPE   DESCRIPTION                                                          EXAMPLE
					alpha_coverage @	                float  Mean alpha: how much of the frame the object fills                   0.31
					alpha_soft_fraction @	            float  Fraction of pixels with 0 < alpha < 1: hair, glass, smoke            0.04
					green_spill @	                    float  Mean of max(0, g - max(r, b)) where alpha > 0.5. High: green fringe  0.006

	encode_latents	 Encodes each matte and each RGB-on-gray with the teacher's DC-AE, and measures the round trip
		query sql
			SELECT page_id, alpha, rgb_on_gray FROM magick_samples -- MAGICK images
			WHERE   encode_latents_claim IS NULL                   -- not yet claimed,
			    AND rgb_on_gray          IS NOT NULL               -- that split_alpha did,
			ORDER BY random() LIMIT $ENCODE_BATCH_SIZE             -- one batch at a time, in random order
		claim	encode_latents_claim magick_samples
		command bash
			uv run --script processors/encode_latents.py "$BATCH" $TEACHER_DIR
		materialize	                       TYPE  DESCRIPTION                                      EXAMPLE
			alpha.png alpha	                blob  The matte, copied to 3 channels before encoding  120 KB .png
			rgb_on_gray.png rgb_on_gray	    blob  The RGB on gray                                  1.4 MB .png
		commit
			magick_samples	                                           TYPE   DESCRIPTION                                                                                    EXAMPLE
				latent_alpha_1024 latent_alpha.safetensors	            blob   DC-AE latent of the matte: (32, 32, 32) bfloat16, key "latent", unscaled                       64 KB .safetensors
				latent_rgb_1024 latent_rgb.safetensors	                blob   DC-AE latent of the RGB on gray: (32, 32, 32) bfloat16, key "latent", unscaled                 64 KB .safetensors
				result.json	                                 SUBFIELD  TYPE   DESCRIPTION                                                                                    EXAMPLE
					vae_psnr_1024 @	                                    float  PSNR in dB of the decoded RGB on gray against the original. Low: DC-AE cannot hold this image  31.2

	encode_colorbg	 Composites each RGBA PNG on its own random solid color and encodes it with the teacher's DC-AE. For adapter_v2
		 The adapter learns MAGICK's look but no one background color. So the control model must learn the gray, and W_base - W_adapter keeps it
		query sql
			SELECT page_id, rgba FROM magick_samples    -- MAGICK images
			WHERE   encode_colorbg_claim IS NULL        -- not yet claimed,
			    AND rgb_on_gray          IS NOT NULL    -- that split_alpha did (it fails RGB-only PNGs),
			ORDER BY random() LIMIT $COLORBG_BATCH_SIZE -- one batch at a time, in random order
		claim	encode_colorbg_claim magick_samples
		command bash
			uv run --script processors/encode_colorbg.py "$BATCH" $TEACHER_DIR
		materialize	           TYPE  DESCRIPTION       EXAMPLE
			rgba.png rgba	    blob  The MAGICK image  1.5 MB .png
			input.json	            TYPE  DESCRIPTION                           EXAMPLE
				page_id @	  [Key]  str   MAGICK image ID: it seeds bg_color    "Hcx82jcUpM"
		commit
			magick_samples	                                                    TYPE   DESCRIPTION                                                                              EXAMPLE
				latent_rgb_colorbg_1024 latent_rgb_colorbg.safetensors	         blob   DC-AE latent of rgb * alpha + bg_color * (1 - alpha): like latent_rgb_1024               64 KB .safetensors
				result.json	                                          SUBFIELD  TYPE   DESCRIPTION                                                                              EXAMPLE
					bg_color @	                                                 list   Background RGB, uniform in [0, 1), seeded by the first 8 bytes of sha256(page_id)        [0.628, 0.306, 0.224]

	plan_eval	 Adds one eval_generations row per eval image for each new eval_models row. No GPU
		query SELECT model_tag, coalesce(eval_set, '$EVAL_SET') AS eval_set FROM eval_models WHERE plan_eval_claim IS NULL
		claim	plan_eval_claim eval_models
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src uv run --project .. python processors/generate_eval.py plan "$SAMPLE"
		materialize
			input.json	            TYPE DESCRIPTION            EXAMPLE
				model_tag @	  [Key]  str  The model to evaluate  "sprint_gray"
				eval_set @	         str  Its eval set folder    "resources/eval"
		commit
			eval_generations
				rows.jsonl	                        TYPE DESCRIPTION                                               EXAMPLE
					model_tag @	              [Key]  str  The model to evaluate                                     "sprint_gray"
					page_id @	              [Key]  str  An item of eval_set                                       "6NqAw3m1ss"
					noise_seed @	          [Key]  int  Seed of the fixed noise in eval_set                       20261117
					caption @	                     str  The image's MAGICK caption                                "red apple on a solid"
					noise_index @	                 int  Row of the image's latents in eval_set/noise.safetensors  10
					source_claim_id $CLAIM	         str  Claim of the plan run                                     "9f1c…"
					source_run_id $RUN	             str  The plan run                                              "4b2e…"

	generate_eval	 Generates each eval_generations image with its model, on this GPU's server, which keeps the model loaded
		query sql
			SELECT g.model_tag, g.page_id, g.noise_seed, g.caption, g.noise_index,  -- eval images
			       m.pipeline, m.checkpoint, m.steps, m.guidance, m.prompt_variant, -- with their model's settings
			       coalesce(m.eval_set, '$EVAL_SET') AS eval_set                   -- and eval set
			FROM eval_generations g                                                -- from the planned rows,
			JOIN eval_models m ON m.model_tag = g.model_tag                        -- joined to their model,
			WHERE g.generate_eval_claim IS NULL                                    -- not yet claimed,
			  AND g.model_tag LIKE '$EVAL_ONLY'                                    -- of the selected models,
			ORDER BY CASE right(g.model_tag, 5)                                    -- by resolution: 1024 (no _r suffix) first,
			         WHEN '_r768' THEN 1 WHEN '_r512' THEN 2                       -- then 768, 512,
			         WHEN '_r256' THEN 3 ELSE 0 END,                               -- then 256 (all of one size before the next),
			         g.model_tag, random() LIMIT $EVAL_BATCH_SIZE                  -- one model at a time, in random order
		claim	generate_eval_claim eval_generations
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src uv run --project .. python processors/generate_eval.py batch "$BATCH"
		materialize
			input.json	                    TYPE   DESCRIPTION                                                       EXAMPLE
				model_tag @	          [Key]  str    The model                                                         "sprint_gray"
				page_id @	          [Key]  str    The eval image                                                    "6NqAw3m1ss"
				noise_seed @	      [Key]  int    Seed of the fixed noise                                           20261117
				caption @	                 str    The MAGICK caption                                                "red apple on a solid"
				noise_index @	             int    Row of the latents in eval_set/noise.safetensors                  10
				pipeline @	                 str    "teacher", "sprint", "fibo2" or "fibo2turbo" (control on turbo)   "sprint"
				checkpoint @	             str    "stock", or a repo path: see models.load_eval_pipeline            "stock"
				steps @	                     int    Sampling steps                                                    2
				guidance @	                 float  CFG for the teacher, embedded guidance for Sprint                 4.5
				prompt_variant @	         str    "plain", "gray" (+ gray words) or "detailed" (prompts_detailed)   "gray"
				eval_set @	                 str    Eval set folder: captions, mattes and fixed noise                 "resources/eval"
		commit
			eval_generations	                    TYPE   DESCRIPTION                                                   EXAMPLE
				image image.png	                     blob   The generated image: 1024 x 1024 RGB, 8 bit                   1.5 MB .png
				result.json	               SUBFIELD TYPE   DESCRIPTION                                                   EXAMPLE
					prompt @	                     str    The prompt given to the model                                 "red apple on a solid, on a plain 50% gray background"
					call_kwargs @	                 str    JSON of the pipeline call settings                            "{\"num_inference_steps\": 2, ...}"
					step_noise_seed @	             int    Seed of the noise that the Sprint sampler adds between steps  787
					seconds @	                     float  GPU time per image: batch time / batch size                   0.27
					exterior_gray_error @	         float  Mean |rgb - 0.5| where the matte is 0. Low: clean gray        0.17
					border_gray_error @	             float  Mean |rgb - 0.5| in the 64 px edge band                       0.18
					border_std @	                 float  Standard deviation in the 64 px edge band. 0: flat            0.10
					iou @	                         float  IoU of the pixels far from 0.5 gray with the matte            0.39
					foreground_fraction @	         float  Fraction of the pixels far from 0.5 gray                      0.92

	trimask_morph_band, trimask_noisy_band, trimask_blur_quantize, trimask_scribbles, trimask_bbox_unknown, trimask_convex_hull,
	trimask_grid_coarsen, trimask_polygon_simplify, trimask_unknown_patches, trimask_fuzzy_ramp, trimask_combo_union, trimask_combo_chain,
	trimask_skeleton_strokes, trimask_partial_view, trimask_bilateral_blur, trimask_random_stack, trimask_perlin_warp, trimask_op_chain,
	trimask_glass_ripple, trimask_original, trimask_threshold
		 Each makes the trimasks of its method (src/sana_alpha/trimask/<method>.py) for its train images. This block holds what the twenty-one share:
		 the matte in, one trimask_augmentations row per variant out. Each one's own query, Claim pointer and command follow it
		materialize	               TYPE  DESCRIPTION                            EXAMPLE
			alpha.png alpha	        blob  The matte                              120 KB .png
			input.json	           TYPE  DESCRIPTION                            EXAMPLE
				page_id @	 [Key]  str   MAGICK image ID: it seeds the trimask  "Hcx82jcUpM"
				split @	           ~str   Always train                           "train"
		commit
			trimask_augmentations
				children/	                       TYPE   DESCRIPTION                                                                       EXAMPLE
					trimask trimask.png	            blob   The trimask: 1024 x 1024 grayscale, 8 bit. 255 object, 0 background, 128 unknown  20 KB .png
					fields.json	         SUBFIELD  TYPE   DESCRIPTION                                                                       EXAMPLE
						page_id @	         [Key]  str    The image                                                                         "Hcx82jcUpM"
						method @	         [Key]  str    The method tag                                                                    "morph_band"
						variant @	         [Key]  int    0 to TRIMASK_VARIANTS - 1: it seeds the trimask too                               0
						split @	                   ~str    Always train                                                                      "train"
						params @	                str    JSON of the hyperparameters used                                                  "{...}"
						white_fraction @	        float  Fraction of pixels 255: surely object                                             0.25
						gray_fraction @	            float  Fraction of pixels not 0 or 255: unknown                                          0.10
						black_fraction @	        float  Fraction of pixels 0: surely background                                           0.65

	trimask_morph_band
		query sql
			SELECT page_id, alpha, split FROM magick_samples                                                    -- MAGICK images
			WHERE   trimask_morph_band_claim IS NULL                                                            -- not yet claimed,
			    AND alpha                    IS NOT NULL                                                        -- that split_alpha did,
			    AND split                    = 'train'                                                          -- not eval,
			    AND page_id NOT IN (SELECT page_id FROM _no_trimask_items)                                      -- not a showcase image or an empty matte,
			    AND (contains('$TRIMASK_SUBSET', left(encode(sha256(concat(page_id, 'morph_band')), 'hex'), 1)) -- in this method's subset (TRIMASK_SUBSET)
			         OR left(encode(sha256(page_id), 'hex'), 3) <= '$TRIMASK_COMPARE_MAX')                      -- or in the comparison set,
			ORDER BY random() LIMIT $TRIMASK_BATCH_SIZE                                                         -- one batch at a time, in random order
		claim	trimask_morph_band_claim magick_samples
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src OMP_NUM_THREADS=1 uv run --project .. python processors/trimask_augment.py "$BATCH" morph_band $TRIMASK_VARIANTS $TRIMASK_SUBSET $TRIMASK_COMPARE_MAX

	trimask_noisy_band
		query sql
			SELECT page_id, alpha, split FROM magick_samples                                                    -- MAGICK images
			WHERE   trimask_noisy_band_claim IS NULL                                                            -- not yet claimed,
			    AND alpha                    IS NOT NULL                                                        -- that split_alpha did,
			    AND split                    = 'train'                                                          -- not eval,
			    AND page_id NOT IN (SELECT page_id FROM _no_trimask_items)                                      -- not a showcase image or an empty matte,
			    AND (contains('$TRIMASK_SUBSET', left(encode(sha256(concat(page_id, 'noisy_band')), 'hex'), 1)) -- in this method's subset (TRIMASK_SUBSET)
			         OR left(encode(sha256(page_id), 'hex'), 3) <= '$TRIMASK_COMPARE_MAX')                      -- or in the comparison set,
			ORDER BY random() LIMIT $TRIMASK_BATCH_SIZE                                                         -- one batch at a time, in random order
		claim	trimask_noisy_band_claim magick_samples
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src OMP_NUM_THREADS=1 uv run --project .. python processors/trimask_augment.py "$BATCH" noisy_band $TRIMASK_VARIANTS $TRIMASK_SUBSET $TRIMASK_COMPARE_MAX

	trimask_blur_quantize
		query sql
			SELECT page_id, alpha, split FROM magick_samples                                                       -- MAGICK images
			WHERE   trimask_blur_quantize_claim IS NULL                                                            -- not yet claimed,
			    AND alpha                       IS NOT NULL                                                        -- that split_alpha did,
			    AND split                       = 'train'                                                          -- not eval,
			    AND page_id NOT IN (SELECT page_id FROM _no_trimask_items)                                         -- not a showcase image or an empty matte,
			    AND (contains('$TRIMASK_SUBSET', left(encode(sha256(concat(page_id, 'blur_quantize')), 'hex'), 1)) -- in this method's subset (TRIMASK_SUBSET)
			         OR left(encode(sha256(page_id), 'hex'), 3) <= '$TRIMASK_COMPARE_MAX')                         -- or in the comparison set,
			ORDER BY random() LIMIT $TRIMASK_BATCH_SIZE                                                            -- one batch at a time, in random order
		claim	trimask_blur_quantize_claim magick_samples
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src OMP_NUM_THREADS=1 uv run --project .. python processors/trimask_augment.py "$BATCH" blur_quantize $TRIMASK_VARIANTS $TRIMASK_SUBSET $TRIMASK_COMPARE_MAX

	trimask_scribbles
		query sql
			SELECT page_id, alpha, split FROM magick_samples                                                   -- MAGICK images
			WHERE   trimask_scribbles_claim IS NULL                                                            -- not yet claimed,
			    AND alpha                   IS NOT NULL                                                        -- that split_alpha did,
			    AND split                   = 'train'                                                          -- not eval,
			    AND page_id NOT IN (SELECT page_id FROM _no_trimask_items)                                     -- not a showcase image or an empty matte,
			    AND (contains('$TRIMASK_SUBSET', left(encode(sha256(concat(page_id, 'scribbles')), 'hex'), 1)) -- in this method's subset (TRIMASK_SUBSET)
			         OR left(encode(sha256(page_id), 'hex'), 3) <= '$TRIMASK_COMPARE_MAX')                     -- or in the comparison set,
			ORDER BY random() LIMIT $TRIMASK_BATCH_SIZE                                                        -- one batch at a time, in random order
		claim	trimask_scribbles_claim magick_samples
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src OMP_NUM_THREADS=1 uv run --project .. python processors/trimask_augment.py "$BATCH" scribbles $TRIMASK_VARIANTS $TRIMASK_SUBSET $TRIMASK_COMPARE_MAX

