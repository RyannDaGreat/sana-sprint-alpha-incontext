			input.json	           TYPE  DESCRIPTION        EXAMPLE
				job_id @	 [Key]  str   The one find job   "find"
		commit
			lc_shards
				shards.parquet	     TYPE  DESCRIPTION                    EXAMPLE
					shard @	   [Key]  str   <split>_<k>                    "train_017"
					split @	          str   "test" or "train"              "train"
					files_stamp @	  str   size:mtime_ns of its 3 files   "117964960:1763899...,734003456:...,44839:..."
			lc_methods
				methods.parquet	             TYPE    DESCRIPTION                                         EXAMPLE
					method_id @	       [Key]  str     r<k>/<folder name>                                  "r0/lsq_gray_k3"
					round @	                  int     The genetic frenzy round. 0 = the baselines         0
					name @	                  str     genome.json name, else the folder name              "lsq_gray_k3"
					parents @	              str     JSON list of parent method_ids                      "[]"
					what @	                  str     The method in one line                              "ridge regression over 3x3 cells ..."
					how @	                  str     How it was fit or trained                           "closed form on 2000 train samples"
					cites @	                  str     JSON list: the papers or repos it took ideas from   "[\"DecFormer ...\"]"
					fg_key @	              str     fg_straight, fg_premult or fg_gray                  "fg_gray"
					track @	                  str     L, H, none or ref, from the measured cost           "L"
					wildcard @	              bool    A wildcard child of its round                       false
					params @	              int     Parameters                                          13824
					ms_fwd @	              float   Forward ms                                          0.41
					ms_fwdbwd @	              float   Forward + backward ms                               1.32
					psnr @	                  float   Fitness: decoded PSNR on EVAL, dB                   29.84
					psnr_hard_soft @	      float   On the hard_soft samples of EVAL                    27.10
					psnr_hard_contrast @	  float   On the hard_contrast samples of EVAL                28.32
					psnr_random @	          float   On the random samples of EVAL                       33.90
					ssim @	                  float   SSIM on EVAL                                        0.912
					lpips @	                  float   LPIPS (alex) on EVAL                                0.061
					flux2_mse @	              float   FLUX.2 VAE latent MSE on EVAL                       0.0123
					latent_mse @	          float   Latent MSE, all 300 test samples                    0.0310
					oracle_psnr @	          float   Decoded PSNR of the true latent on EVAL             32.71
					verdict @	              str     The child's visual verdict                          "halo on hair ..."
					folder @	              str     The candidate folder, from the repo root            "agents/.scratchpad/latentcomp/r0/lsq_gray_k3"
					results_sha256 @	      str     sha256 (hex) of results.json                        "3f9a…"

