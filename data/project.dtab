environ
	 Batch sizes, in processor order. Measured on the node (8x A100) on 2026-11-17
	DOWNLOAD_BATCH_SIZE 64	 Images per run of download_image. Network bound: 1.5 MB per PNG
	SPLIT_BATCH_SIZE 64	     Images per run of split_alpha. CPU only: it reads 1 PNG and writes 2
	ENCODE_BATCH_SIZE 128	 Images per run of encode_latents (about 40 s on one A100). run_proc_curate.fish starts two loops per GPU

	 Data
	MAGICK_REPO OneOverZero/MAGICK	 Hugging Face dataset: 140,955 RGBA PNGs, 1024 x 1024, straight alpha, 191 GB
	GRAY_LEVEL 0.5	                 Background of rgb_on_gray as a fraction of white: rgb * alpha + GRAY_LEVEL * (1 - alpha)
	EVAL_MODULUS 4000	             An image is eval, never trained on, when sha256(page_id) mod EVAL_MODULUS is 0: about 35 images

	 Models
	TEACHER_MODEL Efficient-Large-Model/SANA_Sprint_1.6B_1024px_teacher_diffusers	 The model we fine-tune. Its vae subfolder (DC-AE f32c32) makes the latents, so they match the model
	TEACHER_DIR ../models/Sana_Sprint_1.6B_1024px_teacher_diffusers	                 TEACHER_MODEL on FSx. encode_latents copies it to /models/sana-sprint-alpha-incontext once per machine

	 Eval (plan_eval, generate_eval)
	EVAL_SET resources/eval	 Eval images, captions and fixed noise, relative to the repo root. src/sana_alpha/eval_set.py makes it
	EVAL_BATCH_SIZE 16	      eval_generations rows per run of generate_eval. A run costs ~12 s besides the GPU: 8 rows took 15 s

	 Database
	DATABASE_PORT 23947	 Far from the ports of the Bluejay demos on the laptop (19471, 19683, 19783)

database
	backend bluejay.local_database.LocalLanceBackend
	host 0.0.0.0
	port $DATABASE_PORT
	root lance

claims_table bluejay_claims
runs_table bluejay_runs
lineage_table bluejay_lineage
lineage true


 RULES FOR MAINTAINING THIS DTAB (copied from MulticamDailies' project.dtab, the house style):
 SEMANTIC BINDING: dtab-rules
    - One tab renders as four spaces. After each edit run: python3 agents/dtab_format.py check data/project.dtab (fix repairs the columns)
    - Formatting is part of the interface. Copy the alignment of nearby blocks exactly. Do not reformat what the user aligned by hand
    - These rules are for the AI. Keep the user's own prose in the user's voice: do not rewrite it
    - Everything is written in ASD-STE100
    - Sort tables and processors by dependency: an item comes after each item that it reads
    - Put the primary key first, then group the columns by the processor that writes them
    - Give each committed column a TYPE, a DESCRIPTION and an EXAMPLE
    - [Key] identifies a primary key. A tilde immediately before the type identifies a materialized field copied unchanged to the commit output,
      with no other use by the processor, including diagnostic logging.
    - Annotate each corresponding materialize and commit row that exists in the DTAB. Replace the space before the type with ~, as in [Key] ~str,
      without moving the columns. Preserve at least one space after the comment tab; widen the table if necessary. The marker is part of the comment, not the field name.
    - Write each processor's query inline in the processor. The queries section holds only queries for Sparrow
    - Delete a query that no processor or widget uses
    - Delete a processor file that this dtab does not use, in its own commit
    - Remove a note when it is resolved
    - Right-align values at their shared suffix, like numbers at the decimal point: ` 720p.mp4` under `1080p.mp4`
    - Lay out a big query's SELECT like view_dataset: one item per line, struct fields aligned
    - Write each query that is not tiny and simple as an annotated SQL query, like encode_latents' query, for a reader who does not speak SQL.
      An annotated SQL query has these properties in its FROM, JOIN and WHERE:
        - Break lines where the English breaks: each line is one short statement. Join lines that make one statement, like SELECT ... FROM
        - End each line with a tiny -- comment, so that the comments read down as one sentence
        - Align the comments one space after the longest line. Inside parentheses, indent the comment text 4 more, so the reader can skip it
        - Align the parts that nearby lines share, such as AND, IS, ON and =
    - Eval inference runs here as generate_eval (user, m00606, m00611). Judging the results is done by the agent (m00371)


tables

	bluejay_claims
		 Bluejay requires this table
		primary_key claim_id
		index	claim_id btree
		columns
			claim_id, run_id, claim_status string

	bluejay_runs
		 Bluejay requires this table
		primary_key run_id
		columns
			run_id, run_status, started_at, finished_at, processor, metadata, dtab, query string
			exit_code int64
			log blob
			profiler blob

	bluejay_lineage
		 Bluejay requires this table, because lineage is true
		columns
			claim_id, table string
			key, materialized map_(string(), binary())
			committed list_(string())

	import_jobs
		 One seeded row makes import_index read magick_index.tsv exactly once
		primary_key job_id
		columns
			job_id string
			index_tsv blob
		initial_rows
			,	job_id magick

	magick_samples
		 One row per MAGICK image: 140,955 rows when the download is done
		primary_key page_id
		columns
			page_id string

			 Written by import_index, from magick_index.tsv
			subject, color, split, source_claim_id, source_run_id string
			sim_score float64
			nsfw, hand_picked bool

			 Written by download_image
			rgba blob

			 Written by split_alpha
			alpha, rgb_on_gray blob
			alpha_coverage, alpha_soft_fraction, green_spill float64

			 Written by encode_latents
			latent_alpha_1024, latent_rgb_1024 blob
			vae_psnr_1024 float64

	eval_models
		 One row per model to evaluate. To evaluate a new checkpoint, add a row here: run_proc_eval.fish initializes first
		primary_key model_tag
		columns
			model_tag, pipeline, checkpoint, prompt_variant string
			steps int64
			guidance float64
		initial_rows
			,
				model_tag sprint_plain
				pipeline sprint
				checkpoint stock
				prompt_variant plain
				steps 2
				guidance 4.5
			,
				model_tag sprint_gray
				pipeline sprint
				checkpoint stock
				prompt_variant gray
				steps 2
				guidance 4.5
			,
				model_tag teacher_plain
				pipeline teacher
				checkpoint stock
				prompt_variant plain
				steps 20
				guidance 4.5
			,
				model_tag teacher_gray
				pipeline teacher
				checkpoint stock
				prompt_variant gray
				steps 20
				guidance 4.5
			,
				model_tag adapter_toy_ddp2_step000400
				pipeline teacher
				checkpoint models/adapter/toy_ddp2/step_000400
				prompt_variant plain
				steps 20
				guidance 4.5
			,
				model_tag control_overfit_test_step000400
				pipeline teacher
				checkpoint models/control/overfit_test/step_000400
				prompt_variant plain
				steps 20
				guidance 4.5
			,
				model_tag final_overfit_test_step000400
				pipeline teacher
				checkpoint models/control/overfit_test/final_step_000400
				prompt_variant plain
				steps 20
				guidance 4.5
			,
				 Step 5 transfer: a control step on the sprint pipeline = stock student + merged control LoRA + gates
				model_tag transfer_overfit_test_step000400_1step
				pipeline sprint
				checkpoint models/control/overfit_test/step_000400
				prompt_variant plain
				steps 1
				guidance 4.5
			,
				model_tag transfer_overfit_test_step000400_2step
				pipeline sprint
				checkpoint models/control/overfit_test/step_000400
				prompt_variant plain
				steps 2
				guidance 4.5
			,
				model_tag transfer_overfit_test_step000400_4step
				pipeline sprint
				checkpoint models/control/overfit_test/step_000400
				prompt_variant plain
				steps 4
				guidance 4.5
			,
				 Step 2: the real adapter run
				model_tag adapter_v1_step001000
				pipeline teacher
				checkpoint models/adapter/adapter_v1/step_001000
				prompt_variant plain
				steps 20
				guidance 4.5
			,
				 The adapter that control_v1 is trained on
				model_tag adapter_v1_step002000
				pipeline teacher
				checkpoint models/adapter/adapter_v1/step_002000
				prompt_variant plain
				steps 20
				guidance 4.5
			,
				 Step 3, 4 and 5 of control_v1 step 500: control on the adapter, final (no adapter), and transfer onto Sprint
				model_tag control_v1_step000500
				pipeline teacher
				checkpoint models/control/control_v1/step_000500
				prompt_variant plain
				steps 20
				guidance 4.5
			,
				model_tag final_v1_step000500
				pipeline teacher
				checkpoint models/control/control_v1/final_step_000500
				prompt_variant plain
				steps 20
				guidance 4.5
			,
				model_tag transfer_v1_step000500_2step
				pipeline sprint
				checkpoint models/control/control_v1/step_000500
				prompt_variant plain
				steps 2
				guidance 4.5
			,
				 The final model lost the gray background. Fixes tried: the gray prompt, and keeping part of the adapter (λ)
				model_tag final_v1_step000500_gray
				pipeline teacher
				checkpoint models/control/control_v1/final_step_000500
				prompt_variant gray
				steps 20
				guidance 4.5
			,
				model_tag final_v1_step000500_adapter0.5
				pipeline teacher
				checkpoint models/control/control_v1/final_step_000500_adapter0.5
				prompt_variant plain
				steps 20
				guidance 4.5
			,
				model_tag final_v1_step000500_adapter0.75
				pipeline teacher
				checkpoint models/control/control_v1/final_step_000500_adapter0.75
				prompt_variant plain
				steps 20
				guidance 4.5
			,
				model_tag transfer_v1_step000500_2step_gray
				pipeline sprint
				checkpoint models/control/control_v1/step_000500
				prompt_variant gray
				steps 2
				guidance 4.5

	eval_generations
		 One row per model and eval image: the image that the model makes from the caption and the fixed noise
		primary_key model_tag,page_id,noise_seed
		columns
			model_tag, page_id string
			noise_seed int64

			 Written by plan_eval
			caption, source_claim_id, source_run_id string
			noise_index int64

			 Written by generate_eval
			prompt, call_kwargs string
			step_noise_seed int64
			image blob
			seconds, exterior_gray_error, border_gray_error, border_std, iou, foreground_fraction float64


processors

	import_index	 Downloads magick_index.tsv (16 MB) and adds one magick_samples row per image. No image yet
		query SELECT job_id FROM import_jobs WHERE import_claim IS NULL
		claim	import_claim import_jobs
		command bash
			uv run --script processors/import_index.py "$SAMPLE" $MAGICK_REPO $EVAL_MODULUS
		materialize
			input.json	            TYPE  DESCRIPTION         EXAMPLE
				job_id @	  [Key]  str   The one import job  "magick"
		commit
			import_jobs	               TYPE  DESCRIPTION                                                                  EXAMPLE
				index_tsv index.tsv	    blob  magick_index.tsv as downloaded: 148,193 rows, 7,238 of them repeat an image  16.1 MB .tsv
			magick_samples
				rows.parquet	                    TYPE   DESCRIPTION                                                                              EXAMPLE
					page_id @	              [Key]  str    MAGICK image ID, the PNG's file name                                                     "Hcx82jcUpM"
					subject @	                     str    The caption: a short subject phrase                                                      "red boiled crayfish on a plate ."
					color @	                         str    Screen color that MAGICK keyed out                                                       "green"
					sim_score @	                     float  Agreement of MAGICK's 3 alpha extractors (MS-SSIM). Low: maybe color spill               0.9879238
					nsfw @	                         bool   MAGICK's NSFW flag. 3,000 index rows                                                     false
					hand_picked @	                 bool   The index lists it as "hand". A repeated image is listed once as "hand", once as "auto"  true
					split @	                         str    "eval" when sha256(page_id) mod EVAL_MODULUS is 0, else "train"                          "train"
					source_claim_id $CLAIM	         str    Claim of the import run                                                                  "9f1c…"
					source_run_id $RUN	             str    The import run                                                                           "4b2e…"

	download_image	 Downloads each image's RGBA PNG from Hugging Face: images/<first 2 letters>/<page_id>.png
		query sql
			SELECT page_id FROM magick_samples           -- MAGICK images
			WHERE download_claim IS NULL                 -- not yet claimed,
			ORDER BY random() LIMIT $DOWNLOAD_BATCH_SIZE -- one batch at a time, in random order
		claim	download_claim magick_samples
		command bash
			uv run --script processors/download_image.py "$BATCH" $MAGICK_REPO
		materialize
			input.json	            TYPE  DESCRIPTION                           EXAMPLE
				page_id @	  [Key]  str   MAGICK image ID, the PNG's file name  "Hcx82jcUpM"
		commit
			magick_samples	       TYPE  DESCRIPTION                                                       EXAMPLE
				rgba rgba.png	    blob  The MAGICK image as downloaded: 1024 x 1024 RGBA, straight alpha  1.5 MB .png

	split_alpha	 Splits each RGBA PNG into its matte and its RGB composited on gray, and measures the matte
		query sql
			SELECT page_id, rgba FROM magick_samples  -- MAGICK images
			WHERE   split_alpha_claim IS NULL         -- not yet claimed,
			    AND rgba              IS NOT NULL     -- that download_image did,
			ORDER BY random() LIMIT $SPLIT_BATCH_SIZE -- one batch at a time, in random order
		claim	split_alpha_claim magick_samples
		command bash
			uv run --script processors/split_alpha.py "$BATCH" $GRAY_LEVEL
		materialize	           TYPE  DESCRIPTION       EXAMPLE
			rgba.png rgba	    blob  The MAGICK image  1.5 MB .png
		commit
			magick_samples	                           TYPE   DESCRIPTION                                                          EXAMPLE
				alpha alpha.png	                        blob   The matte: 1024 x 1024 grayscale, 8 bit                              120 KB .png
				rgb_on_gray rgb_on_gray.png	            blob   rgb * alpha + GRAY_LEVEL * (1 - alpha): 1024 x 1024 RGB, 8 bit       1.4 MB .png
				result.json	                 SUBFIELD  TYPE   DESCRIPTION                                                          EXAMPLE
					alpha_coverage @	                float  Mean alpha: how much of the frame the object fills                   0.31
					alpha_soft_fraction @	            float  Fraction of pixels with 0 < alpha < 1: hair, glass, smoke            0.04
					green_spill @	                    float  Mean of max(0, g - max(r, b)) where alpha > 0.5. High: green fringe  0.006

	encode_latents	 Encodes each matte and each RGB-on-gray with the teacher's DC-AE, and measures the round trip
		query sql
			SELECT page_id, alpha, rgb_on_gray FROM magick_samples -- MAGICK images
			WHERE   encode_latents_claim IS NULL                   -- not yet claimed,
			    AND rgb_on_gray          IS NOT NULL               -- that split_alpha did,
			ORDER BY random() LIMIT $ENCODE_BATCH_SIZE             -- one batch at a time, in random order
		claim	encode_latents_claim magick_samples
		command bash
			uv run --script processors/encode_latents.py "$BATCH" $TEACHER_DIR
		materialize	                       TYPE  DESCRIPTION                                      EXAMPLE
			alpha.png alpha	                blob  The matte, copied to 3 channels before encoding  120 KB .png
			rgb_on_gray.png rgb_on_gray	    blob  The RGB on gray                                  1.4 MB .png
		commit
			magick_samples	                                           TYPE   DESCRIPTION                                                                                    EXAMPLE
				latent_alpha_1024 latent_alpha.safetensors	            blob   DC-AE latent of the matte: (32, 32, 32) bfloat16, key "latent", unscaled                       64 KB .safetensors
				latent_rgb_1024 latent_rgb.safetensors	                blob   DC-AE latent of the RGB on gray: (32, 32, 32) bfloat16, key "latent", unscaled                 64 KB .safetensors
				result.json	                                 SUBFIELD  TYPE   DESCRIPTION                                                                                    EXAMPLE
					vae_psnr_1024 @	                                    float  PSNR in dB of the decoded RGB on gray against the original. Low: DC-AE cannot hold this image  31.2

	plan_eval	 Adds one eval_generations row per eval image for each new eval_models row. No GPU
		query SELECT model_tag FROM eval_models WHERE plan_eval_claim IS NULL
		claim	plan_eval_claim eval_models
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src uv run --project .. python processors/generate_eval.py plan "$SAMPLE" $EVAL_SET
		materialize
			input.json	            TYPE DESCRIPTION            EXAMPLE
				model_tag @	  [Key]  str  The model to evaluate  "sprint_gray"
		commit
			eval_generations
				rows.jsonl	                        TYPE DESCRIPTION                                               EXAMPLE
					model_tag @	              [Key]  str  The model to evaluate                                     "sprint_gray"
					page_id @	              [Key]  str  An eval image: sha256(page_id) mod EVAL_MODULUS is 0      "6NqAw3m1ss"
					noise_seed @	          [Key]  int  Seed of the fixed noise in EVAL_SET                       20261117
					caption @	                     str  The image's MAGICK caption                                "red apple on a solid"
					noise_index @	                 int  Row of the image's latents in EVAL_SET/noise.safetensors  10
					source_claim_id $CLAIM	         str  Claim of the plan run                                     "9f1c…"
					source_run_id $RUN	             str  The plan run                                              "4b2e…"

	generate_eval	 Generates each eval_generations image with its model, on this GPU's server, which keeps the model loaded
		query sql
			SELECT g.model_tag, g.page_id, g.noise_seed, g.caption, g.noise_index,  -- eval images
			       m.pipeline, m.checkpoint, m.steps, m.guidance, m.prompt_variant -- with their model's settings
			FROM eval_generations g                                                -- from the planned rows,
			JOIN eval_models m ON m.model_tag = g.model_tag                        -- joined to their model,
			WHERE g.generate_eval_claim IS NULL                                    -- not yet claimed,
			ORDER BY g.model_tag, random() LIMIT $EVAL_BATCH_SIZE                  -- one model at a time, in random order
		claim	generate_eval_claim eval_generations
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src uv run --project .. python processors/generate_eval.py batch "$BATCH" $EVAL_SET
		materialize
			input.json	                    TYPE   DESCRIPTION                                                       EXAMPLE
				model_tag @	          [Key]  str    The model                                                         "sprint_gray"
				page_id @	          [Key]  str    The eval image                                                    "6NqAw3m1ss"
				noise_seed @	      [Key]  int    Seed of the fixed noise                                           20261117
				caption @	                 str    The MAGICK caption                                                "red apple on a solid"
				noise_index @	             int    Row of the latents in EVAL_SET/noise.safetensors                  10
				pipeline @	                 str    "teacher" (SanaPipeline) or "sprint" (SanaSprintPipeline)         "sprint"
				checkpoint @	             str    "stock", or a repo path: see models.load_eval_pipeline            "stock"
				steps @	                     int    Sampling steps                                                    2
				guidance @	                 float  CFG for the teacher, embedded guidance for Sprint                 4.5
				prompt_variant @	         str    "plain", or "gray": caption + ", on a plain 50% gray background"  "gray"
		commit
			eval_generations	                    TYPE   DESCRIPTION                                                   EXAMPLE
				image image.png	                     blob   The generated image: 1024 x 1024 RGB, 8 bit                   1.5 MB .png
				result.json	               SUBFIELD TYPE   DESCRIPTION                                                   EXAMPLE
					prompt @	                     str    The prompt given to the model                                 "red apple on a solid, on a plain 50% gray background"
					call_kwargs @	                 str    JSON of the pipeline call settings                            "{\"num_inference_steps\": 2, ...}"
					step_noise_seed @	             int    Seed of the noise that the Sprint sampler adds between steps  787
					seconds @	                     float  GPU time per image: batch time / batch size                   0.27
					exterior_gray_error @	         float  Mean |rgb - 0.5| where the matte is 0. Low: clean gray        0.17
					border_gray_error @	             float  Mean |rgb - 0.5| in the 64 px edge band                       0.18
					border_std @	                 float  Standard deviation in the 64 px edge band. 0: flat            0.10
					iou @	                         float  IoU of the pixels far from 0.5 gray with the matte            0.39
					foreground_fraction @	         float  Fraction of the pixels far from 0.5 gray                      0.92


queries
	view_dataset sql
		SELECT
		    struct('image' AS widget,       alpha AS src, subject   AS caption) AS alpha,
		    struct('image' AS widget, rgb_on_gray AS src, 'on gray' AS caption) AS on_gray,
		    page_id,
		    subject,
		    split,
		    nsfw,
		    hand_picked,
		    sim_score,
		    green_spill,
		    alpha_coverage,
		    vae_psnr_1024
		FROM magick_samples           -- MAGICK images
		WHERE rgb_on_gray IS NOT NULL -- that split_alpha did,
		ORDER BY page_id              -- in a fixed order

sparrow
	saves sparrow_saves

albatross
	saves albatross_saves
