	eval_generations
		 One row per model and eval image: the image that the model makes from the caption and the fixed noise
		primary_key model_tag,page_id,noise_seed
		columns
			model_tag, page_id string
			noise_seed int64

			 Written by plan_eval
			caption, source_claim_id, source_run_id string
			noise_index int64

			 Written by generate_eval
			prompt, call_kwargs string
			step_noise_seed int64
			image blob
			seconds, exterior_gray_error, border_gray_error, border_std, iou, foreground_fraction float64

	trimask_augmentations
		 One row per trimask: the condition of the trimask model (manifest §13). Nineteen methods, about 17.6k train images each, plus the comparison set
		primary_key page_id,method,variant
		columns
			page_id, method string
			variant int64

			 Written by the nineteen trimask_<method> processors
			split, params string
			trimask blob
			white_fraction, gray_fraction, black_fraction float64

			 Written by encode_multires: long-lived per-GPU workers (data/processors/encode_multires.py, started by run_proc_trimask.fish), committed with Bluejay's commit, not Bluejay runs
			 768, 512 and 256 for every row (encode_multires.LOWRES_DIGITS, m00677)
			latent_trimask_1024, latent_trimask_768, latent_trimask_512, latent_trimask_256 blob

			 Written by encode_fibo2 (manifest §14): (32, S/8, S/8) bfloat16, key "latent", the raw FLUX.2 VAE mode of the trimask copied to 3 channels
			fibo2_trimask_1024, fibo2_trimask_768, fibo2_trimask_512, fibo2_trimask_256 blob

	 H3 MAGIC PROJECT (manifest §22). Every table below belongs to the second experiment: adapters on MiniMax H3 at 512 x 512

	h3_import_jobs
		 One seeded row per slice of H3_PEXELS_SELECTION: h3_import imports each slice exactly once. Fork PexelsPick appends rows, so a new slice is a new row
		primary_key job_id
		columns
			job_id string
			row_offset, row_count int64
		initial_rows
			,	job_id slice_0	row_offset 0	row_count 11523
			,	job_id slice_1	row_offset 11523	row_count 10000

	h3_magick_images
		 One row per MAGICK image of the H3 Magic project: the first H3_MAGICK_COUNT usable train images by sha256(page_id)
		primary_key page_id
		columns
			page_id string

			 Written by h3_magick_image
			split, subject string
			image_512 blob

			 Written by h3_caption_magick
			h3_caption, h3_caption_model string
			h3_caption_seconds float64

			 Written by h3_encode and h3_embed: long-lived per-GPU workers (data/processors/h3_encode.py, h3_embed.py, started by run_proc_h3_encode.fish), committed with Bluejay's commit, not Bluejay runs
			 h3_latent_512: safetensors {"latent": (24, 1, 32, 32) bfloat16}, the H3 VAE latent of image_512, normalized (h3magic/h3.py encode)
			 h3_text_embed: safetensors {"prompt_embeds": (1, N, 5120) bfloat16, "text_token_tags": (N,) int64} of h3_caption, H3's text encoder (layer 50)
			h3_latent_512, h3_text_embed blob
			h3_text_sha256 string	 The sha256 (hex) of the h3_caption that h3_text_embed embeds. Use the embedding only when it matches the current caption (m00939)

			 Written by h3_encode's job split (the split adapter's targets, manifest §22): the same latent of magick_samples.rgba composited on white and on black
			 at 1024 and area-downsampled to 512, exactly as image_512 is the composite on 0.5 gray. h3_latent_black_512 is the done column
			h3_latent_white_512, h3_latent_black_512 blob

			 Alpha Video v2 (manifest §23). Written by h3_encode's job v3: magick_samples.rgba composited on 0.5 gray, white and black at 1024,
			 area-resized to 768, H3 VAE latents (24, 1, 48, 48). h3_latent_black_768 is the done column
			h3_latent_gray_768, h3_latent_white_768, h3_latent_black_768 blob
			 The same, TILED encode (256-px tiles; H3's latent statistics, manifest §25). Written by h3_encode's job v3t; h3_latent_black_768t is the done column
			h3_latent_gray_768t, h3_latent_white_768t, h3_latent_black_768t blob
			 Written by agents/.scratchpad/alphav2/set_captions_v3.py: h3_caption + the gray suffix of §23. h3_embed embeds it into h3_text_embed_v3
			h3_caption_v3 string
			h3_text_embed_v3 blob
			h3_text_v3_sha256 string	 The sha256 (hex) of the h3_caption_v3 that h3_text_embed_v3 embeds

			 Split v3-grid (manifest §23, m01003, m01005). Written by h3_encode's job grid: one 768 x 768 frame of 2 x 2 panels of 384 (each composited at 1024,
			 area-resized): top left on 0.5 gray, top right on white, bottom left on black, bottom right the alpha matte in grayscale. H3 VAE latent (24, 1, 48, 48)
			h3_latent_grid_768 blob
			 Written by agents/.scratchpad/alphav2/set_captions_grid.py: h3_caption + the grid suffix. h3_embed embeds it into h3_text_embed_grid
			h3_caption_grid string
			h3_text_embed_grid blob
			h3_text_grid_sha256 string	 The sha256 (hex) of the h3_caption_grid that h3_text_embed_grid embeds

	h3_pexels_clips
		 One row per Pexels clip of the H3 Magic project. The video stays where it is: source_path refers to it (m00912)
		primary_key pexels_id
		columns
			pexels_id string

			 Written by h3_import, from H3_PEXELS_SELECTION
			source_path, split, birdseye_caption string
			duration, fps, flow_mean_magnitude float64
			width, height int64

			 Written by h3_cut_clip
			clip_512, frame_0s, frame_1s, frame_2s, frame_3s, frame_4s, frame_5s, frame_6s blob
			motion_512 float64

			 Written by h3_choose_clip, every few minutes while clips are cut, and once more after the last (h3_choose_loop.fish). It also rewrites split
			h3_use string
			birdseye_score float64

			 Written by h3_caption_clip
			h3_caption, h3_caption_model string
			h3_caption_seconds float64

			 Written by h3_encode and h3_embed: long-lived per-GPU workers (data/processors/h3_encode.py, h3_embed.py, started by run_proc_h3_encode.fish), committed with Bluejay's commit, not Bluejay runs
			 h3_latent_video: {"latent": (24, 42, 32, 32) bfloat16} of clip_512. h3_latent_frames: {"latent": (7, 24, 1, 32, 32)} of frame_0s .. frame_6s. Normalized (h3magic/h3.py encode)
			 h3_text_embed: {"prompt_embeds": (1, N, 5120) bfloat16, "text_token_tags": (N,) int64} of h3_caption
			h3_latent_video, h3_latent_frames, h3_text_embed blob
			h3_text_sha256 string	 The sha256 (hex) of the h3_caption that h3_text_embed embeds. Use the embedding only when it matches the current caption (m00939)

	h3_eval_prompts
		 The 20 curated eval prompts of h3magic/eval_prompts.json (manifest §22): every journal row uses them. Never trained on
		primary_key prompt_id
		columns
			prompt_id string

			 Written by h3_generate.py plan
			short, prompt string
			seed int64
			prompt_set string	 main (empty) = h3magic/eval_prompts.json p01-p20; fg = h3magic/eval_prompts_fg.json f01-f20: the same subjects, no background described (m00972)

			 Written by h3_embed (as h3_pexels_clips)
			h3_text_embed blob
			h3_text_sha256 string	 The sha256 (hex) of the prompt that h3_text_embed embeds

	h3_eval_models
		 One row per H3 model to evaluate: W = W_H3 + a_pexels * Δ_pexels + b_imagegen * Δ_imagegen + c_graymagic * Δ_graymagic
		 Adapter paths are LoRA folders relative to the repo root; an empty path leaves that adapter out. To evaluate a new model, add a row, then run run_proc_h3_eval.fish
		primary_key model_tag
		columns
			model_tag, mode, pexels_adapter, imagegen_adapter, graymagic_adapter string	 mode: video (141 frames) or image (1 frame)
			steps int64
