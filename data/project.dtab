	trimask_convex_hull
		query sql
			SELECT page_id, alpha, split FROM magick_samples                                                     -- MAGICK images
			WHERE   trimask_convex_hull_claim IS NULL                                                            -- not yet claimed,
			    AND alpha                     IS NOT NULL                                                        -- that split_alpha did,
			    AND split                     = 'train'                                                          -- not eval,
			    AND page_id NOT IN (SELECT page_id FROM _no_trimask_items)                                       -- not a showcase image or an empty matte,
			    AND (contains('$TRIMASK_SUBSET', left(encode(sha256(concat(page_id, 'convex_hull')), 'hex'), 1)) -- in this method's subset (TRIMASK_SUBSET)
			         OR left(encode(sha256(page_id), 'hex'), 3) <= '$TRIMASK_COMPARE_MAX')                       -- or in the comparison set,
			ORDER BY random() LIMIT $TRIMASK_BATCH_SIZE                                                          -- one batch at a time, in random order
		claim	trimask_convex_hull_claim magick_samples
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src OMP_NUM_THREADS=1 uv run --project .. python processors/trimask_augment.py "$BATCH" convex_hull $TRIMASK_VARIANTS $TRIMASK_SUBSET $TRIMASK_COMPARE_MAX

