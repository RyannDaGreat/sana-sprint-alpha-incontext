	eval_generations
		 One row per model and eval image: the image that the model makes from the caption and the fixed noise
		primary_key model_tag,page_id,noise_seed
		columns
			model_tag, page_id string
			noise_seed int64

			 Written by plan_eval
			caption, source_claim_id, source_run_id string
			noise_index int64

			 Written by generate_eval
			prompt, call_kwargs string
			step_noise_seed int64
			image blob
			seconds, exterior_gray_error, border_gray_error, border_std, iou, foreground_fraction float64

	trimask_augmentations
		 One row per trimask: the condition of the trimask model (manifest §13). Sixteen methods, about 26k train images each
		primary_key page_id,method,variant
		columns
			page_id, method string
			variant int64

			 Written by the sixteen trimask_<method> processors
			split, params string
			trimask blob
			white_fraction, gray_fraction, black_fraction float64

			 Written by encode_trimask
			latent_trimask_1024 blob


processors

	import_index	 Downloads magick_index.tsv (16 MB) and adds one magick_samples row per image. No image yet
		query SELECT job_id FROM import_jobs WHERE import_claim IS NULL
		claim	import_claim import_jobs
		command bash
			uv run --script processors/import_index.py "$SAMPLE" $MAGICK_REPO $EVAL_MODULUS
		materialize
			input.json	            TYPE  DESCRIPTION         EXAMPLE
				job_id @	  [Key]  str   The one import job  "magick"
		commit
			import_jobs	               TYPE  DESCRIPTION                                                                  EXAMPLE
				index_tsv index.tsv	    blob  magick_index.tsv as downloaded: 148,193 rows, 7,238 of them repeat an image  16.1 MB .tsv
			magick_samples
				rows.parquet	                    TYPE   DESCRIPTION                                                                              EXAMPLE
					page_id @	              [Key]  str    MAGICK image ID, the PNG's file name                                                     "Hcx82jcUpM"
					subject @	                     str    The caption: a short subject phrase                                                      "red boiled crayfish on a plate ."
					color @	                         str    Screen color that MAGICK keyed out                                                       "green"
					sim_score @	                     float  Agreement of MAGICK's 3 alpha extractors (MS-SSIM). Low: maybe color spill               0.9879238
					nsfw @	                         bool   MAGICK's NSFW flag. 3,000 index rows                                                     false
					hand_picked @	                 bool   The index lists it as "hand". A repeated image is listed once as "hand", once as "auto"  true
					split @	                         str    "eval" when sha256(page_id) mod EVAL_MODULUS is 0, else "train"                          "train"
					source_claim_id $CLAIM	         str    Claim of the import run                                                                  "9f1c…"
					source_run_id $RUN	             str    The import run                                                                           "4b2e…"

	download_image	 Downloads each image's RGBA PNG from Hugging Face: images/<first 2 letters>/<page_id>.png
		query sql
			SELECT page_id FROM magick_samples           -- MAGICK images
			WHERE download_claim IS NULL                 -- not yet claimed,
			ORDER BY random() LIMIT $DOWNLOAD_BATCH_SIZE -- one batch at a time, in random order
		claim	download_claim magick_samples
		command bash
			uv run --script processors/download_image.py "$BATCH" $MAGICK_REPO
		materialize
			input.json	            TYPE  DESCRIPTION                           EXAMPLE
				page_id @	  [Key]  str   MAGICK image ID, the PNG's file name  "Hcx82jcUpM"
		commit
			magick_samples	       TYPE  DESCRIPTION                                                       EXAMPLE
				rgba rgba.png	    blob  The MAGICK image as downloaded: 1024 x 1024 RGBA, straight alpha  1.5 MB .png

	split_alpha	 Splits each RGBA PNG into its matte and its RGB composited on gray, and measures the matte
		query sql
			SELECT page_id, rgba FROM magick_samples  -- MAGICK images
			WHERE   split_alpha_claim IS NULL         -- not yet claimed,
			    AND rgba              IS NOT NULL     -- that download_image did,
			ORDER BY random() LIMIT $SPLIT_BATCH_SIZE -- one batch at a time, in random order
		claim	split_alpha_claim magick_samples
		command bash
			uv run --script processors/split_alpha.py "$BATCH" $GRAY_LEVEL
		materialize	           TYPE  DESCRIPTION       EXAMPLE
			rgba.png rgba	    blob  The MAGICK image  1.5 MB .png
		commit
			magick_samples	                           TYPE   DESCRIPTION                                                          EXAMPLE
				alpha alpha.png	                        blob   The matte: 1024 x 1024 grayscale, 8 bit                              120 KB .png
				rgb_on_gray rgb_on_gray.png	            blob   rgb * alpha + GRAY_LEVEL * (1 - alpha): 1024 x 1024 RGB, 8 bit       1.4 MB .png
				result.json	                 SUBFIELD  TYPE   DESCRIPTION                                                          EXAMPLE
					alpha_coverage @	                float  Mean alpha: how much of the frame the object fills                   0.31
					alpha_soft_fraction @	            float  Fraction of pixels with 0 < alpha < 1: hair, glass, smoke            0.04
					green_spill @	                    float  Mean of max(0, g - max(r, b)) where alpha > 0.5. High: green fringe  0.006

	encode_latents	 Encodes each matte and each RGB-on-gray with the teacher's DC-AE, and measures the round trip
		query sql
			SELECT page_id, alpha, rgb_on_gray FROM magick_samples -- MAGICK images
			WHERE   encode_latents_claim IS NULL                   -- not yet claimed,
			    AND rgb_on_gray          IS NOT NULL               -- that split_alpha did,
			ORDER BY random() LIMIT $ENCODE_BATCH_SIZE             -- one batch at a time, in random order
		claim	encode_latents_claim magick_samples
		command bash
			uv run --script processors/encode_latents.py "$BATCH" $TEACHER_DIR
		materialize	                       TYPE  DESCRIPTION                                      EXAMPLE
			alpha.png alpha	                blob  The matte, copied to 3 channels before encoding  120 KB .png
			rgb_on_gray.png rgb_on_gray	    blob  The RGB on gray                                  1.4 MB .png
		commit
			magick_samples	                                           TYPE   DESCRIPTION                                                                                    EXAMPLE
				latent_alpha_1024 latent_alpha.safetensors	            blob   DC-AE latent of the matte: (32, 32, 32) bfloat16, key "latent", unscaled                       64 KB .safetensors
				latent_rgb_1024 latent_rgb.safetensors	                blob   DC-AE latent of the RGB on gray: (32, 32, 32) bfloat16, key "latent", unscaled                 64 KB .safetensors
				result.json	                                 SUBFIELD  TYPE   DESCRIPTION                                                                                    EXAMPLE
					vae_psnr_1024 @	                                    float  PSNR in dB of the decoded RGB on gray against the original. Low: DC-AE cannot hold this image  31.2

	encode_colorbg	 Composites each RGBA PNG on its own random solid color and encodes it with the teacher's DC-AE. For adapter_v2
		 The adapter learns MAGICK's look but no one background color. So the control model must learn the gray, and W_base - W_adapter keeps it
		query sql
			SELECT page_id, rgba FROM magick_samples    -- MAGICK images
			WHERE   encode_colorbg_claim IS NULL        -- not yet claimed,
			    AND rgb_on_gray          IS NOT NULL    -- that split_alpha did (it fails RGB-only PNGs),
			ORDER BY random() LIMIT $COLORBG_BATCH_SIZE -- one batch at a time, in random order
		claim	encode_colorbg_claim magick_samples
		command bash
			uv run --script processors/encode_colorbg.py "$BATCH" $TEACHER_DIR
		materialize	           TYPE  DESCRIPTION       EXAMPLE
			rgba.png rgba	    blob  The MAGICK image  1.5 MB .png
			input.json	            TYPE  DESCRIPTION                           EXAMPLE
				page_id @	  [Key]  str   MAGICK image ID: it seeds bg_color    "Hcx82jcUpM"
		commit
			magick_samples	                                                    TYPE   DESCRIPTION                                                                              EXAMPLE
				latent_rgb_colorbg_1024 latent_rgb_colorbg.safetensors	         blob   DC-AE latent of rgb * alpha + bg_color * (1 - alpha): like latent_rgb_1024               64 KB .safetensors
				result.json	                                          SUBFIELD  TYPE   DESCRIPTION                                                                              EXAMPLE
					bg_color @	                                                 list   Background RGB, uniform in [0, 1), seeded by the first 8 bytes of sha256(page_id)        [0.628, 0.306, 0.224]

	plan_eval	 Adds one eval_generations row per eval image for each new eval_models row. No GPU
		query SELECT model_tag, coalesce(eval_set, '$EVAL_SET') AS eval_set FROM eval_models WHERE plan_eval_claim IS NULL
		claim	plan_eval_claim eval_models
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src uv run --project .. python processors/generate_eval.py plan "$SAMPLE"
		materialize
			input.json	            TYPE DESCRIPTION            EXAMPLE
				model_tag @	  [Key]  str  The model to evaluate  "sprint_gray"
				eval_set @	         str  Its eval set folder    "resources/eval"
		commit
			eval_generations
				rows.jsonl	                        TYPE DESCRIPTION                                               EXAMPLE
					model_tag @	              [Key]  str  The model to evaluate                                     "sprint_gray"
					page_id @	              [Key]  str  An item of eval_set                                       "6NqAw3m1ss"
					noise_seed @	          [Key]  int  Seed of the fixed noise in eval_set                       20261117
					caption @	                     str  The image's MAGICK caption                                "red apple on a solid"
					noise_index @	                 int  Row of the image's latents in eval_set/noise.safetensors  10
					source_claim_id $CLAIM	         str  Claim of the plan run                                     "9f1c…"
					source_run_id $RUN	             str  The plan run                                              "4b2e…"

	generate_eval	 Generates each eval_generations image with its model, on this GPU's server, which keeps the model loaded
		query sql
			SELECT g.model_tag, g.page_id, g.noise_seed, g.caption, g.noise_index,  -- eval images
			       m.pipeline, m.checkpoint, m.steps, m.guidance, m.prompt_variant, -- with their model's settings
			       coalesce(m.eval_set, '$EVAL_SET') AS eval_set                   -- and eval set
			FROM eval_generations g                                                -- from the planned rows,
			JOIN eval_models m ON m.model_tag = g.model_tag                        -- joined to their model,
			WHERE g.generate_eval_claim IS NULL                                    -- not yet claimed,
			ORDER BY g.model_tag, random() LIMIT $EVAL_BATCH_SIZE                  -- one model at a time, in random order
		claim	generate_eval_claim eval_generations
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src uv run --project .. python processors/generate_eval.py batch "$BATCH"
		materialize
			input.json	                    TYPE   DESCRIPTION                                                       EXAMPLE
				model_tag @	          [Key]  str    The model                                                         "sprint_gray"
				page_id @	          [Key]  str    The eval image                                                    "6NqAw3m1ss"
				noise_seed @	      [Key]  int    Seed of the fixed noise                                           20261117
				caption @	                 str    The MAGICK caption                                                "red apple on a solid"
				noise_index @	             int    Row of the latents in eval_set/noise.safetensors                  10
				pipeline @	                 str    "teacher" (SanaPipeline) or "sprint" (SanaSprintPipeline)         "sprint"
				checkpoint @	             str    "stock", or a repo path: see models.load_eval_pipeline            "stock"
				steps @	                     int    Sampling steps                                                    2
				guidance @	                 float  CFG for the teacher, embedded guidance for Sprint                 4.5
				prompt_variant @	         str    "plain", "gray" (+ gray words) or "detailed" (prompts_detailed)   "gray"
				eval_set @	                 str    Eval set folder: captions, mattes and fixed noise                 "resources/eval"
		commit
			eval_generations	                    TYPE   DESCRIPTION                                                   EXAMPLE
				image image.png	                     blob   The generated image: 1024 x 1024 RGB, 8 bit                   1.5 MB .png
				result.json	               SUBFIELD TYPE   DESCRIPTION                                                   EXAMPLE
					prompt @	                     str    The prompt given to the model                                 "red apple on a solid, on a plain 50% gray background"
					call_kwargs @	                 str    JSON of the pipeline call settings                            "{\"num_inference_steps\": 2, ...}"
					step_noise_seed @	             int    Seed of the noise that the Sprint sampler adds between steps  787
					seconds @	                     float  GPU time per image: batch time / batch size                   0.27
					exterior_gray_error @	         float  Mean |rgb - 0.5| where the matte is 0. Low: clean gray        0.17
					border_gray_error @	             float  Mean |rgb - 0.5| in the 64 px edge band                       0.18
					border_std @	                 float  Standard deviation in the 64 px edge band. 0: flat            0.10
					iou @	                         float  IoU of the pixels far from 0.5 gray with the matte            0.39
					foreground_fraction @	         float  Fraction of the pixels far from 0.5 gray                      0.92

	trimask_morph_band	 Makes the trimasks of method morph_band (src/sana_alpha/trimask/morph_band.py) for its train images
		query sql
			SELECT page_id, alpha, split FROM magick_samples                                                   -- MAGICK images
			WHERE   trimask_morph_band_claim IS NULL                                                           -- not yet claimed,
			    AND alpha                    IS NOT NULL                                                       -- that split_alpha did,
			    AND split                    = 'train'                                                         -- not eval,
			    AND page_id NOT IN (SELECT page_id FROM _showcase_train_items)                                 -- not a showcase image,
			    AND contains('$TRIMASK_SUBSET', left(encode(sha256(concat(page_id, 'morph_band')), 'hex'), 1)) -- in this method's subset (TRIMASK_SUBSET),
			ORDER BY random() LIMIT $TRIMASK_BATCH_SIZE                                                        -- one batch at a time, in random order
		claim	trimask_morph_band_claim magick_samples
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src uv run --project .. python processors/trimask_augment.py "$BATCH" morph_band $TRIMASK_VARIANTS $TRIMASK_SUBSET
		materialize	               TYPE  DESCRIPTION                            EXAMPLE
			alpha.png alpha	        blob  The matte                              120 KB .png
			input.json	           TYPE  DESCRIPTION                            EXAMPLE
				page_id @	 [Key]  str   MAGICK image ID: it seeds the trimask  "Hcx82jcUpM"
				split @	           ~str   Always train                           "train"
		commit
			trimask_augmentations
				children/	                       TYPE   DESCRIPTION                                                                       EXAMPLE
					trimask trimask.png	            blob   The trimask: 1024 x 1024 grayscale, 8 bit. 255 object, 0 background, 128 unknown  20 KB .png
					fields.json	         SUBFIELD  TYPE   DESCRIPTION                                                                       EXAMPLE
						page_id @	         [Key]  str    The image                                                                         "Hcx82jcUpM"
						method @	         [Key]  str    The method tag                                                                    "morph_band"
						variant @	         [Key]  int    0 to TRIMASK_VARIANTS - 1: it seeds the trimask too                               0
						split @	                   ~str    Always train                                                                      "train"
						params @	                str    JSON of the hyperparameters used                                                  "{...}"
						white_fraction @	        float  Fraction of pixels 255: surely object                                             0.25
						gray_fraction @	            float  Fraction of pixels not 0 or 255: unknown                                          0.10
						black_fraction @	        float  Fraction of pixels 0: surely background                                           0.65

