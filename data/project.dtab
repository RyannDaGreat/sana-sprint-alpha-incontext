	 H3 MAGIC PROJECT (manifest §22). Every processor below belongs to the second experiment. Run: fish data/run_proc_h3magic.fish

	h3_magick_image	 Adds one h3_magick_images row per chosen MAGICK image: its RGB on gray, area-downsampled to 512 x 512
		query sql
			SELECT page_id, subject, rgb_on_gray, h3_split FROM (                                   -- MAGICK images,
			    SELECT page_id, subject, rgb_on_gray, h3_magick_image_claim,                        -- each ranked
			           CASE WHEN h3_rank <= $H3_VAL_COUNT THEN 'val' ELSE 'train' END AS h3_split   -- (the first H3_VAL_COUNT are val, the rest train)
			    FROM (SELECT page_id, subject, rgb_on_gray, h3_magick_image_claim,                  -- by
			                 row_number() OVER (ORDER BY encode(sha256(page_id), 'hex')) AS h3_rank -- sha256(page_id),
			          FROM magick_samples                                                           -- of the
			          WHERE split = 'train' AND NOT nsfw AND rgb_on_gray IS NOT NULL)               -- usable train images:
			    WHERE   h3_rank               <= $H3_MAGICK_COUNT                                   -- the first H3_MAGICK_COUNT,
			        AND h3_magick_image_claim IS NULL)                                              -- not yet claimed,
			ORDER BY random() LIMIT $H3_IMAGE_BATCH_SIZE                                            -- one batch at a time, in random order
		claim	h3_magick_image_claim magick_samples
		command bash
			uv run --script processors/h3_magick_image.py "$BATCH"
		materialize	                       TYPE  DESCRIPTION                 EXAMPLE
			rgb_on_gray.png rgb_on_gray	    blob  The MAGICK image on gray    1.4 MB .png
			input.json	              TYPE  DESCRIPTION                                     EXAMPLE
				page_id @	    [Key]  str   MAGICK image ID                                 "Hcx82jcUpM"
				subject @	          ~str   The MAGICK caption                              "red boiled crayfish on a plate ."
				h3_split @	           str   "val" for the first H3_VAL_COUNT, else "train"  "train"
		commit
			h3_magick_images
				children/	                 TYPE   DESCRIPTION                                                      EXAMPLE
					image_512 image.png	      blob   rgb_on_gray area-downsampled 1024 -> 512: 512 x 512 RGB, 8 bit   400 KB .png
					fields.json	   SUBFIELD  TYPE   DESCRIPTION                                                      EXAMPLE
						page_id @	   [Key]  str    MAGICK image ID                                                  "Hcx82jcUpM"
						split @	              str    "train", or "val": held out for validation loss                  "train"
						subject @	         ~str    The MAGICK caption                                               "red boiled crayfish on a plate ."

	h3_caption_magick	 H3-style caption of each MAGICK image, without audio, by Gemini (manifest §22, m00912)
		query sql
			SELECT page_id, image_512 FROM h3_magick_images -- H3 Magic MAGICK images,
			WHERE   h3_caption_magick_claim IS NULL         -- not yet claimed,
			    AND image_512               IS NOT NULL     -- that h3_magick_image did,
			ORDER BY split DESC, random()                   -- val first, then in random order,
			LIMIT $H3_CAPTION_BATCH_SIZE                    -- one batch at a time
		claim	h3_caption_magick_claim h3_magick_images
		command bash
			uv run --script processors/h3_caption.py "$BATCH" image $H3_CAPTION_BATCH_SIZE
		materialize	               TYPE  DESCRIPTION          EXAMPLE
			image.png image_512	    blob  The 512 x 512 image  400 KB .png
		commit
			h3_magick_images	                 TYPE   DESCRIPTION                                                          EXAMPLE
				result.json	          SUBFIELD  TYPE   DESCRIPTION                                                          EXAMPLE
					h3_caption @	             str    The H3 field, labelled. The subject only, never the background       "integrated_multimodal_description: [Shot 1] Live-action, ..."
					h3_caption_model @	         str    The captioner. " subject-only": a caption made after m00939          "gemini-3.1-pro-preview subject-only"
					h3_caption_seconds @	     float  Wall time of the Gemini calls, rewrites included                     31.2

	h3_import	 Reads H3_PEXELS_SELECTION and adds one h3_pexels_clips row per clip. No video yet
		query SELECT job_id, row_offset, row_count FROM h3_import_jobs WHERE h3_import_claim IS NULL
		claim	h3_import_claim h3_import_jobs
		command bash
			uv run --script processors/h3_import.py "$SAMPLE" ../$H3_PEXELS_SELECTION
		materialize
			input.json	              TYPE  DESCRIPTION                    EXAMPLE
				job_id @	    [Key]  str   The import job                 "slice_0"
				row_offset @	       int   First row of its slice         0
				row_count @	           int   Rows in its slice              11523
		commit
			h3_pexels_clips
				rows.parquet	                        TYPE   DESCRIPTION                                                       EXAMPLE
					pexels_id @	                  [Key]  str    Pexels video ID                                                   "8085485"
					source_path @	                     str    The Pexels MP4 on /fsx_scanline (S3 backed), not copied           "/fsx_scanline/.../Attempt_A/8085485"
					split @	                             str    "train", "val" (held out) or "spare" (fills in for static clips)  "train"
					birdseye_caption @	                 str    BirdsEye's caption of the whole video                             "A 3D printer ..."
					duration @	                         float  Seconds                                                           10.01
					fps @	                             float  Frames per second of the source                                   23.976
					flow_mean_magnitude @	             float  BirdsEye RAFT flow, whole video, 256 px                           1.89
					width @	                             int    Source width                                                      2160
					height @	                         int    Source height                                                     3840

	h3_cut_clip	 Cuts each Pexels clip's first 141 frames at 24 fps (5.875 s, H3's 17n+5 rule), 512 x 512, and 7 frames at 0..6 s
		 Scale: rp.resize_image_to_hold(512, 512), then rp.crop_image_to_square (center) (m00912). No audio
		query sql
			SELECT pexels_id, source_path FROM h3_pexels_clips                    -- Pexels clips,
			WHERE h3_cut_clip_claim IS NULL                                       -- not yet claimed,
			ORDER BY CASE split WHEN 'val' THEN 0 WHEN 'train' THEN 1 ELSE 2 END, -- val, then train, then spare,
			         random() LIMIT $H3_CUT_BATCH_SIZE                            -- one batch at a time, in random order
		claim	h3_cut_clip_claim h3_pexels_clips
		command bash
			uv run --script processors/h3_cut_clip.py "$BATCH"
		materialize
			input.json	               TYPE  DESCRIPTION           EXAMPLE
				pexels_id @	     [Key]  str   Pexels video ID       "8085485"
				source_path @	        str   The Pexels MP4        "/fsx_scanline/.../Attempt_A/8085485"
		commit
			h3_pexels_clips	                  TYPE   DESCRIPTION                                                                    EXAMPLE
				clip_512 clip.mp4	           blob   141 frames, 24 fps, 512 x 512, H.264 CRF 12, no audio                          3 MB .mp4
				frame_0s frame_0s.png	       blob   The source frame at 0 s, 512 x 512 RGB (m00917)                                400 KB .png
				frame_1s frame_1s.png	       blob   The last source frame at or before 1 s                                         400 KB .png
				frame_2s frame_2s.png	       blob   ... 2 s                                                                        400 KB .png
				frame_3s frame_3s.png	       blob   ... 3 s                                                                        400 KB .png
				frame_4s frame_4s.png	       blob   ... 4 s                                                                        400 KB .png
				frame_5s frame_5s.png	       blob   ... 5 s                                                                        400 KB .png
				frame_6s frame_6s.png	       blob   ... 6 s                                                                        400 KB .png
				result.json	            SUBFIELD  TYPE   DESCRIPTION                                                                    EXAMPLE
					motion_512 @	               float  Mean |frame k - frame k + 12| over the clip, 8-bit levels. Low: static         6.3

	h3_choose_clip	 Rewrites split: the train clips, the val clips and spare. Runs every few minutes while clips are cut, and once more after the last (processors/h3_choose_clip.py)
		 Train: the best rank average of motion_512 and birdseye_score among clips that move at least H3_MIN_MOTION: H3_PROVISIONAL_SHARE of the cut clips, then exactly H3_PEXELS_TRAIN
		query sql
			SELECT pexels_id, split, motion_512 FROM h3_pexels_clips -- Pexels clips,
			WHERE   h3_choose_clip_claim IS NULL                     -- not yet claimed (h3_choose_loop.fish unclaims every row before each run),
			    AND clip_512             IS NOT NULL                 -- that h3_cut_clip did: all of them in one run
		claim	h3_choose_clip_claim h3_pexels_clips
		command bash
			uv run --script processors/h3_choose_clip.py "$BATCH" ../$H3_PEXELS_SELECTION $H3_PEXELS_TRAIN $H3_VAL_COUNT $H3_MIN_MOTION $H3_PROVISIONAL_SHARE $H3_CHOOSE_FINAL
		materialize
			input.json	                TYPE   DESCRIPTION                                  EXAMPLE
				pexels_id @	      [Key]  str    Pexels video ID                              "8085485"
				split @	                 str    "train", "val" or "spare": the last choice   "train"
				motion_512 @	         float  Motion of the 512 x 512 clip                 6.3
		commit
			h3_pexels_clips	                 TYPE   DESCRIPTION                                                          EXAMPLE
				result.json	          SUBFIELD  TYPE   DESCRIPTION                                                          EXAMPLE
					split @	                     str    "train", "val" or "spare"                                            "train"
					h3_use @	                 str    "provisional" while clips are cut, then "final"                      "final"
					birdseye_score @	         float  PexelsPick's BirdsEye score; null if the selection has none          0.71

	h3_caption_clip	 H3-style caption of each Pexels clip (the 512 x 512 clip_512), without audio, by Gemini (manifest §22, m00912)
		query sql
			SELECT pexels_id, clip_512 FROM h3_pexels_clips -- Pexels clips,
			WHERE   h3_caption_clip_claim IS NULL           -- not yet claimed,
			    AND clip_512              IS NOT NULL       -- that h3_cut_clip did,
			    AND split IN ('val', 'train')               -- that h3_choose_clip chose (h3_import's split until then),
			ORDER BY split DESC, random()                   -- val first, then in random order,
			LIMIT $H3_CAPTION_BATCH_SIZE                    -- one batch at a time
		claim	h3_caption_clip_claim h3_pexels_clips
		command bash
			uv run --script processors/h3_caption.py "$BATCH" clip $H3_CAPTION_BATCH_SIZE
		materialize	               TYPE  DESCRIPTION   EXAMPLE
			clip.mp4 clip_512	    blob  The clip      3 MB .mp4
		commit
			h3_pexels_clips	                 TYPE   DESCRIPTION                                                          EXAMPLE
				result.json	          SUBFIELD  TYPE   DESCRIPTION                                                          EXAMPLE
					h3_caption @	             str    The H3 field, labelled: integrated_multimodal_description only       "integrated_multimodal_description: [Shot 1] Live-action, ..."
					h3_caption_model @	         str    The captioner                                                        "gemini-3.1-pro-preview"
					h3_caption_seconds @	     float  Wall time of the Gemini calls, rewrites included                     38.0


functions
	model_labels	 The journal's weight equation and sampler of eval_models rows: src/sana_alpha/journal_assets.py label_of. Lists, so one query starts one process
		args
			models.parquet
				pipeline, checkpoint, prompt_variant list_(string())
				steps list_(int64())
		return
			file labels.parquet
			column label
			type list_(string())
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src uv run --project .. python processors/model_labels.py "$SAMPLE"


queries
	view_dataset sql
		SELECT
		    struct('image' AS widget,       alpha AS src, subject   AS caption) AS alpha,
		    struct('image' AS widget, rgb_on_gray AS src, 'on gray' AS caption) AS on_gray,
		    page_id,
		    subject,
		    split,
		    nsfw,
		    hand_picked,
		    sim_score,
		    green_spill,
		    alpha_coverage,
		    vae_psnr_1024
		FROM magick_samples           -- MAGICK images
		WHERE rgb_on_gray IS NOT NULL -- that split_alpha did,
		ORDER BY page_id              -- in a fixed order

	_eval_labels sql
		SELECT unnest(tags) AS model_tag, unnest(variants) AS prompt_variant, unnest(labels) AS label FROM (
		    SELECT
		        array_agg(model_tag      ORDER BY model_tag) AS tags,
		        array_agg(prompt_variant ORDER BY model_tag) AS variants,
		        model_labels(
		            pipeline       => array_agg(pipeline       ORDER BY model_tag),
		            checkpoint     => array_agg(checkpoint     ORDER BY model_tag),
		            steps          => array_agg(steps          ORDER BY model_tag),
		            prompt_variant => array_agg(prompt_variant ORDER BY model_tag)
		        ) AS labels
		    FROM eval_models
		)

	view_eval_models sql
		SELECT
		    m.model_tag,
		    l.label,
		    m.pipeline,
		    m.checkpoint,
		    m.steps,
		    m.prompt_variant,
		    coalesce(m.eval_set, '$EVAL_SET') AS eval_set,
		    count(g.image)                    AS images,
		    avg(g.iou)                        AS iou,
		    avg(g.exterior_gray_error)        AS exterior_gray_error,
		    avg(g.border_gray_error)          AS border_gray_error,
		    avg(g.border_std)                 AS border_std,
		    avg(g.foreground_fraction)        AS foreground_fraction,
		    avg(g.seconds)                    AS seconds
		FROM eval_models m                                                                             -- Each eval model,
		JOIN _eval_labels l          ON l.model_tag = m.model_tag                                      -- with its label
		LEFT JOIN eval_generations g ON g.model_tag = m.model_tag                                      -- and the mean metrics of its images,
		GROUP BY m.model_tag, l.label, m.pipeline, m.checkpoint, m.steps, m.prompt_variant, m.eval_set -- one row per model,
		ORDER BY m.model_tag                                                                           -- in a fixed order

	view_eval_images sql
		SELECT
		    struct('image' AS widget, s.alpha AS src, 'matte' AS caption) AS matte,
		    struct('image' AS widget, g.image AS src, l.label AS caption) AS image,
		    g.model_tag,
		    g.page_id,
		    s.split,
		    g.prompt,
		    g.iou,
		    g.exterior_gray_error
		FROM eval_generations g                          -- Each generated eval image,
		JOIN _eval_labels l   ON l.model_tag = g.model_tag -- with its model's label
		JOIN magick_samples s ON s.page_id   = g.page_id   -- and its matte,
		WHERE g.image IS NOT NULL                          -- that generate_eval did,
		ORDER BY g.page_id, g.model_tag                    -- one eval image at a time

	view_gallery sql
		-- Mirrors journal/gallery_<run>.html (src/sana_alpha/gallery.py): one row per control step, showcase item and prompt,
		-- one column per model. Each image's caption is its model's label. Stock columns repeat on the rows of each control step
		WITH FUNCTION shot(src, role, label, name) AS (struct(
		    'image'                                        AS widget,
		    first_value(src)   FILTER (WHERE role = name) AS src,
		    first_value(label) FILTER (WHERE role = name) AS caption
		))
		WITH named AS (
		    SELECT g.page_id, g.caption, g.prompt, g.image, l.prompt_variant, l.label,
		           regexp_match(l.model_tag, '^show_(.*?)(_detailed)?$')[1] AS name  -- show_v1_step001500_lam0.5_detailed -> v1_step001500_lam0.5
		    FROM eval_generations g                                              -- Each generated image,
		    JOIN _eval_labels l ON l.model_tag = g.model_tag                     -- with its model's label,
		    WHERE   starts_with(l.model_tag, 'show_')                            -- of a showcase model,
		        AND g.image IS NOT NULL                                          -- that generate_eval did
		), tagged AS (
		    SELECT *,
		           regexp_match(name, '^(.*_step[0-9]+)_')[1]                AS run_step, -- v1_step001500; NULL for a stock model
		           coalesce(regexp_match(name, '_step[0-9]+_(.*)$')[1], name) AS role      -- lam0.5, sprint_lam0_1step or stock_sprint1
		    FROM named
		)
		SELECT
		    r.run_step,
		    t.page_id,
		    CASE s.split WHEN 'eval' THEN 'held-out' ELSE s.split END             AS split,
		    t.prompt_variant,
		    first_value(t.prompt)                                                 AS prompt,
		    struct('image' AS widget, first_value(s.alpha)       AS src, 'matte'          AS caption) AS matte,
		    struct('image' AS widget, first_value(s.rgb_on_gray) AS src, 'MAGICK on gray' AS caption) AS on_gray,
		    shot(t.image, t.role, t.label, 'stock_sprint1')           AS stock_sprint_1step,
		    shot(t.image, t.role, t.label, 'stock_sprint2')           AS stock_sprint_2step,
		    shot(t.image, t.role, t.label, 'stock_teacher20')         AS stock_teacher,
		    shot(t.image, t.role, t.label, 'lam1')                    AS teacher_lam1,
		    shot(t.image, t.role, t.label, 'lam0.75')                 AS teacher_lam075,
		    shot(t.image, t.role, t.label, 'lam0.5')                  AS teacher_lam05,
		    shot(t.image, t.role, t.label, 'lam0.25')                 AS teacher_lam025,
		    shot(t.image, t.role, t.label, 'lam0')                    AS teacher_lam0,
		    shot(t.image, t.role, t.label, 'sprint_lam1_2step')       AS sprint_2step_lam1,
		    shot(t.image, t.role, t.label, 'sprint_lam0.75_2step')    AS sprint_2step_lam075,
		    shot(t.image, t.role, t.label, 'sprint_lam0.5_2step')     AS sprint_2step_lam05,
		    shot(t.image, t.role, t.label, 'sprint_lam0_2step')       AS sprint_2step_lam0,
		    shot(t.image, t.role, t.label, 'sprint_lam1_1step')       AS sprint_1step_lam1,
		    shot(t.image, t.role, t.label, 'sprint_lam0.75_1step')    AS sprint_1step_lam075,
		    shot(t.image, t.role, t.label, 'sprint_lam0.5_1step')     AS sprint_1step_lam05,
		    shot(t.image, t.role, t.label, 'sprint_lam0_1step')       AS sprint_1step_lam0
		FROM tagged t                                                                         -- Each showcase image,
		JOIN (SELECT DISTINCT run_step FROM tagged WHERE run_step IS NOT NULL) r              -- on the row of its control step
		     ON t.run_step = r.run_step OR t.run_step IS NULL                                 --     (a stock image on the row of each step),
		JOIN magick_samples s ON s.page_id = t.page_id                                        -- with its matte,
		GROUP BY r.run_step, t.page_id, s.split, t.prompt_variant                             -- one row per step, item and prompt,
		ORDER BY r.run_step, split, t.page_id, t.prompt_variant DESC                          -- held-out items first, caption before detailed prompt
	_no_trimask_items sql
		-- No trimask_<method> uses these: the training images of the showcase set (resources/showcase, page_residue 1),
		-- and R8UtVjdUyU, a train matte with no pixel above 0.5 (generate() refuses it)
		SELECT unnest(make_array('0pUpyMQaCk', '5eMH8a6Vjv', 'AgfOUN3DeM', 'G5x2u0fPL8', 'Hh8q5lgcAQ', 'Io48JpfRrF', 'IotKdbdV6T', 'JGCoeNF4Tz', 'KkgEsWzE8g', 'N3JnvKPzOa', 'NqdDLAYhG0', 'Of2DUBiPIs', 'QJcPoXEAP4', 'RMcfP2pbC9', 'StEZ525CCF', 'TbTuikHxJT', 'UFzmrKcIez', 'WLDj1YvRWz', 'WvG6E6hnyA', 'Y5KTHH1ThN', 'YYOAlb6C3u', 'YhFRkqnzo4', 'aoKJjZiw5t', 'ebSe48PO7c', 'fdNNerLubw', 'gibvvaoLuT', 'hRhqVbDC6h', 'jjRpuZm4XX', 'ksBFHMzGfM', 'l2ynv1mqir', 'mxCEBNOGGW', 'oswuq3J8bi', 'p4auHb5Y3v', 'swSl8ww8WG', 'ymcgJ1MZH4', 'z3PrRRIvM4', 'zDR3g9P014', 'zZYNHaRp8O', 'R8UtVjdUyU')) AS page_id

	view_trimasks sql
		-- One row per image of trimask_augmentations: its matte, then the trimask of each method that used it (variant 0).
		-- Each caption is the trimask's unknown (gray) fraction and its hyperparameters. Images with the most methods come first
		WITH FUNCTION shot(src, method, caption, name) AS (struct(
		    'image'                                          AS widget,
		    first_value(src)     FILTER (WHERE method = name) AS src,
		    first_value(caption) FILTER (WHERE method = name) AS caption
		))
		WITH captioned AS (
		    SELECT *, concat('gray ', round(gray_fraction, 2), ' ', params) AS caption
		    FROM trimask_augmentations -- Each trimask,
		    WHERE variant = 0          -- the first variant
		)
		SELECT
		    t.page_id,
		    count(*)                                                                   AS methods,
		    struct('image' AS widget, first_value(s.alpha) AS src, 'matte' AS caption) AS matte,
		    shot(t.trimask, t.method, t.caption, 'morph_band')                         AS morph_band,
		    shot(t.trimask, t.method, t.caption, 'noisy_band')                         AS noisy_band,
		    shot(t.trimask, t.method, t.caption, 'blur_quantize')                      AS blur_quantize,
		    shot(t.trimask, t.method, t.caption, 'scribbles')                          AS scribbles,
		    shot(t.trimask, t.method, t.caption, 'bbox_unknown')                       AS bbox_unknown,
		    shot(t.trimask, t.method, t.caption, 'convex_hull')                        AS convex_hull,
		    shot(t.trimask, t.method, t.caption, 'grid_coarsen')                       AS grid_coarsen,
		    shot(t.trimask, t.method, t.caption, 'polygon_simplify')                   AS polygon_simplify,
		    shot(t.trimask, t.method, t.caption, 'unknown_patches')                    AS unknown_patches,
		    shot(t.trimask, t.method, t.caption, 'fuzzy_ramp')                         AS fuzzy_ramp,
		    shot(t.trimask, t.method, t.caption, 'combo_union')                        AS combo_union,
		    shot(t.trimask, t.method, t.caption, 'combo_chain')                        AS combo_chain,
		    shot(t.trimask, t.method, t.caption, 'skeleton_strokes')                   AS skeleton_strokes,
		    shot(t.trimask, t.method, t.caption, 'partial_view')                       AS partial_view,
		    shot(t.trimask, t.method, t.caption, 'bilateral_blur')                     AS bilateral_blur,
		    shot(t.trimask, t.method, t.caption, 'random_stack')                       AS random_stack,
		    shot(t.trimask, t.method, t.caption, 'perlin_warp')                        AS perlin_warp,
		    shot(t.trimask, t.method, t.caption, 'op_chain')                           AS op_chain,
		    shot(t.trimask, t.method, t.caption, 'glass_ripple')                       AS glass_ripple,
		    shot(t.trimask, t.method, t.caption, 'original')                           AS original,
		    shot(t.trimask, t.method, t.caption, 'threshold')                          AS threshold,
		    avg(t.white_fraction)                                                      AS white_fraction,
		    avg(t.gray_fraction)                                                       AS gray_fraction,
		    avg(t.black_fraction)                                                      AS black_fraction
		FROM captioned t                               -- Each trimask,
		JOIN magick_samples s ON s.page_id = t.page_id -- with its matte,
		GROUP BY t.page_id                             -- one row per image,
		ORDER BY methods DESC, t.page_id               -- the images with the most methods first

	 H3 MAGIC PROJECT (manifest §22)

	view_h3_magick sql
		SELECT
		    struct('image' AS widget, image_512 AS src, subject AS caption) AS image_512,
		    page_id,
		    split,
		    subject,
		    h3_caption
		FROM h3_magick_images         -- H3 Magic MAGICK images
		WHERE image_512 IS NOT NULL   -- that h3_magick_image did,
		ORDER BY split DESC, page_id  -- val first, in a fixed order

	view_h3_pexels sql
		SELECT
		    struct('video' AS widget, clip_512 AS src, pexels_id AS caption) AS clip_512,
		    struct('image' AS widget, frame_0s AS src, '0 s'     AS caption) AS frame_0s,
		    struct('image' AS widget, frame_3s AS src, '3 s'     AS caption) AS frame_3s,
		    struct('image' AS widget, frame_6s AS src, '6 s'     AS caption) AS frame_6s,
		    pexels_id,
		    split,
		    h3_use,
		    motion_512,
		    birdseye_score,
		    h3_caption,
		    birdseye_caption
		FROM h3_pexels_clips                                -- H3 Magic Pexels clips
		WHERE clip_512 IS NOT NULL                          -- that h3_cut_clip did,
		ORDER BY coalesce(h3_use, split), motion_512 DESC   -- by use, most motion first


