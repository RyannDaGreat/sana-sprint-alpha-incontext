					why_win @	              str     The prediction and its evidence, written before running              "FLUX.2 decoder fixes texture ..."
					ablation_of @	          str     The method_id that it isolates, or ""                                ""
					ablation_change @	      str     The one thing changed                                                ""
					space @	                  str     rgb, flux2, h3dec ...                                                "rgb"
					conditioning @	          str     concat, adagn, crossattn ...                                         "concat"
					text_cond @	              bool    The decoder takes a text prompt                                      false
					steps @	                  int     Sampling steps at eval                                               1
					params @	              int     Parameters                                                           86000000
					train_gpu_hours @	      float   GPU hours of training                                                0.0
					train_gpu_type @	      str     genome.json gpu_type                                                 "A100"
					how_to_load @	          str     How to load it                                                       "model.py load(device)"
					verdict @	              str     The visual verdict                                                   "texture is sharper ..."
					why_held_or_failed @	  str     Why it was held or failed                                            ""
					psnr @	                  float   Seed 0 against the source, dB                                        29.84
					ssim @	                  float   SSIM                                                                 0.912
					lpips_alex @	          float   LPIPS (alex)                                                         0.061
					lpips_vgg @	              float   LPIPS (vgg)                                                          0.093
					dists @	                  float   DISTS                                                                0.071
					de2000 @	              float   CIEDE2000                                                            2.41
					flux_mse @	              float   FLUX.2 latent MSE                                                    0.0123
					sharp_grad @	          float   Sharpness: mean gradient                                             14.2
					sharp_fft @	              float   Sharpness: high-frequency energy                                     0.021
					psnr_mean8 @	          float   PSNR of the mean of 8 seeds, dB                                      30.10
					dists_mean8 @	          float   DISTS of the mean of 8 seeds                                         0.065
					ms_per_image @	          float   Time per image                                                       21.0
					gpu_type @	              str     GPU of the eval                                                      "A100"
					eval_steps @	          int     Steps of the eval                                                    1
					n_samples @	              int     Test samples scored                                                  68
					latent_kind @	          str     "sample" or "mode"                                                   "sample"
					folder @	              str     The candidate folder, from the repo root                             "agents/.scratchpad/diffdec/g0/h3_decoder"
					results_sha256 @	      str     sha256 (hex) of results.json, null while it trains                   "3f9a…"
			dd_jobs
				result.json	   SUBFIELD  TYPE  DESCRIPTION                                                        EXAMPLE
					samples_stamp @	      str   sha256 of samples.json, null while the test set is incomplete      "3f9a…"

	dd_import_samples	 Imports the test set into dd_samples: the metadata and, byte for byte, the source, the H3 latent and the FLUX.2 latent of each sample. CPU only
		query sql
			SELECT job_id, samples_stamp FROM dd_jobs -- The job,
			WHERE dd_import_samples_claim IS NULL     -- not yet claimed (the launcher unclaims a changed test set),
			LIMIT 1                                   -- one at a time
		claim	dd_import_samples_claim dd_jobs
		command bash
			uv run --script processors/dd_import_samples.py "$SAMPLE" .. $DD_DIR
		materialize
			input.json	           TYPE  DESCRIPTION                                            EXAMPLE
				job_id @	 [Key]  str   The one job                                            "find"
				samples_stamp @	    str   sha256 of samples.json, null: not complete yet         "3f9a…"
		commit
			dd_samples
				rows.parquet	             TYPE    DESCRIPTION                                          EXAMPLE
					sample_id @	       [Key]  str     The sample                                           "pexels_8620887_f070"
					origin @	              str     pexels_val, magick, pexbg or pexels_spare            "pexels_val"
					side @	                  str     The side of the test set                             "val"
					pexels_id @	              str     Pexels clip, null for a MAGICK image                 "8620887"
					page_id @	              str     MAGICK image ID, null for a Pexels clip              "Hcx82jcUpM"
					source_table @	          str     The BlueJay table of the source                      "h3_enc_samples"
					has_upper_bound @	      bool    optimized_l1vgg scores it                            true
					source_png @	          blob    Byte for byte source.png                             1.0 MB .png
					latent @	              blob    Byte for byte latent.safetensors                     200 KB .safetensors
					flux2 @	                  blob    Byte for byte flux2.safetensors                      520 KB .safetensors
			dd_jobs
				result.json	                   SUBFIELD  TYPE  DESCRIPTION                              EXAMPLE
					imported_samples_stamp @	          str   The samples_stamp that it imported       "3f9a…"

	dd_import_renders	 Imports one scored candidate's renders of the test samples into dd_renders, with error maps and per-sample scores. CPU only
		query sql
			SELECT method_id, folder, results_sha256 FROM dd_methods -- Candidates,
			WHERE dd_import_renders_claim IS NULL                    -- not yet claimed (the launcher unclaims a changed candidate),
			AND results_sha256 IS NOT NULL                           -- that have scores (a candidate that trains has none),
			ORDER BY dists                                           -- best DISTS first,
			LIMIT 1                                                  -- one at a time
		claim	dd_import_renders_claim dd_methods
		command bash
			uv run --script processors/dd_import_renders.py "$SAMPLE" ..
		materialize
			input.json	             TYPE  DESCRIPTION                        EXAMPLE
				method_id @	   [Key]  str   The candidate                      "g0/h3_decoder"
				folder @	          str   Its folder, from the repo root     "agents/.scratchpad/diffdec/g0/h3_decoder"
				results_sha256 @	 ~str   sha256 (hex) of its results.json   "3f9a…"
		commit
			dd_renders
				rows.parquet	                 TYPE    DESCRIPTION                                       EXAMPLE
					render_id @	           [Key]  str     method_id|sample_id                               "g0/h3_decoder|pexels_8620887_f070"
					method_id @	                  str     The candidate                                     "g0/h3_decoder"
					sample_id @	                  str     The test sample                                   "pexels_8620887_f070"
					render_png @	              blob    Byte for byte renders/<sample_id>.png             1.0 MB .png
					mean8_png @	                  blob    Byte for byte renders_mean8/<sample_id>.png       1.0 MB .png
					error_png @	                  blob    |render - source| x 4 per channel                 1.1 MB .png
					psnr @	                      float   Seed 0 against the source, dB (per_sample)        27.31
					ssim @	                      float   SSIM (per_sample)                                 0.894
					lpips_alex @	              float   LPIPS alex (per_sample)                           0.072
					lpips_vgg @	                  float   LPIPS vgg (per_sample)                            0.101
					dists @	                      float   DISTS (per_sample)                                0.081
					de2000 @	                  float   CIEDE2000 (per_sample)                            2.9
					flux_mse @	                  float   FLUX.2 latent MSE (per_sample)                    0.0151
					sharp_grad @	              float   Sharpness: mean gradient (per_sample)             13.8
					sharp_fft @	                  float   Sharpness: high-frequency energy (per_sample)     0.020
					psnr_mean8 @	              float   PSNR of the mean of 8 seeds (per_sample)          27.9
					dists_mean8 @	              float   DISTS of the mean of 8 seeds (per_sample)         0.075
			dd_methods
				result.json	   SUBFIELD  TYPE  DESCRIPTION                           EXAMPLE
					renders_sha256 @	 ~str   The results_sha256 that it imported   "3f9a…"
					renders @	          int   Renders imported                      60

functions
	model_labels	 The journal's weight equation and sampler of eval_models rows: src/sana_alpha/journal_assets.py label_of. Lists, so one query starts one process
		args
			models.parquet
				pipeline, checkpoint, prompt_variant list_(string())
				steps list_(int64())
		return
			file labels.parquet
			column label
			type list_(string())
		command bash
			env -u UV_PROJECT_ENVIRONMENT PYTHONPATH=../src uv run --project .. python processors/model_labels.py "$SAMPLE"


queries
	view_dataset sql
		SELECT
		    struct('image' AS widget,       alpha AS src, subject   AS caption) AS alpha,
		    struct('image' AS widget, rgb_on_gray AS src, 'on gray' AS caption) AS on_gray,
		    page_id,
		    subject,
		    split,
		    nsfw,
		    hand_picked,
		    sim_score,
		    green_spill,
		    alpha_coverage,
		    vae_psnr_1024
		FROM magick_samples           -- MAGICK images
		WHERE rgb_on_gray IS NOT NULL -- that split_alpha did,
		ORDER BY page_id              -- in a fixed order

	_eval_labels sql
		SELECT unnest(tags) AS model_tag, unnest(variants) AS prompt_variant, unnest(labels) AS label FROM (
		    SELECT
		        array_agg(model_tag      ORDER BY model_tag) AS tags,
		        array_agg(prompt_variant ORDER BY model_tag) AS variants,
		        model_labels(
		            pipeline       => array_agg(pipeline       ORDER BY model_tag),
		            checkpoint     => array_agg(checkpoint     ORDER BY model_tag),
		            steps          => array_agg(steps          ORDER BY model_tag),
		            prompt_variant => array_agg(prompt_variant ORDER BY model_tag)
		        ) AS labels
		    FROM eval_models
		)

	view_eval_models sql
		SELECT
		    m.model_tag,
		    l.label,
		    m.pipeline,
		    m.checkpoint,
		    m.steps,
		    m.prompt_variant,
		    coalesce(m.eval_set, '$EVAL_SET') AS eval_set,
		    count(g.image)                    AS images,
		    avg(g.iou)                        AS iou,
		    avg(g.exterior_gray_error)        AS exterior_gray_error,
		    avg(g.border_gray_error)          AS border_gray_error,
		    avg(g.border_std)                 AS border_std,
		    avg(g.foreground_fraction)        AS foreground_fraction,
		    avg(g.seconds)                    AS seconds
		FROM eval_models m                                                                             -- Each eval model,
		JOIN _eval_labels l          ON l.model_tag = m.model_tag                                      -- with its label
		LEFT JOIN eval_generations g ON g.model_tag = m.model_tag                                      -- and the mean metrics of its images,
		GROUP BY m.model_tag, l.label, m.pipeline, m.checkpoint, m.steps, m.prompt_variant, m.eval_set -- one row per model,
		ORDER BY m.model_tag                                                                           -- in a fixed order

	view_eval_images sql
		SELECT
		    struct('image' AS widget, s.alpha AS src, 'matte' AS caption) AS matte,
		    struct('image' AS widget, g.image AS src, l.label AS caption) AS image,
		    g.model_tag,
		    g.page_id,
		    s.split,
		    g.prompt,
		    g.iou,
		    g.exterior_gray_error
		FROM eval_generations g                          -- Each generated eval image,
		JOIN _eval_labels l   ON l.model_tag = g.model_tag -- with its model's label
		JOIN magick_samples s ON s.page_id   = g.page_id   -- and its matte,
		WHERE g.image IS NOT NULL                          -- that generate_eval did,
		ORDER BY g.page_id, g.model_tag                    -- one eval image at a time

	view_gallery sql
		-- Mirrors journal/gallery_<run>.html (src/sana_alpha/gallery.py): one row per control step, showcase item and prompt,
		-- one column per model. Each image's caption is its model's label. Stock columns repeat on the rows of each control step
		WITH FUNCTION shot(src, role, label, name) AS (struct(
		    'image'                                        AS widget,
		    first_value(src)   FILTER (WHERE role = name) AS src,
		    first_value(label) FILTER (WHERE role = name) AS caption
		))
		WITH named AS (
		    SELECT g.page_id, g.caption, g.prompt, g.image, l.prompt_variant, l.label,
		           regexp_match(l.model_tag, '^show_(.*?)(_detailed)?$')[1] AS name  -- show_v1_step001500_lam0.5_detailed -> v1_step001500_lam0.5
		    FROM eval_generations g                                              -- Each generated image,
		    JOIN _eval_labels l ON l.model_tag = g.model_tag                     -- with its model's label,
		    WHERE   starts_with(l.model_tag, 'show_')                            -- of a showcase model,
		        AND g.image IS NOT NULL                                          -- that generate_eval did
		), tagged AS (
		    SELECT *,
		           regexp_match(name, '^(.*_step[0-9]+)_')[1]                AS run_step, -- v1_step001500; NULL for a stock model
		           coalesce(regexp_match(name, '_step[0-9]+_(.*)$')[1], name) AS role      -- lam0.5, sprint_lam0_1step or stock_sprint1
		    FROM named
		)
		SELECT
		    r.run_step,
		    t.page_id,
		    CASE s.split WHEN 'eval' THEN 'held-out' ELSE s.split END             AS split,
		    t.prompt_variant,
		    first_value(t.prompt)                                                 AS prompt,
		    struct('image' AS widget, first_value(s.alpha)       AS src, 'matte'          AS caption) AS matte,
		    struct('image' AS widget, first_value(s.rgb_on_gray) AS src, 'MAGICK on gray' AS caption) AS on_gray,
		    shot(t.image, t.role, t.label, 'stock_sprint1')           AS stock_sprint_1step,
		    shot(t.image, t.role, t.label, 'stock_sprint2')           AS stock_sprint_2step,
		    shot(t.image, t.role, t.label, 'stock_teacher20')         AS stock_teacher,
		    shot(t.image, t.role, t.label, 'lam1')                    AS teacher_lam1,
		    shot(t.image, t.role, t.label, 'lam0.75')                 AS teacher_lam075,
		    shot(t.image, t.role, t.label, 'lam0.5')                  AS teacher_lam05,
		    shot(t.image, t.role, t.label, 'lam0.25')                 AS teacher_lam025,
		    shot(t.image, t.role, t.label, 'lam0')                    AS teacher_lam0,
		    shot(t.image, t.role, t.label, 'sprint_lam1_2step')       AS sprint_2step_lam1,
		    shot(t.image, t.role, t.label, 'sprint_lam0.75_2step')    AS sprint_2step_lam075,
		    shot(t.image, t.role, t.label, 'sprint_lam0.5_2step')     AS sprint_2step_lam05,
		    shot(t.image, t.role, t.label, 'sprint_lam0_2step')       AS sprint_2step_lam0,
		    shot(t.image, t.role, t.label, 'sprint_lam1_1step')       AS sprint_1step_lam1,
		    shot(t.image, t.role, t.label, 'sprint_lam0.75_1step')    AS sprint_1step_lam075,
		    shot(t.image, t.role, t.label, 'sprint_lam0.5_1step')     AS sprint_1step_lam05,
		    shot(t.image, t.role, t.label, 'sprint_lam0_1step')       AS sprint_1step_lam0
		FROM tagged t                                                                         -- Each showcase image,
		JOIN (SELECT DISTINCT run_step FROM tagged WHERE run_step IS NOT NULL) r              -- on the row of its control step
		     ON t.run_step = r.run_step OR t.run_step IS NULL                                 --     (a stock image on the row of each step),
		JOIN magick_samples s ON s.page_id = t.page_id                                        -- with its matte,
		GROUP BY r.run_step, t.page_id, s.split, t.prompt_variant                             -- one row per step, item and prompt,
		ORDER BY r.run_step, split, t.page_id, t.prompt_variant DESC                          -- held-out items first, caption before detailed prompt
	_no_trimask_items sql
		-- No trimask_<method> uses these: the training images of the showcase set (resources/showcase, page_residue 1),
		-- and R8UtVjdUyU, a train matte with no pixel above 0.5 (generate() refuses it)
		SELECT unnest(make_array('0pUpyMQaCk', '5eMH8a6Vjv', 'AgfOUN3DeM', 'G5x2u0fPL8', 'Hh8q5lgcAQ', 'Io48JpfRrF', 'IotKdbdV6T', 'JGCoeNF4Tz', 'KkgEsWzE8g', 'N3JnvKPzOa', 'NqdDLAYhG0', 'Of2DUBiPIs', 'QJcPoXEAP4', 'RMcfP2pbC9', 'StEZ525CCF', 'TbTuikHxJT', 'UFzmrKcIez', 'WLDj1YvRWz', 'WvG6E6hnyA', 'Y5KTHH1ThN', 'YYOAlb6C3u', 'YhFRkqnzo4', 'aoKJjZiw5t', 'ebSe48PO7c', 'fdNNerLubw', 'gibvvaoLuT', 'hRhqVbDC6h', 'jjRpuZm4XX', 'ksBFHMzGfM', 'l2ynv1mqir', 'mxCEBNOGGW', 'oswuq3J8bi', 'p4auHb5Y3v', 'swSl8ww8WG', 'ymcgJ1MZH4', 'z3PrRRIvM4', 'zDR3g9P014', 'zZYNHaRp8O', 'R8UtVjdUyU')) AS page_id

	view_trimasks sql
		-- One row per image of trimask_augmentations: its matte, then the trimask of each method that used it (variant 0).
		-- Each caption is the trimask's unknown (gray) fraction and its hyperparameters. Images with the most methods come first
		WITH FUNCTION shot(src, method, caption, name) AS (struct(
		    'image'                                          AS widget,
		    first_value(src)     FILTER (WHERE method = name) AS src,
		    first_value(caption) FILTER (WHERE method = name) AS caption
		))
		WITH captioned AS (
		    SELECT *, concat('gray ', round(gray_fraction, 2), ' ', params) AS caption
		    FROM trimask_augmentations -- Each trimask,
		    WHERE variant = 0          -- the first variant
		)
		SELECT
		    t.page_id,
		    count(*)                                                                   AS methods,
		    struct('image' AS widget, first_value(s.alpha) AS src, 'matte' AS caption) AS matte,
		    shot(t.trimask, t.method, t.caption, 'morph_band')                         AS morph_band,
		    shot(t.trimask, t.method, t.caption, 'noisy_band')                         AS noisy_band,
		    shot(t.trimask, t.method, t.caption, 'blur_quantize')                      AS blur_quantize,
		    shot(t.trimask, t.method, t.caption, 'scribbles')                          AS scribbles,
		    shot(t.trimask, t.method, t.caption, 'bbox_unknown')                       AS bbox_unknown,
		    shot(t.trimask, t.method, t.caption, 'convex_hull')                        AS convex_hull,
		    shot(t.trimask, t.method, t.caption, 'grid_coarsen')                       AS grid_coarsen,
		    shot(t.trimask, t.method, t.caption, 'polygon_simplify')                   AS polygon_simplify,
		    shot(t.trimask, t.method, t.caption, 'unknown_patches')                    AS unknown_patches,
		    shot(t.trimask, t.method, t.caption, 'fuzzy_ramp')                         AS fuzzy_ramp,
		    shot(t.trimask, t.method, t.caption, 'combo_union')                        AS combo_union,
		    shot(t.trimask, t.method, t.caption, 'combo_chain')                        AS combo_chain,
		    shot(t.trimask, t.method, t.caption, 'skeleton_strokes')                   AS skeleton_strokes,
		    shot(t.trimask, t.method, t.caption, 'partial_view')                       AS partial_view,
		    shot(t.trimask, t.method, t.caption, 'bilateral_blur')                     AS bilateral_blur,
		    shot(t.trimask, t.method, t.caption, 'random_stack')                       AS random_stack,
		    shot(t.trimask, t.method, t.caption, 'perlin_warp')                        AS perlin_warp,
		    shot(t.trimask, t.method, t.caption, 'op_chain')                           AS op_chain,
		    shot(t.trimask, t.method, t.caption, 'glass_ripple')                       AS glass_ripple,
		    shot(t.trimask, t.method, t.caption, 'original')                           AS original,
		    shot(t.trimask, t.method, t.caption, 'threshold')                          AS threshold,
		    avg(t.white_fraction)                                                      AS white_fraction,
		    avg(t.gray_fraction)                                                       AS gray_fraction,
		    avg(t.black_fraction)                                                      AS black_fraction
		FROM captioned t                               -- Each trimask,
		JOIN magick_samples s ON s.page_id = t.page_id -- with its matte,
		GROUP BY t.page_id                             -- one row per image,
		ORDER BY methods DESC, t.page_id               -- the images with the most methods first

	 H3 MAGIC PROJECT (manifest §22)

	view_h3_magick sql
		SELECT
		    struct('image' AS widget, image_512 AS src, subject AS caption) AS image_512,
		    page_id,
		    split,
		    subject,
		    h3_caption
		FROM h3_magick_images         -- H3 Magic MAGICK images
		WHERE image_512 IS NOT NULL   -- that h3_magick_image did,
		ORDER BY split DESC, page_id  -- val first, in a fixed order

	view_h3_pexels sql
		SELECT
		    struct('video' AS widget, clip_512 AS src, pexels_id AS caption) AS clip_512,
		    struct('image' AS widget, frame_0s AS src, '0 s'     AS caption) AS frame_0s,
		    struct('image' AS widget, frame_3s AS src, '3 s'     AS caption) AS frame_3s,
		    struct('image' AS widget, frame_6s AS src, '6 s'     AS caption) AS frame_6s,
		    pexels_id,
		    split,
		    h3_use,
		    motion_512,
		    birdseye_score,
		    h3_caption,
		    birdseye_caption
		FROM h3_pexels_clips                                -- H3 Magic Pexels clips
		WHERE clip_512 IS NOT NULL                          -- that h3_cut_clip did,
		ORDER BY coalesce(h3_use, split), motion_512 DESC   -- by use, most motion first

	view_h3_encoder sql
		SELECT
		    struct('image' AS widget, coalesce(r.image, r.frame_070) AS src, r.run_id  AS caption) AS decode,
		    struct('image' AS widget, s.source                       AS src, 'source'  AS caption) AS source,
		    struct('video' AS widget, r.video                        AS src, r.run_id  AS caption) AS video,
		    r.sample_id,
		    r.run_id,
		    u.method,
		    u.objective,
		    u.prior_weight,
		    s.kind,
		    s.origin,
		    r.psnr,
		    r.ssim,
		    r.lpips_alex,
		    r.lpips_vgg,
		    r.dists,
		    r.flux_mse,
		    r.de2000,
		    r.sharp_grad,
		    r.flicker,
		    r.z_dev_std
		FROM h3_enc_results r                              -- Each decode of the encoder study,
		JOIN h3_enc_samples s ON s.sample_id = r.sample_id -- with its source
		JOIN h3_enc_runs    u ON u.run_id    = r.run_id    -- and its run,
		ORDER BY s.kind, r.sample_id, u.method, r.run_id   -- sample by sample, the encoder first


	 FASTDEC GA (manifest §22, m00998)

	view_fd_leaderboard sql
		SELECT
		    struct('video' AS widget, r.mp4 AS src, concat(m.method_id, ' ', coalesce(s.tier, '')) AS caption) AS clip_8620887,
		    m.method_id,
		    s.tier,
		    s.ms_clean,
		    s.speedup,
		    s.ssim_vs_full,
		    s.lpips_vs_full,
		    s.psnr_vs_full,
		    s.ssim_vs_source,
		    s.lpips_vs_source,
		    s.psnr_vs_source,
		    s.sharp_grad,
		    s.sharp_fft,
		    s.flicker,
		    s.eval_id,
		    m.round,
		    m.tier_target,
		    m.kind,
		    m.status,
		    m.parents,
		    m.change,
		    m.verdict
		FROM fd_methods m                                                           -- Each method,
		JOIN fd_scores s ON s.method_id = m.method_id                               -- with its scores,
		LEFT JOIN fd_renders r ON r.method_id = m.method_id AND r.clip_id = '8620887' -- and its render of the first page clip, if it has one
		ORDER BY CASE s.tier WHEN 'T100' THEN 0 WHEN 'T30' THEN 1 WHEN 'T10' THEN 2  -- fastest tier first,
		                     WHEN 'slow' THEN 3 WHEN 'untimed' THEN 4 ELSE 5 END,   -- the references last,
		         s.ssim_vs_full DESC                                                -- then the most like the full decode first

	 LATENT COMPOSITOR (manifest §24)

	view_lc_methods sql
		-- The leaderboard: one row per scored candidate, best fitness (decoded PSNR on EVAL) first, with its render of the first test sample
		SELECT
		    struct('image' AS widget, r.decoded_png AS src, concat(m.method_id, ' ', round(r.psnr, 2), ' dB') AS caption) AS test_1000000,
		    m.method_id,
		    m.name,
		    m.track,
		    m.psnr,
		    m.psnr_hard_soft,
		    m.psnr_hard_contrast,
		    m.psnr_random,
		    m.ssim,
		    m.lpips,
		    m.flux2_mse,
		    m.latent_mse,
		    m.oracle_psnr,
		    m.params,
		    m.ms_fwd,
		    m.ms_fwdbwd,
		    m.fg_key,
		    m.round,
		    m.wildcard,
		    m.parents,
		    m.what,
		    m.how,
		    m.cites,
		    m.verdict,
		    m.renders,
		    m.folder
		FROM lc_methods m                                                                    -- Each scored candidate,
		LEFT JOIN lc_renders r ON r.method_id = m.method_id AND r.sample_id = 'test_1000000' -- with its render of the first (hardest) test sample, if it has one,
		ORDER BY m.psnr DESC                                                                 -- best fitness first

	view_lc_compare sql
		-- One row per decoded test sample: its matte, foreground, background, true composite and oracle, then the decode and the error map
		-- (|decoded - true| x 4) of the 12 best candidates by fitness (decoded PSNR on EVAL), best first. view_lc_renders shows every candidate
		WITH FUNCTION shot(src, rank, caption, k) AS (struct(
		    'image'                                      AS widget,
		    first_value(src)     FILTER (WHERE rank = k) AS src,
		    first_value(caption) FILTER (WHERE rank = k) AS caption
		))
		WITH ranked AS (
		    SELECT method_id, row_number() OVER (ORDER BY psnr DESC, method_id) AS rank -- The fitness rank
		    FROM lc_methods                                                             -- of each scored candidate
		    WHERE renders IS NOT NULL                                                   -- that lc_import_renders did
		), shots AS (
		    SELECT r.sample_id, r.decoded_png, r.error_png, k.rank,                                -- The images and the rank,
		           concat(k.rank, '. ', r.method_id, ' ', round(r.psnr, 2), ' dB') AS caption,     -- a caption
		           concat('error x4 ', r.method_id)                               AS error_caption -- and an error map caption
		    FROM lc_renders r                                                                      -- of each render,
		    JOIN ranked k ON k.method_id = r.method_id                                             -- by its candidate's rank,
		    WHERE k.rank <= 12                                                                     -- of the 12 best candidates
		)
		SELECT
		    s.sample_id,
		    s.subset,
		    s.rating,
		    s.tags,
		    struct('image' AS widget, first_value(s.comp_png)    AS src, 'true composite' AS caption) AS true_composite,
		    struct('image' AS widget, first_value(s.oracle_png)  AS src, 'oracle'         AS caption) AS oracle,
		    struct('image' AS widget, first_value(s.alpha_png)   AS src, 'alpha'          AS caption) AS alpha,
		    struct('image' AS widget, first_value(s.fg_rgba_png) AS src, 'fg (RGBA)'      AS caption) AS fg,
		    struct('image' AS widget, first_value(s.bg_png)      AS src, 'bg'             AS caption) AS bg,
		    shot(t.decoded_png, t.rank, t.caption,        1) AS rank_01,
		    shot(t.error_png,   t.rank, t.error_caption,  1) AS error_01,
		    shot(t.decoded_png, t.rank, t.caption,        2) AS rank_02,
		    shot(t.error_png,   t.rank, t.error_caption,  2) AS error_02,
		    shot(t.decoded_png, t.rank, t.caption,        3) AS rank_03,
		    shot(t.error_png,   t.rank, t.error_caption,  3) AS error_03,
		    shot(t.decoded_png, t.rank, t.caption,        4) AS rank_04,
		    shot(t.error_png,   t.rank, t.error_caption,  4) AS error_04,
		    shot(t.decoded_png, t.rank, t.caption,        5) AS rank_05,
		    shot(t.error_png,   t.rank, t.error_caption,  5) AS error_05,
		    shot(t.decoded_png, t.rank, t.caption,        6) AS rank_06,
		    shot(t.error_png,   t.rank, t.error_caption,  6) AS error_06,
		    shot(t.decoded_png, t.rank, t.caption,        7) AS rank_07,
		    shot(t.error_png,   t.rank, t.error_caption,  7) AS error_07,
		    shot(t.decoded_png, t.rank, t.caption,        8) AS rank_08,
		    shot(t.error_png,   t.rank, t.error_caption,  8) AS error_08,
		    shot(t.decoded_png, t.rank, t.caption,        9) AS rank_09,
		    shot(t.error_png,   t.rank, t.error_caption,  9) AS error_09,
		    shot(t.decoded_png, t.rank, t.caption,       10) AS rank_10,
		    shot(t.error_png,   t.rank, t.error_caption, 10) AS error_10,
		    shot(t.decoded_png, t.rank, t.caption,       11) AS rank_11,
		    shot(t.error_png,   t.rank, t.error_caption, 11) AS error_11,
		    shot(t.decoded_png, t.rank, t.caption,       12) AS rank_12,
		    shot(t.error_png,   t.rank, t.error_caption, 12) AS error_12
		FROM shots t                                                 -- Each render of a top candidate,
		JOIN lc_samples s ON s.sample_id = t.sample_id               -- with its test sample,
		GROUP BY s.sample_id, s.subset, s.rating, s.tags, s.position -- one row per test sample,
		ORDER BY s.position                                          -- in test order: the hardest of each subset first

	view_lc_renders sql
		-- One row per render: every scored candidate's decode of every decoded test sample, sample by sample, best fitness first
		SELECT
		    struct('image' AS widget, s.comp_png    AS src, s.sample_id                             AS caption) AS true_composite,
		    struct('image' AS widget, r.decoded_png AS src, concat(r.method_id, ' ', round(r.psnr, 2), ' dB') AS caption) AS decoded,
		    struct('image' AS widget, r.error_png   AS src, 'error x4'                              AS caption) AS error,
		    struct('image' AS widget, s.oracle_png  AS src, 'oracle'                                AS caption) AS oracle,
		    struct('image' AS widget, s.alpha_png   AS src, 'alpha'                                 AS caption) AS alpha,
		    struct('image' AS widget, s.fg_rgba_png AS src, 'fg (RGBA)'                             AS caption) AS fg,
		    struct('image' AS widget, s.bg_png      AS src, 'bg'                                    AS caption) AS bg,
		    r.sample_id,
		    r.method_id,
		    r.psnr,
		    m.psnr AS method_psnr,
		    r.ssim,
		    r.lpips,
		    r.flux2_mse,
		    r.latent_mse,
		    s.subset,
		    s.rating,
		    s.tags
		FROM lc_renders r                              -- Each render,
		JOIN lc_methods m ON m.method_id = r.method_id -- with its candidate
		JOIN lc_samples s ON s.sample_id = r.sample_id -- and its test sample,
		ORDER BY s.position, m.psnr DESC               -- sample by sample, best fitness first

	view_lc_samples sql
		SELECT
		    struct('image' AS widget, comp_png    AS src, sample_id      AS caption) AS true_composite,
		    struct('image' AS widget, oracle_png  AS src, 'oracle'       AS caption) AS oracle,
		    struct('image' AS widget, alpha_png   AS src, 'alpha'        AS caption) AS alpha,
		    struct('image' AS widget, fg_rgba_png AS src, 'fg (RGBA)'    AS caption) AS fg,
		    struct('image' AS widget, bg_png      AS src, 'bg'           AS caption) AS bg,
		    sample_id,
		    subset,
		    rating,
		    tags,
		    page_id,
		    pexels_id,
		    alpha_mean,
		    placement,
		    background
		FROM lc_samples      -- Latent Compositor samples,
		WHERE split = 'test' -- of the test set,
		ORDER BY position    -- in test order: the hardest of each subset first

	 DIFFDEC (manifest §26)

	view_dd_methods sql
		-- The leaderboard: one row per candidate, best DISTS first (lower is better). A candidate that still trains has only its genome
		SELECT
		    m.method_id,
		    m.round,
		    m.name,
		    m.kind,
		    m.status,
		    m.space,
		    m.text_cond,
		    m.steps,
		    m.psnr,
		    m.psnr_mean8,
		    m.ssim,
		    m.lpips_vgg,
		    m.dists,
		    m.flux_mse,
		    m.sharp_fft,
		    m.ms_per_image,
		    m.params,
		    m.paper,
		    m.why_win,
		    m.verdict
		FROM dd_methods m                 -- Each candidate,
		ORDER BY m.dists ASC NULLS LAST,  -- best DISTS first, the ones that train last,
		         m.method_id              -- then by name

	view_dd_compare sql
		-- One row per test sample: the source, H3's own decoder (g0/h3_decoder), then the render of the 12 best candidates by DISTS
		-- (without H3's decoder), best first, each captioned with its PSNR and DISTS. view_dd_renders shows every candidate
		WITH FUNCTION shot(src, rank, caption, k) AS (struct(
		    'image'                                      AS widget,
		    first_value(src)     FILTER (WHERE rank = k) AS src,
		    first_value(caption) FILTER (WHERE rank = k) AS caption
		))
		WITH ranked AS (
		    SELECT method_id, row_number() OVER (ORDER BY dists, method_id) AS rank -- The DISTS rank
		    FROM dd_methods                                                         -- of each candidate
		    WHERE renders IS NOT NULL                                               -- that dd_import_renders did,
		      AND method_id <> 'g0/h3_decoder'                                      -- except the baseline
		), shots AS (
		    SELECT r.sample_id, r.render_png, k.rank,                                                         -- The image and the rank,
		           concat(k.rank, '. ', r.method_id, ' ', round(r.psnr, 2), ' dB, DISTS ', round(r.dists, 3)) AS caption -- a caption
		    FROM dd_renders r                                                                                 -- of each render,
		    JOIN ranked k ON k.method_id = r.method_id                                                        -- by its candidate's rank,
		    WHERE k.rank <= 12                                                                                -- of the 12 best candidates
		)
		SELECT
		    s.sample_id,
		    s.origin,
		    struct('image' AS widget, first_value(s.source_png) AS src, 'source' AS caption) AS source,
		    struct('image' AS widget, first_value(h.render_png) AS src,
		           concat('h3_decoder ', round(first_value(h.psnr), 2), ' dB, DISTS ', round(first_value(h.dists), 3)) AS caption) AS h3_decoder,
		    shot(t.render_png, t.rank, t.caption,  1) AS rank_01,
		    shot(t.render_png, t.rank, t.caption,  2) AS rank_02,
		    shot(t.render_png, t.rank, t.caption,  3) AS rank_03,
		    shot(t.render_png, t.rank, t.caption,  4) AS rank_04,
		    shot(t.render_png, t.rank, t.caption,  5) AS rank_05,
		    shot(t.render_png, t.rank, t.caption,  6) AS rank_06,
		    shot(t.render_png, t.rank, t.caption,  7) AS rank_07,
		    shot(t.render_png, t.rank, t.caption,  8) AS rank_08,
		    shot(t.render_png, t.rank, t.caption,  9) AS rank_09,
		    shot(t.render_png, t.rank, t.caption, 10) AS rank_10,
		    shot(t.render_png, t.rank, t.caption, 11) AS rank_11,
		    shot(t.render_png, t.rank, t.caption, 12) AS rank_12
		FROM dd_samples s                                                       -- Each test sample,
		LEFT JOIN dd_renders h ON h.sample_id = s.sample_id                     -- with H3's own decode of it, if it has one,
		                      AND h.method_id = 'g0/h3_decoder'
		LEFT JOIN shots t ON t.sample_id = s.sample_id                          -- and the renders of the top candidates,
		GROUP BY s.sample_id, s.origin                                          -- one row per test sample,
		ORDER BY s.origin, s.sample_id                                          -- grouped by origin

	view_dd_renders sql
		-- One row per render: every scored candidate's render of every test sample, sample by sample, best DISTS first
		SELECT
		    struct('image' AS widget, s.source_png AS src, s.sample_id                                            AS caption) AS source,
		    struct('image' AS widget, r.render_png AS src, concat(r.method_id, ' ', round(r.psnr, 2), ' dB')      AS caption) AS render,
		    struct('image' AS widget, r.mean8_png  AS src, concat('mean of 8 seeds ', round(r.psnr_mean8, 2), ' dB') AS caption) AS mean8,
		    struct('image' AS widget, r.error_png  AS src, 'error x4'                                             AS caption) AS error,
		    r.sample_id,
		    r.method_id,
		    r.psnr,
		    r.ssim,
		    r.lpips_alex,
		    r.lpips_vgg,
		    r.dists,
		    r.de2000,
		    r.flux_mse,
		    r.sharp_grad,
		    r.sharp_fft,
		    r.psnr_mean8,
		    r.dists_mean8,
		    m.dists AS method_dists,
		    s.origin
		FROM dd_renders r                              -- Each render,
		JOIN dd_methods m ON m.method_id = r.method_id -- with its candidate
		JOIN dd_samples s ON s.sample_id = r.sample_id -- and its test sample,
		ORDER BY s.origin, s.sample_id, m.dists        -- sample by sample, best DISTS first

	view_dd_samples sql
		SELECT
		    struct('image' AS widget, source_png AS src, sample_id AS caption) AS source,
		    sample_id,
		    origin,
		    side,
		    pexels_id,
		    page_id,
		    source_table,
		    has_upper_bound
		FROM dd_samples       -- DiffDec test samples,
		ORDER BY origin, sample_id

sparrow
	saves sparrow_saves

albatross
	saves albatross_saves
