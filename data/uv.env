# Source from data/ in Bash or Fish. Puts uv's cache and environments on /localize when the node has it, else in ~/.cache
test -w /localize && export BLUEJAY_UV_ROOT=/localize/uv || export BLUEJAY_UV_ROOT="$HOME/.cache/bluejay/uv"
export UV_CACHE_DIR="$BLUEJAY_UV_ROOT/cache"
export UV_PROJECT_ENVIRONMENT="$BLUEJAY_UV_ROOT/environments$PWD"
